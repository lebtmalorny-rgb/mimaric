  (
  set +x
  powerops_diag_token=$(timeout 20s openstack token issue -f value -c id) || exit 1
  [ -n "$powerops_diag_token" ] || exit 1

  for resource in 'workbooks?limit=1' 'actions/std.noop' 'actions/powerops.host_power_status'
  do
    printf '%s\n' "$resource"
    printf 'X-Auth-Token: %s\n' "$powerops_diag_token" |
      curl -q -sS -m 20 -H @- -o /dev/null \
        -w 'HTTP=%{http_code} total=%{time_total}s\n' \
        "http://10.101.25.42:8989/v2/$resource"
  done
  )

