+class LiveMigrationTest(base.BaseTest):
+    def setUp(self):
+        super().setUp()
+        self.override_config('poll_interval', 1, 'powerops')
+        self.override_config('instance_interval', 0, 'powerops')
+        self.override_config('stable_observations', 2, 'powerops')
+        self.override_config('vm_action_timeout', 30, 'powerops')
+        self.data = fakes.cloud(instances=[
