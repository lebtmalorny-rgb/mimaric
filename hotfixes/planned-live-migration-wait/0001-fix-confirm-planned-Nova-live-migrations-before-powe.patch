+def nova_live_migrations(data, failed_vm=None):
+    """Opt-in Nova API sequence; never teleport directly to final success."""
+    compute = data.connection.compute
+    servers = list(compute.servers.return_value)
+    by_id = {item.id: item for item in servers}
+    sources = {item.id: item.compute_host for item in servers}
+    phases = {}
+    compute.default_microversion = None
+    compute.get_endpoint_data.return_value = SimpleNamespace(
+        min_microversion='2.1', max_microversion='2.95')
+
+    def submit(path, **kwargs):
+        server_id = path.split('/')[-2]
+        data.events.append(('migrate', server_id))
+        phases[server_id] = 0
+        return mock.Mock(status_code=202)
+
+    def record(server_id):
+        status = ('error' if server_id == failed_vm else
+                  'running' if phases[server_id] < 3 else 'completed')
+        return SimpleNamespace(
+            uuid=str(uuid.uuid5(uuid.NAMESPACE_URL, server_id)),
+            server_id=server_id, source_compute=sources[server_id],
+            dest_compute='compute-02', migration_type='live-migration',
+            status=status)
+
+    def history(**query):
+        if 'host' in query:
+            return [record(server_id) for server_id in phases]
+        server_id = query['server_id']
+        rows = [record(server_id)] if server_id in phases else []
+        data.events.append(('history', server_id,
+                            rows[0].status if rows else None))
+        return rows
+
+    def read(path, **kwargs):
+        server_id = path.rsplit('/', 1)[-1]
+        item = by_id[server_id]
+        task = None
+        if server_id in phases:
+            phases[server_id] += 1
+            step = phases[server_id]
+            item.status = 'MIGRATING' if step < 3 else 'ACTIVE'
+            task = 'migrating' if step < 3 else None
+            if step >= 2:
+                item.compute_host = 'compute-02'
+        data.events.append(('observe', server_id, item.status, task))
+        response = mock.Mock(status_code=200)
+        response.json.return_value = {'server': {
+            'id': item.id, 'status': item.status,
+            'OS-EXT-SRV-ATTR:host': item.compute_host,
+            'OS-EXT-STS:task_state': task}}
+        return response
+
+    compute.post.side_effect = submit
+    compute.migrations.side_effect = history
+    compute.get.side_effect = read
+    compute.servers.side_effect = lambda **query: [
+        item for item in servers
+        if item.compute_host == query.get('compute_host', item.compute_host)]
+
+
