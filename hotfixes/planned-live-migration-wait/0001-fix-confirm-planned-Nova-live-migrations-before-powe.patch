+def migration(status='completed', **overrides):
+    body = dict(id=7, uuid=MIGRATION, server_id=VM,
+                source_compute='compute-01', dest_compute='compute-02',
+                migration_type='live-migration', status=status,
+                created_at='2026-09-07T11:43:11.000000',
+                updated_at='2026-09-07T11:45:01.000000')
+    body.update(overrides)
+    return Migration.existing(**body)
