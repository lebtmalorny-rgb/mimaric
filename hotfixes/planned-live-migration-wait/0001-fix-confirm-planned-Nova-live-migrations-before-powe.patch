+            if history:
+                last_records = history.pop(0)
+            return list(last_records)
+
+        self.compute.get.side_effect = get
+        self.compute.get_server.side_effect = (
+            lambda *args, **kwargs: Server.existing(**get_server()))
+        self.compute.migrations.side_effect = migrations
