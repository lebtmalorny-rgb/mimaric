diff --git a/mistral/actions/powerops/live_migration.py b/mistral/actions/powerops/live_migration.py
new file mode 100644
index 0000000..c14e7d5
--- /dev/null
+++ b/mistral/actions/powerops/live_migration.py
@@ -0,0 +1,241 @@
+# Copyright 2026 OpenStack Foundation
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+# http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Bounded Nova-only observation of one planned live migration.
+
+Nova does not return a migration UUID from os-migrateLive. Correlate a single
+new history record, rejecting ambiguity; this is not exclusive ownership of
+Nova operations initiated outside PowerOps, nor proof of local domain cleanup.
+"""
+
+from collections.abc import Mapping
+import uuid
+
+from keystoneauth1 import exceptions as ks_exceptions
+from openstack import exceptions as sdk_exceptions
+from openstack import utils as sdk_utils
+from oslo_config import cfg
+
+from mistral.actions.powerops import coordination
+from mistral.actions.powerops import exceptions
+
+
+CONF = cfg.CONF
+_MIN_VERSION = '2.59'  # Global migration history includes stable UUIDs.
+_PROGRESS = frozenset(('accepted', 'queued', 'preparing', 'running',
+                       'post-migrating',
+                       'running (post-copy)'))
+_TERMINAL = frozenset(('completed', 'confirmed', 'reverted', 'error',
+                       'failed', 'cancelled', 'canceled'))
+
+
+def require_uncached(cloud):
+    # Repeated cached snapshots are not independent observations. SDK list()
+    # pagination cannot forward skip_cache through the compute query mapping.
+    if getattr(cloud.connection, 'cache_enabled', False) is not False:
+        raise exceptions.PowerOpsConfigurationError(
+            'planned live migration requires SDK response caching disabled')
+
+
+def assert_no_inflight(cloud, host, deadline):
+    """Block unfinished migrations even if Nova lists no source VMs."""
+    cloud.health_check()
+    require_uncached(cloud)
+    supported = cloud._call_with_deadline(
+        lambda: sdk_utils.supports_microversion(
+            cloud.connection.compute, _MIN_VERSION), deadline,
+        'timed out discovering Nova microversions for ' + host)
+    if not supported:
+        raise exceptions.PowerOpsConfigurationError(
+            'planned live migration requires Nova microversion 2.59')
+    records = cloud._call_with_deadline(
+        lambda: list(cloud.connection.compute.migrations(host=host)),
+        deadline, 'timed out reading migrations for source ' + host)
+    for record in records:
+        if (host not in (record.source_compute, record.dest_compute)
+                or record.status not in _TERMINAL):
+            raise exceptions.InstancePolicyError(
+                'unresolved or mismatched migration before power off '
+                '(source={!r}, vm={!r}, migration={!r}, status={!r})'.format(
+                    host, record.server_id, record.uuid, record.status))
+    cloud.health_check()
+
+
+class LiveMigrationWaiter:
+    def __init__(self, cloud, server_id, source):
+        cloud._validate_resource_id(server_id, 'Nova instance UUID')
+        cloud._validate_host(source)
+        self.cloud = cloud
+        self.compute = cloud.connection.compute
+        self.server_id = server_id
+        self.source = source
+        self.baseline = set()
+        self.migration_id = None
+        self.destination = None
+        self.last = {}
+
+    def describe(self, reason):
+        # Include only identifiers/state, never response bodies or credentials.
+        fields = dict(vm=self.server_id, source=self.source,
+                      migration=self.migration_id,
+                      destination=self.destination, **self.last)
+        return '{} ({})'.format(reason, ', '.join(
+            '{}={!r}'.format(key, str(value)[:160])
+            for key, value in fields.items()))
+
+    def reject(self, reason):
+        raise exceptions.InstancePolicyError(self.describe(reason))
+
+    def call(self, function, deadline, description):
+        self.cloud.health_check()
+        require_uncached(self.cloud)
+        return self.cloud._call_with_deadline(
+            function, deadline, self.describe(description))
+
+    def history(self, deadline):
+        # /servers/{id}/migrations excludes completed live migrations. Use the
+        # global history and exhaust SDK pagination within the same deadline.
+        records = self.call(
+            lambda: list(self.compute.migrations(server_id=self.server_id)),
+            deadline, 'timed out reading Nova migration history')
+        by_id = {}
+        for record in records:
+            record_id = getattr(record, 'uuid', None)
+            try:
+                canonical = str(uuid.UUID(record_id)) == record_id
+            except (ValueError, TypeError, AttributeError):
+                canonical = False
+            if (not canonical or record_id in by_id
+                    or record.server_id != self.server_id):
+                self.reject('invalid or duplicate Nova migration identity')
+            by_id[record_id] = record
+        return by_id
+
+    def server(self, deadline):
+        # SDK Server.task_state defaults to None even when the API field is
+        # absent. Read the JSON via the public SDK adapter to require explicit
+        # null, not a missing/filtered field.
+        response = self.call(
+            lambda: self.compute.get(
+                '/servers/' + self.server_id,
+                microversion=_MIN_VERSION),
+            deadline, 'timed out reading Nova instance')
+        sdk_exceptions.raise_from_response(response)
+        if response.status_code != 200:
+            self.reject('Nova instance read did not return HTTP 200')
+        body = response.json()
+        server = body.get('server') if isinstance(body, Mapping) else None
+        required = ('id', 'status', 'OS-EXT-SRV-ATTR:host',
+                    'OS-EXT-STS:task_state')
+        if (not isinstance(server, Mapping)
+                or any(key not in server for key in required)
+                or server['id'] != self.server_id):
+            self.reject('incomplete or mismatched Nova instance response')
+        current = server['OS-EXT-SRV-ATTR:host']
+        status = server['status']
+        task = server['OS-EXT-STS:task_state']
+        self.last.update(current=current, server_status=status,
+                         task_state=task)
+        if (not isinstance(current, str)
+                or not coordination.HOST_RE.fullmatch(current)):
+            self.reject('Nova instance has no canonical compute host')
+        if (status not in ('ACTIVE', 'MIGRATING')
+                or task not in (None, 'migrating')):
+            self.reject('instance entered an unsafe migration state')
+        return current, status, task
+
+    def observe(self, deadline):
+        records = self.history(deadline)
+        new_ids = set(records) - self.baseline
+        if len(new_ids) > 1:
+            self.reject('multiple new migrations; cannot correlate request')
+        record = records[next(iter(new_ids))] if new_ids else None
+        if record is not None:
+            record_id = record.uuid
+            self.last.update(migration_status=record.status,
+                             reported_destination=record.dest_compute)
+            if self.migration_id not in (None, record_id):
+                self.reject('Nova migration identity changed while waiting')
+            self.migration_id = record_id
+            if (record.migration_type != 'live-migration'
+                    or record.source_compute != self.source):
+                self.reject('new migration does not match planned source/type')
+            if record.status not in _PROGRESS | {'completed'}:
+                self.reject('migration failed or entered unsupported state')
+            dest = record.dest_compute
+            if record.status == 'completed':
+                if (not isinstance(dest, str)
+                        or not coordination.HOST_RE.fullmatch(dest)
+                        or dest == self.source):
+                    self.reject('completed migration has invalid destination')
+                if self.destination not in (None, dest):
+                    self.reject('completed migration destination changed')
+                self.destination = dest
+
+        current, status, task = self.server(deadline)
+        if record is None or record.status != 'completed':
+            return False
+        if current not in (self.source, self.destination):
+            self.reject('instance host differs from migration destination')
+        return (current == self.destination and status == 'ACTIVE'
+                and task is None)
+
+    def run(self):
+        deadline = self.cloud._deadline(CONF.powerops.vm_action_timeout)
+        try:
+            if not self.call(lambda: sdk_utils.supports_microversion(
+                    self.compute, _MIN_VERSION), deadline,
+                    'timed out discovering Nova microversions'):
+                raise exceptions.PowerOpsConfigurationError(self.describe(
+                    'planned live migration requires Nova microversion 2.59'))
+            records = self.history(deadline)
+            if any(record.status not in _TERMINAL
+                   for record in records.values()):
+                self.reject('preexisting unresolved Nova migration')
+            self.baseline = set(records)
+            current, status, task = self.server(deadline)
+            if (current != self.source or status != 'ACTIVE'
+                    or task is not None):
+                self.reject('instance is not idle ACTIVE on planned source')
+
+            # One submission only. A lost response is not permission to retry.
+            self.cloud._mutation(
+                self.submit,
+                deadline, self.describe('timed out submitting live migration'))
+            self.cloud._wait_until(
+                lambda: self.observe(deadline), bool,
+                CONF.powerops.vm_action_timeout,
+                'timed out waiting for confirmed Nova live migration',
+                deadline=deadline)
+        except exceptions.PowerOpsTimeout as exc:
+            raise type(exc)(self.describe(str(exc))) from exc
+        except ks_exceptions.ConnectTimeout as exc:
+            raise exceptions.PowerOpsCallTimeout(self.describe(
+                'Nova request timed out; migration submission not retried'
+            )) from exc
+
+    def submit(self):
+        # SDK live_migrate_server() inherits Proxy.request connect_retries=1,
+        # which also retries a lost read response. Use the public SDK adapter
+        # with per-request retry/redirect/reauth disabled, not global settings.
+        response = self.compute.post(
+            '/servers/' + self.server_id + '/action',
+            json={'os-migrateLive': {'host': None, 'block_migration': 'auto'}},
+            microversion=_MIN_VERSION, connect_retries=0,
+            status_code_retries=0, redirect=False, allow_reauth=False,
+            raise_exc=False)
+        sdk_exceptions.raise_from_response(response)
+        if response.status_code != 202:
+            self.reject('Nova did not acknowledge migration with HTTP 202')
+
+    def revalidate(self, deadline):
+        if not self.observe(deadline):
+            self.reject('migration is no longer confirmed before power off')
