+        self.compute.servers.assert_called_once_with(
+            details=True, all_projects=True, compute_host='compute-01')
+
+    def test_empty_policy_checks_inflight_migrations_before_power_off(self):
+        self.compute.servers.return_value = []
+        self.assertEqual([], self.run_policy())
+        self.compute.migrations.return_value = [migration('post-migrating')]
+        self.assertRaises(exceptions.InstancePolicyError, self.guard)
+
+    def test_loss_of_lock_stops_wait_without_resubmission(self):
+        self.observations([
+            server_body('MIGRATING', task_state='migrating')],
+            [[migration('running')]])
+
+        def health():
+            if self.clock >= 1:
+                raise RuntimeError('lock ownership lost')
+
+        self.cloud.health_check = health
+        self.assertRaises(RuntimeError, self.run_policy)
+        self.compute.post.assert_called_once()
+
+    def test_interrupted_stability_requires_two_fresh_observations(self):
+        self.observations([
+            server_body('ACTIVE', 'compute-02'),
+            server_body('ACTIVE', 'compute-02', 'migrating'),
+            server_body('ACTIVE', 'compute-02'),
+            server_body('ACTIVE', 'compute-02')], [[migration()]])
+        self.assertEqual([], self.run_policy())
+        self.assertEqual(3, len(self.sleeps))
+
+    def test_history_identity_and_types_fail_closed(self):
+        variants = [migration(uuid=None), migration(uuid='7'),
+                    migration(server_id='other-vm'),
+                    migration(source_compute='other-source'),
+                    migration(migration_type='resize'),
+                    migration(status='unexpected-state')]
+        for record in variants:
+            with self.subTest(record=record):
+                self.observations([server_body('ACTIVE', 'compute-02')],
+                                  [[record]])
+                self.assertRaises(exceptions.InstancePolicyError,
+                                  self.run_policy)
+
+    def test_compute_host_not_display_name_confirms_destination(self):
+        body = server_body('ACTIVE', 'compute-02')
+        body['OS-EXT-SRV-ATTR:hypervisor_hostname'] = 'compute-01'
+        self.observations([body], [[migration()]])
+        self.assertEqual([], self.run_policy())
+
+    def test_waits_for_accepted_before_destination_is_scheduled(self):
+        statuses = ('accepted', 'queued', 'preparing', 'running',
+                    'running (post-copy)', 'post-migrating')
+        states = [server_body('MIGRATING', task_state='migrating')
+                  for _ in statuses] + [server_body('ACTIVE', 'compute-02')]
+        records = [[migration(state, dest_compute=None)] for state in statuses]
+        self.observations(states, records + [[migration()]])
+        self.assertEqual([], self.run_policy())
+        self.assertGreaterEqual(len(self.sleeps), len(statuses) + 1)
+
+    def test_sdk_cache_enabled_blocks_live_policy_before_read_or_post(self):
+        self.data.connection.cache_enabled = True
+        self.observations([server_body('ACTIVE', 'compute-02')],
+                          [[migration()]])
+        self.assertRaises(exceptions.PowerOpsConfigurationError,
+                          self.run_policy)
+        self.compute.servers.assert_not_called()
+        self.compute.post.assert_not_called()
+
+    def test_sdk_cache_enabled_blocks_final_guard(self):
+        self.completed_policy()
