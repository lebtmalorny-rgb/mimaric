+            [migration('completed')], [migration()], [migration()]])
+
+        self.assertEqual([], self.run_policy())
+        self.assertGreaterEqual(len(self.sleeps), 4)
+        self.compute.post.assert_called_once()
+        self.assertGreaterEqual(self.compute.migrations.call_count, 6)
+
+    def test_active_destination_does_not_replace_migration_confirmation(self):
+        self.observations([server_body('ACTIVE', 'compute-02')],
