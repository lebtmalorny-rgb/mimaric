+        self.override_config('instance_interval', 1, 'powerops')
+        self.override_config('vm_action_timeout', 20, 'powerops')
+
+    def exercise(self, action_class, failure=None):
+        node = fakes.node('node-1', 'compute-01')
+        service = fakes.service('service-1', 'compute-01')
+        host = fakes.masakari_host('host-1', 'compute-01', False)
+        vms = [fakes.server(vm, 'compute-01', 'ACTIVE')
+               for vm in ('vm-a', 'vm-b')]
+        data = fakes.cloud(ironic_nodes=[node], nova_services=[service],
+                           masakari_hosts=[host], instances=vms)
+        fakes.nova_live_migrations(
+            data, failed_vm='vm-b' if failure == 'error' else None)
+        compute = data.connection.compute
+        read_history = compute.migrations.side_effect
+        submit = compute.post.side_effect
+        list_servers = compute.servers.side_effect
+        clock = 0
+
+        def sleep(seconds):
+            nonlocal clock
+            clock += seconds
+
+        def health():
+            if (failure == 'lost-lock'
+                    and ('migrate', 'vm-b') in data.events):
+                raise RuntimeError('lock ownership lost')
+
+        def history(**query):
+            records = read_history(**query)
+            if failure == 'timeout' and query.get('server_id') == 'vm-b':
+                for record in records:
+                    record.status = 'running'
+            return records
+
+        def post(path, **kwargs):
+            result = submit(path, **kwargs)
+            if failure == 'post-timeout' and '/vm-b/' in path:
+                raise ks_exceptions.ConnectTimeout('response lost')
+            return result
+
+        def servers(**query):
+            if failure == 'source-not-empty' and all(
+                    vm.compute_host != 'compute-01' for vm in vms):
+                return [fakes.server('new-vm', 'compute-01', 'ACTIVE')]
+            return list_servers(**query)
+
+        compute.migrations.side_effect = history
+        compute.post.side_effect = post
+        compute.servers.side_effect = servers
+        coordinator = fakes.recording_coordinator(data.events)
+        coordinator.assert_healthy = health
+        cloud = clients.CloudClients(
+            data.connection, ha_adapter=data.ha_adapter, sleep=sleep,
+            monotonic=lambda: clock, health_check=health)
+        with mock.patch.object(
+                action_base.coordination, 'OperationCoordinator',
+                return_value=coordinator), mock.patch.object(
+                clients, 'connection_from_conf', return_value=data.connection
+        ), mock.patch.object(clients, 'CloudClients', return_value=cloud):
+            action = action_class('compute-01', 'segment-1',
+                                  instance_policy='live_migrate')
+            if failure:
+                self.assertRaises(
+                    (exceptions.InstancePolicyError,
+                     exceptions.PowerOpsTimeout, RuntimeError), action.run,
+                    fakes.action_context('live-migration-safety'))
+            else:
+                action.run(fakes.action_context('live-migration-safety'))
+
+        self.assertEqual(2, compute.post.call_count)
+        self.assertEqual('compute-02', vms[0].compute_host)
+        self.assertEqual('ACTIVE', vms[0].status)
+        if failure:
+            data.connection.baremetal.set_node_power_state.assert_not_called()
+            compute.enable_service.assert_not_called()
+            compute.start_server.assert_not_called()
+            self.assertEqual('power on', node.power_state)
+            self.assertEqual('disabled', service.status)
+            self.assertTrue(host.on_maintenance)
+        else:
+            power_events = [
+                event for event in data.events
+                if isinstance(event, tuple) and event[0] == 'power']
+            expected = 2 if action_class is planned.PlannedRebootAction else 1
+            self.assertEqual(expected, len(power_events))
+            last_migration = max(i for i, event in enumerate(data.events)
+                                 if isinstance(event, tuple)
+                                 and event[0] == 'history')
+            self.assertLess(last_migration, data.events.index(power_events[0]))
+        self.assertIn('host-lock-exit', data.events)
+
+    def test_partial_failure_never_powers_off_or_reenables_source(self):
+        for action in (planned.PlannedPowerOffAction,
+                       planned.PlannedRebootAction):
+            for failure in ('error', 'timeout', 'post-timeout', 'lost-lock',
+                            'source-not-empty'):
+                with self.subTest(action=action.__name__, failure=failure):
+                    self.exercise(action, failure)
+
+    def test_power_off_and_reboot_follow_confirmed_migrations(self):
+        for action in (planned.PlannedPowerOffAction,
+                       planned.PlannedRebootAction):
+            with self.subTest(action=action.__name__):
+                self.exercise(action)
