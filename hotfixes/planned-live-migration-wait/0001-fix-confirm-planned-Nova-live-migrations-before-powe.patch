+            sleep=self.sleep, monotonic=lambda: self.clock,
+        )
+
+    def sleep(self, seconds):
+        self.clock += seconds
+        self.sleeps.append(seconds)
+
+    def observations(self, states, records, baseline=()):
+        """Keep both the SDK server and raw API boundary available."""
+        current = server_body()
+        history = [list(baseline)] + records
+        snapshots = [server_body()] + states
+
+        def get_server(*args, **kwargs):
+            nonlocal current
+            if snapshots:
+                current = snapshots.pop(0)
+            return current
+
+        def get(*args, **kwargs):
+            response = mock.Mock(status_code=200)
+            response.json.return_value = {'server': get_server()}
+            return response
+
+        last_records = list(baseline)
+
+        def migrations(**kwargs):
+            nonlocal last_records
