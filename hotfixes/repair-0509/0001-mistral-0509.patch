diff --git a/mistral/cmd/powerops_check.py b/mistral/cmd/powerops_check.py
new file mode 100644
index 0000000..c3ce6a3
--- /dev/null
+++ b/mistral/cmd/powerops_check.py
@@ -0,0 +1,145 @@
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+# http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Offline image contract check: python -m mistral.cmd.powerops_check.
+
+No config file, token, database, message bus or cloud connection is used.
+Run in a disposable process/container (preferably with --network=none).
+This is not a replacement for the scenario suite or live acceptance.
+"""
+
+import importlib.metadata as metadata
+import json
+import sys
+from unittest import mock
+
+
+REQUIRED = (
+    'powerops.host_power_status', 'powerops.planned_power_off',
+    'powerops.planned_reboot', 'powerops.power_on_for_inspection',
+    'powerops.return_to_service',
+)
+
+
+def check():
+    from mistral_lib.actions import context as lib_context
+    from oslo_config import cfg
+
+    from mistral.actions.powerops import base
+    from mistral.actions.powerops import exceptions
+    from mistral import config  # noqa: F401  Register options, do not parse.
+    from mistral import context
+    from mistral.executors import default_executor
+
+    entries = metadata.entry_points(group='mistral.actions')
+    loaded = {}
+    for name in REQUIRED:
+        matches = [entry for entry in entries if entry.name == name]
+        if len(matches) != 1:
+            raise RuntimeError('Missing or duplicate action entry point')
+        cls = matches[0].load()
+        if not issubclass(cls, base.PowerOpsAction):
+            raise RuntimeError('Unexpected PowerOps action class')
+        loaded[name] = cls
+
+    class AuthorizationProbe(base.PowerOpsAction):
+        def run(self, action_context):
+            self._authorize(action_context)
+            return 'authorized'
+
+    previous = context.ctx() if context.has_ctx() else None
+    with mock.patch.object(base, 'CONF', cfg.CONF):
+        # Patch only the local authorization configuration, not the caller
+        # or executor logic; never load deployment secrets for this check.
+        from mistral.services import powerops
+        conf = mock.Mock()
+        conf.powerops.allowed_project_names = ['check-project']
+        conf.powerops.allowed_user_names = ['check-user']
+        try:
+            with mock.patch.object(powerops, 'cfg') as config_module:
+                config_module.CONF = conf
+                for roles, hard_off, allowed in (
+                        (['admin'], False, True),
+                        (['admin'], True, True),
+                        (['powerops_operator'], False, True),
+                        (['powerops_operator'], True, False),
+                        (['member'], False, False),
+                        ([], False, False),
+                        ('admin', False, False),
+                        ([1], False, False)):
+                    request = context.MistralContext(
+                        roles=roles, project_name='check-project',
+                        user_name='check-user',
+                    )
+                    codec = context.RpcContextSerializer()
+                    context.set_ctx(codec.deserialize_context(
+                        codec.serialize_context(request)))
+                    action_context = context.create_action_context({})
+                    serializer = lib_context.ActionContextSerializer()
+                    serializer.deserialize_from_dict(
+                        serializer.serialize_to_dict(action_context))
+                    for name, cls in loaded.items():
+                        args = {'host': 'check-host',
+                                'segment_uuid': 'check-segment'}
+                        if name == 'powerops.return_to_service':
+                            args['stopped_instance_ids'] = []
+                        action = cls(**args)
+                        action.allow_hard_off = hard_off
+                        try:
+                            action._authorize(action_context)
+                        except exceptions.PowerOpsUnauthorized:
+                            if allowed:
+                                raise
+                        else:
+                            if not allowed:
+                                raise RuntimeError('Authorization accepted '
+                                                   'an unprivileged caller')
+                    # Exercise the actual 0509 executor thread, not just
+                    # create_action_context(). No RPC client is constructed.
+                    if allowed:
+                        probe = AuthorizationProbe()
+                        probe.allow_hard_off = hard_off
+                        with mock.patch.object(default_executor.rpc,
+                                               'get_engine_client'):
+                            executor = default_executor.DefaultExecutor()
+                        result = executor._do_run_action(
+                            probe, None, {}, False, True, 5)
+                        if result.is_error() or result.data != 'authorized':
+                            raise RuntimeError('Executor context contract '
+                                               'failed')
+        finally:
+            context.set_ctx(previous)
+
+    return {
+        'result': 'ok',
+        'actions': sorted(loaded),
+        'versions': {name: metadata.version(name) for name in (
+            'mistral', 'mistral-lib', 'openstacksdk', 'keystoneauth1',
+            'oslo.context', 'oslo.messaging', 'tooz', 'etcd3gw')},
+        'python': sys.version.split()[0],
+    }
+
+
+def main():
+    try:
+        result = check()
+    except Exception as exc:
+        # Exception messages may contain deployment data; keep stdout safe
+        # for Ansible. Detailed imports can be investigated separately.
+        print(json.dumps({'result': 'failed',
+                          'error_type': type(exc).__name__}))
+        return 1
+    print(json.dumps(result, sort_keys=True))
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
