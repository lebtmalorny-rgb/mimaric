+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Exercise the 0509 executor with an unmodified mistral-lib context."""
+
+import importlib
+import unittest
+from unittest import mock
+
+from mistral_lib.actions import context as lib_context
+from oslo_config import cfg
+
+from mistral import config  # noqa: F401  Register PowerOps options.
+from mistral import context
+
+
+class RuntimeContextTest(unittest.TestCase):
+    def setUp(self):
+        self.previous = context.ctx() if context.has_ctx() else None
+        self.addCleanup(context.set_ctx, self.previous)
+        for name, value in (
+                ('enabled', True),
+                ('allowed_project_names', ['operations']),
+                ('allowed_user_names', ['operator'])):
+            cfg.CONF.set_override(name, value, group='powerops')
+            self.addCleanup(cfg.CONF.clear_override, name, group='powerops')
+
+    def _bind(self, roles, project='operations', user='operator'):
+        request = context.MistralContext(
+            roles=roles, project_name=project, user_name=user,
+            project_id='project-id', user_id='user-id',
+        )
+        # The executor receives an RPC-restored request context, not roles
+        # from the action input or an extended mistral-lib SecurityContext.
+        serializer = context.RpcContextSerializer(None)
+        context.set_ctx(serializer.deserialize_context(
+            serializer.serialize_context(request)))
+
+    def test_executor_authorizes_admin_and_operator_with_stock_library(self):
+        from mistral.actions.powerops import base
+        from mistral.executors import default_executor
+
+        class AuthorizationProbe(base.PowerOpsAction):
+            def run(self, action_context):
+                self._authorize(action_context)
+                return 'authorized'
+
+        for roles, project, user in (
+                (['admin'], 'admin', 'admin'),
+                (['powerops_operator'], 'operations', 'operator')):
+            with self.subTest(roles=roles):
+                self._bind(roles, project, user)
+                # Do not add attributes which stock deserialization rejects.
+                action_context = context.create_action_context({})
+                codec = lib_context.ActionContextSerializer()
+                codec.deserialize_from_dict(
+                    codec.serialize_to_dict(action_context))
+                with mock.patch.object(default_executor.rpc,
+                                       'get_engine_client'):
+                    executor = default_executor.DefaultExecutor()
+                result = executor._do_run_action(
+                    AuthorizationProbe(), None, {}, False, True, 5)
+                self.assertFalse(result.is_error(), result.error)
+                self.assertEqual('authorized', result.data)
+
+    def test_all_five_entry_point_classes_are_importable(self):
+        import configparser
+        from importlib.metadata import EntryPoint
+        from pathlib import Path
+
+        root = Path(__file__).resolve().parents[5]
+        parser = configparser.ConfigParser()
+        parser.read(root / 'setup.cfg')
+        entries = parser['entry_points']['mistral.actions'].splitlines()
+        loaded = []
+        for entry in entries:
+            if entry.strip().startswith('powerops.'):
+                name, value = entry.split('=', 1)
+                loaded.append(EntryPoint(name.strip(), value.strip(),
+                                         'mistral.actions').load())
+        self.assertEqual(5, len(loaded))
+
+    def test_no_ambient_context_never_trusts_action_supplied_roles(self):
+        base = importlib.import_module('mistral.actions.powerops.base')
+        errors = importlib.import_module('mistral.actions.powerops.exceptions')
+        self._bind(['admin'])
+        supplied = context.create_action_context({})
+        supplied.security.roles = ['admin']
+        context.set_ctx(None)
+        with self.assertRaises(errors.PowerOpsUnauthorized):
+            base.PowerOpsAction()._authorize(supplied)
+
+    def test_supplied_admin_roles_cannot_override_request_member(self):
+        base = importlib.import_module('mistral.actions.powerops.base')
+        errors = importlib.import_module('mistral.actions.powerops.exceptions')
+        self._bind(['member'])
+        supplied = context.create_action_context({})
+        supplied.security.roles = ['admin']
+        with self.assertRaises(errors.PowerOpsUnauthorized):
+            base.PowerOpsAction()._authorize(supplied)
+
+    def test_image_selfcheck_runs_without_cloud_or_config_file(self):
+        from mistral.actions.powerops import clients
+        from mistral.cmd import powerops_check
+        with mock.patch.object(clients, 'connection_from_conf',
+                               side_effect=AssertionError('cloud call')):
+            report = powerops_check.check()
+        self.assertEqual('ok', report['result'])
+        self.assertEqual(5, len(report['actions']))
+        self.assertIn('mistral-lib', report['versions'])
+
+    def test_target_headers_cannot_authorize_local_powerops(self):
+        from mistral.actions.powerops import base
+        from mistral.actions.powerops import exceptions
+        for roles in (['admin'], ['powerops_operator']):
+            self._bind(roles)
+            context.ctx().is_target = True
+            supplied = context.create_action_context({})
+            with self.assertRaises(exceptions.PowerOpsUnauthorized):
+                base.PowerOpsAction()._authorize(supplied)
