+"""PowerOps authorization using the authenticated Mistral request context.
+
+Never infer privileges from action inputs, service credentials, ``is_admin``
+alone, or missing roles. DefaultExecutor restores this request context in its
+action thread. The stock mistral-lib SecurityContext does not transport roles.
+"""
+
+from oslo_config import cfg
+
+from mistral.actions.powerops import exceptions
+
+
+def authorize(request, allow_hard_off=False,
+              error_cls=exceptions.PowerOpsUnauthorized):
+    if getattr(request, 'is_target', False):
+        raise error_cls('PowerOps does not accept target-cloud contexts')
+
+    roles = getattr(request, 'roles', None)
+    if not isinstance(roles, (list, tuple)) or not all(
+            isinstance(role, str) and role for role in roles):
+        raise error_cls('PowerOps requires authenticated role names')
+
+    if 'admin' in roles:
+        return
+
+    if allow_hard_off:
+        raise error_cls('PowerOps hard power-off requires the admin role')
+
+    if ('powerops_operator' not in roles
+            or getattr(request, 'project_name', None)
+            not in cfg.CONF.powerops.allowed_project_names
+            or getattr(request, 'user_name', None)
+            not in cfg.CONF.powerops.allowed_user_names):
+        raise error_cls('PowerOps requires admin or an allowlisted operator')
