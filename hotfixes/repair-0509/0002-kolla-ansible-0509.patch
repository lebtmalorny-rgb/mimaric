+import unittest
+
+from kolla_ansible.tests.unit.test_powerops_registration import (
+    MISTRAL_DEPLOY, MISTRAL_POWEROPS, _assertion_outcome, _load_yaml, _named,
+    _task_runs, _template,
+)
+
+
+class RepairPreflightTest(unittest.TestCase):
+    def test_each_replica_runs_offline_contract_check_before_population(self):
+        tasks = _load_yaml(MISTRAL_POWEROPS)
+        check = _named(tasks, 'Verify PowerOps Mistral action entry points')
+        self.assertTrue(check['run_once'])
