+---
+- name: Validate PowerOps evacuation guard dependencies
+  ansible.builtin.assert:
+    that:
+      - enable_nova | bool
+      - enable_masakari | bool
+      - enable_powerops | bool
+      - enable_etcd | bool
+      - powerops_evacuation_guard_endpoint is string
+      - >-
+        powerops_evacuation_guard_endpoint |
+        regex_search(
+          '^https?://(?:\[(?=[0-9A-Fa-f:]*:)[0-9A-Fa-f:]+\]|[^\s:/?#@\[\]]+):[0-9]+$'
+        ) is not none
+      - >-
+        powerops_evacuation_guard_endpoint |
+        regex_replace('^.*:', '') | int >= 1
+      - >-
+        powerops_evacuation_guard_endpoint |
+        regex_replace('^.*:', '') | int <= 65535
+      - powerops_evacuation_guard_prefix is string
+      - >-
+        powerops_evacuation_guard_prefix |
+        regex_search('^/[^\s/](?:[^\s]*[^/])?$') is not none
+      - powerops_evacuation_guard_prefix | regex_search('//') is none
+      - >-
+        powerops_evacuation_guard_prefix |
+        regex_search('(?:^|/)\.\.?(?:/|$)') is none
+      - (powerops_evacuation_guard_timeout | type_debug) in ['int', 'float']
+      - >-
+        powerops_evacuation_guard_timeout | string | lower
+        not in ['nan', 'inf', '-inf', 'infinity', '-infinity']
+      - powerops_evacuation_guard_timeout | float > 0
+      - (powerops_evacuation_guard_max_parallel | type_debug) == 'int'
+      - powerops_evacuation_guard_max_parallel >= 1
+      - powerops_evacuation_guard_max_parallel <= 1024
+      - (powerops_evacuation_guard_cooldown | type_debug) in ['int', 'float']
+      - >-
+        powerops_evacuation_guard_cooldown | string | lower
+        not in ['nan', 'inf', '-inf', 'infinity', '-infinity']
+      - powerops_evacuation_guard_cooldown | float >= 0
+      - >-
+        (powerops_evacuation_guard_admission_timeout | type_debug)
+        in ['int', 'float']
+      - >-
+        powerops_evacuation_guard_admission_timeout | string | lower
+        not in ['nan', 'inf', '-inf', 'infinity', '-infinity']
+      - powerops_evacuation_guard_admission_timeout | float > 0
+      - >-
+        (powerops_evacuation_guard_poll_interval | type_debug)
+        in ['int', 'float']
+      - >-
+        powerops_evacuation_guard_poll_interval | string | lower
+        not in ['nan', 'inf', '-inf', 'infinity', '-infinity']
+      - powerops_evacuation_guard_poll_interval | float > 0
+      - >-
+        (powerops_evacuation_guard_submission_workers | type_debug) == 'int'
+      - powerops_evacuation_guard_submission_workers >= 1
+      - powerops_evacuation_guard_submission_workers <= 1024
+      - powerops_evacuation_guard_ca_file is string
+      - powerops_evacuation_guard_cert_file is string
+      - powerops_evacuation_guard_key_file is string
+      - >-
+        (powerops_evacuation_guard_cert_file | length > 0) ==
+        (powerops_evacuation_guard_key_file | length > 0)
+      - >-
+        powerops_evacuation_guard_ca_file | length == 0 or
+        powerops_evacuation_guard_ca_file |
+        regex_search(
+          '^/(?:etc/pki|etc/ssl|var/lib/kolla/share/ca-certificates)/[^\s/]+(?:/[^\s/]+)*$'
+        ) is not none
+      - >-
+        powerops_evacuation_guard_ca_file |
+        regex_search('(?:^|/)\.\.?(?:/|$)') is none
+      - >-
+        powerops_evacuation_guard_cert_file | length == 0 or
+        powerops_evacuation_guard_cert_file |
+        regex_search(
+          '^/(?:etc/pki|etc/ssl|var/lib/kolla/share/ca-certificates)/[^\s/]+(?:/[^\s/]+)*$'
+        ) is not none
+      - >-
+        powerops_evacuation_guard_cert_file |
+        regex_search('(?:^|/)\.\.?(?:/|$)') is none
+      - >-
+        powerops_evacuation_guard_key_file | length == 0 or
+        powerops_evacuation_guard_key_file |
+        regex_search(
+          '^/(?:etc/pki|etc/ssl|var/lib/kolla/share/ca-certificates)/[^\s/]+(?:/[^\s/]+)*$'
+        ) is not none
+      - >-
+        powerops_evacuation_guard_key_file |
+        regex_search('(?:^|/)\.\.?(?:/|$)') is none
+    fail_msg: >-
+      The PowerOps evacuation guard requires Nova, Masakari, PowerOps and
+      Kolla managed etcd, valid bounded admission settings, and valid
+      preprovisioned container TLS paths.
+      Optional client certificate and key files must be configured together.
+  when: powerops_evacuation_guard_enabled | bool
