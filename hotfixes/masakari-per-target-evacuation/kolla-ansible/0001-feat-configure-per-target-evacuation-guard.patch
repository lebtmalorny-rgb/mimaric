+    def test_evacuation_guard_preserves_normal_nova_compute_image(self):
+        variables = _load_yaml(GROUP_VARS)
+        defaults = _load_yaml(
+            ROOT / "ansible/roles/nova-cell/defaults/main.yml")
+        expression = defaults["nova_cell_services"]["nova-compute"]["image"]
+        environment = _jinja_environment()
+        legacy_nova_compute_image = "upstream/nova-compute:2025.1"
+        disabled_rendered_image = environment.from_string(expression).render(
+            powerops_evacuation_guard_enabled="no",
+            nova_compute_image_full=legacy_nova_compute_image,
+        )
+        enabled_rendered_image = environment.from_string(expression).render(
+            powerops_evacuation_guard_enabled="yes",
+            nova_compute_image_full=legacy_nova_compute_image,
+        )
+
+        self.assertEqual(legacy_nova_compute_image, disabled_rendered_image)
+        self.assertEqual(legacy_nova_compute_image, enabled_rendered_image)
+        self.assertEqual(
+            "{{ nova_compute_image_full }}", expression)
+        self.assertEqual(
+            "{{ nova_compute_image }}:{{ nova_compute_tag }}",
+            defaults["nova_compute_image_full"],
+        )
+        self.assertNotIn("powerops_nova_compute_image", variables)
+        self.assertNotIn("powerops_nova_compute_tag", variables)
