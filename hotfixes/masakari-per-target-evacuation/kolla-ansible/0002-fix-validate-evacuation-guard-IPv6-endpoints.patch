Subject: [PATCH 2/3] fix: validate evacuation guard IPv6 endpoints

---
 .../powerops-evacuation-guard/tasks/main.yml  |  3 +++
 .../test_powerops_configuration_contract.py   | 21 +++++++++++++++++++
 2 files changed, 24 insertions(+)

diff --git a/ansible/roles/powerops-evacuation-guard/tasks/main.yml b/ansible/roles/powerops-evacuation-guard/tasks/main.yml
index 0d0a86b..37b3736 100644
--- a/ansible/roles/powerops-evacuation-guard/tasks/main.yml
+++ b/ansible/roles/powerops-evacuation-guard/tasks/main.yml
@@ -7,6 +7,9 @@
       - enable_powerops | bool
       - enable_etcd | bool
       - powerops_evacuation_guard_endpoint is string
+      - >-
+        powerops_evacuation_guard_endpoint is
+        ansible.builtin.url(schemes=['http', 'https'])
       - >-
         powerops_evacuation_guard_endpoint |
         regex_search(
diff --git a/kolla_ansible/tests/unit/test_powerops_configuration_contract.py b/kolla_ansible/tests/unit/test_powerops_configuration_contract.py
index eb9f711..7a1ef91 100644
--- a/kolla_ansible/tests/unit/test_powerops_configuration_contract.py
+++ b/kolla_ansible/tests/unit/test_powerops_configuration_contract.py
@@ -354,6 +354,12 @@ class PowerOpsConfigurationContractTest(unittest.TestCase):
             {"powerops_evacuation_guard_endpoint": "etcd:2379"},
             {"powerops_evacuation_guard_endpoint": "http://user@etcd:2379"},
             {"powerops_evacuation_guard_endpoint": "http://[bad]:2379"},
+            {"powerops_evacuation_guard_endpoint": "http://[:::]:2379"},
+            {
+                "powerops_evacuation_guard_endpoint": (
+                    "http://[2001:db8:::1]:2379"
+                ),
+            },
             {"powerops_evacuation_guard_endpoint": "http://etcd:2379/v3"},
             {"powerops_evacuation_guard_endpoint": "http://etcd:0"},
             {"powerops_evacuation_guard_endpoint": "http://etcd:65536"},
@@ -398,6 +404,21 @@ class PowerOpsConfigurationContractTest(unittest.TestCase):
         self.assertEqual(
             "powerops_evacuation_guard_enabled | bool", task.get("when"))
         self.assertEqual("passed", _assertion_outcome(task, valid))
+        for endpoint in (
+                "http://controller.internal:2379",
+                "http://192.0.2.1:2379",
+                "https://[2001:db8::1]:2379"):
+            with self.subTest(valid_endpoint=endpoint):
+                self.assertEqual(
+                    "passed",
+                    _assertion_outcome(
+                        task,
+                        {
+                            **valid,
+                            "powerops_evacuation_guard_endpoint": endpoint,
+                        },
+                    ),
+                )
         valid_tls_pair = {
             **valid,
             "powerops_evacuation_guard_endpoint": "http://[2001:db8::1]:1",
