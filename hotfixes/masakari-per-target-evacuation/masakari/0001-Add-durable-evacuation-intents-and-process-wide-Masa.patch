+# under the License.
+
+"""Bounded process dispatch and observer-only durable evacuation intents."""
+import copy
+import uuid
+
+from eventlet import greenpool
+from eventlet import queue
+from oslo_log import log as logging
+from powerops_evacuation_guard import config
+from powerops_evacuation_guard import GuardDenied
+from powerops_evacuation_guard import GuardError
+
+from masakari import conf
+from masakari import context as masakari_context
+from masakari import exception
+from masakari.objects import fields
+
+CONF = conf.CONF
+LOG = logging.getLogger(__name__)
+_POOL = None
+
+
+def validate(coordinator):
+    if not CONF.powerops.enabled or coordinator is None:
+        raise exception.HostRecoveryFailureException(
+            message='Evacuation guard requires PowerOps and '
+                    'source coordinator')
+    coordinator.assert_healthy()
+
+
+def dispatch(vmoves, callback):
+    """Share one pool across recoveries; never create a waiter for each VM.
+
+    A feeder may wait for another recovery's capacity. Its worker rechecks
+    failure after that wait. Only this recovery's started workers are drained;
+    their coordinator remains owned by the calling task throughout.
+    """
+    global _POOL
+    size = CONF.powerops_evacuation_guard.submission_workers
+    if _POOL is None:
+        _POOL = greenpool.GreenPool(size)
+    elif _POOL.size != size:
+        # Pool replacement while feeders wait could create a second limit.
+        raise exception.HostRecoveryFailureException(
+            message='Changing submission_workers requires engine restart')
+    pool = _POOL
+    completed = queue.LightQueue()
+    stopped = False
+    errors = []
+    pending = 0
+    iterator = iter(vmoves)
+    exhausted = False
+
+    def stop():
+        nonlocal stopped
+        stopped = True
+
+    def run(vmove):
+        nonlocal stopped
+        try:
+            if not stopped:
+                callback(vmove, lambda: not stopped, stop)
+                if vmove.status == fields.VMoveStatus.FAILED:
+                    stopped = True
+        except BaseException as error:
+            stopped = True
+            errors.append(error)
+        finally:
+            completed.put(None)
+
+    try:
+        while not exhausted and not stopped:
+            while pending < size and not stopped:
+                try:
+                    vmove = next(iterator)
+                except StopIteration:
+                    exhausted = True
+                    break
+                pool.spawn_n(run, vmove)
+                pending += 1
+            if pending:
+                completed.get()
+                pending -= 1
+    except BaseException:
+        # Feeder cancellation prohibits fresh work, but cannot cancel Nova.
+        stopped = True
+        raise
+    finally:
+        while pending:
+            completed.get()
+            pending -= 1
+    if errors:
+        raise errors[0]
+
+
+class Attempt:
+    def __init__(self, context, vmove, can_submit, stop):
+        self.guard = config.from_conf(CONF)
+        self.uuid = str(uuid.uuid4())
+        self.request_id = 'req-' + str(uuid.uuid4())
+        # A new context also avoids sharing oslo.db transaction state between
+        # workers. Do not update the task context or a shared SDK session.
+        values = copy.deepcopy(context.to_dict())
+        values['global_request_id'] = self.request_id
+        self.context = masakari_context.RequestContext.from_dict(
+            values, overwrite=False)
+        self.vm_uuid = vmove.instance_uuid
+        self.source_host = vmove.source_host
+        self.submitted = False
+        self.can_submit = can_submit
+        self.stop = stop
+
+    def check_submission(self):
+        if not self.can_submit():
+            raise GuardDenied('Recovery stopped before evacuation submission')
+
+    def reserve(self):
+        self.check_submission()
+        self.guard.create_intent(self.uuid, self.vm_uuid, self.source_host,
+                                 self.request_id, 'masakari-engine')
+
+    def failure(self, reason):
+        # Stop the feeder before slow observation writes or unlock cleanup.
+        self.stop()
+        # Guard errors are sanitized at the package boundary. Other errors
+        # may contain credentials, so keep only their class name.
+        if isinstance(reason, BaseException):
+            reason = (str(reason)[:800] if isinstance(reason, GuardError)
+                      else type(reason).__name__)
+        outcome = 'unknown' if self.submitted else 'not submitted'
+        message = 'Attempt %s: %s; %s' % (self.uuid, outcome, reason)
+        if self.submitted:
+            try:
+                self.guard.note_intent_unknown(self.uuid, message)
+            except GuardError:
+                LOG.warning('Could not persist observation for attempt %s; '
+                            'existing durable intent remains', self.uuid)
+        return message
+
+    def confirmed(self, target_host, vm_state):
+        intent = self.guard.get_intent(self.uuid)
+        if (intent['attempt_uuid'] != self.uuid or
+                intent['vm_uuid'] != self.vm_uuid or
+                intent['source_host'] != self.source_host or
+                intent['request_id'] != self.request_id):
+            raise GuardDenied('Evacuation intent identity mismatch')
+        if intent['state'] != 'BOUND':
+            return False
+        operation = self.guard.get_operation(intent['migration_uuid'])
+        if (operation['migration_uuid'] != intent['migration_uuid'] or
+                operation['attempt_uuid'] != self.uuid or
+                operation['vm_uuid'] != self.vm_uuid or
+                operation['source_host'] != self.source_host or
+                operation['request_id'] != self.request_id):
+            raise GuardDenied('Evacuation operation identity mismatch')
+        if operation['state'] in ('DENIED', 'UNKNOWN'):
+            raise GuardDenied('Nova evacuation is ' + operation['state'])
+        if operation['state'] != 'DONE':
+            return False
+        result = operation['result']
+        if (operation['target_host'] != target_host or not result or
+                result['migration_status'] != 'done' or
+                result['vm_uuid'] != self.vm_uuid or
+                result['target_uuid'] != operation['target_uuid'] or
+                result['target_host'] != target_host or
+                result['vm_state'] != vm_state or
+                result['task_state'] is not None):
+            raise GuardDenied('Evacuation completion proof mismatch')
+        return True
