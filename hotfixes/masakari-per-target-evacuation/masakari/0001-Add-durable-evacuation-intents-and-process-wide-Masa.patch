+        self.assertEqual('DONE', self.guard.get_operation(
+            intent['migration_uuid'])['state'])
+        self.assertEqual(1, len(self.calls))
+        self.assertEqual(fields.VMoveStatus.FAILED,
+                         self.vmoves[notification][0].status)
+
+    def test_ongoing_from_interrupted_recovery_cannot_be_skipped(self):
+        notification = self.inventory('source-a', 2)
+        vmove = self.vmoves[notification][0]
+        vmove.status = fields.VMoveStatus.ONGOING
+        attempt = uid()
+        self.guard.create_intent(attempt, vmove.instance_uuid, 'source-a',
+                                 'req-' + uid(), 'interrupted-engine')
+        self.assertRaises(exception.HostRecoveryFailureException,
+                          self.task, 'source-a', notification)
+        self.assertEqual([], self.calls)
+        self.assertEqual(fields.VMoveStatus.ONGOING, vmove.status)
+        self.assertEqual('SUBMITTING', self.guard.get_intent(attempt)['state'])
+
+    def test_failure_stops_feeding_before_slow_unlock_cleanup_finishes(self):
+        notification = self.inventory('source-a', 12)
+        first = sorted(v.instance_uuid for v in self.vmoves[notification])[:3]
+        cleanup = eventlet.event.Event()
+        release_cleanup = eventlet.event.Event()
+        original_http = self.http
+        original_evacuation = self.remote_evacuation
+
+        def http_boundary(method, url, **kwargs):
+            data = kwargs.get('json')
+            if data is None and kwargs.get('data'):
+                data = jsonutils.loads(kwargs['data'])
+            if (url.endswith('/' + first[0] + '/action') and
+                    isinstance(data, dict) and 'unlock' in data):
+                cleanup.send()
+                release_cleanup.wait()
+            return original_http(method, url, **kwargs)
+
+        def nova_boundary(vm, request_id):
+            if vm == first[0]:
+                eventlet.sleep(0.003)
+                raise requests.Timeout('ambiguous result')
+            return original_evacuation(vm, request_id)
+
+        self.patch(requests.Session, 'request', side_effect=http_boundary)
+        self.remote_evacuation = nova_boundary
+
+        def recover():
+            return self.assertRaises(exception.HostRecoveryFailureException,
+                                     self.task, 'source-a', notification)
+
+        worker = eventlet.spawn(recover)
+        with eventlet.Timeout(5):
+            cleanup.wait()
+            eventlet.sleep(0.06)
+            observed = [vm for vm, *_ in self.calls]
+            release_cleanup.send()
+            worker.wait()
+        self.assertEqual(set(first), set(observed))
