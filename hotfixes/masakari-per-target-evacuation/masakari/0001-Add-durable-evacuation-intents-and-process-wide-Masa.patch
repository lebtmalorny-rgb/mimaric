+        release_remaining = eventlet.event.Event()
+        entered_vms = []
+        original = self.remote_evacuation
+
+        def nova_boundary(vm, request_id):
+            if vm in first:
+                entered_vms.append(vm)
+                if len(entered_vms) == 3:
+                    entered.send()
+                if vm == first[0]:
+                    release_failure.wait()
+                    raise requests.Timeout('ambiguous HTTP response')
+                release_remaining.wait()
+            return original(vm, request_id)
+
+        self.remote_evacuation = nova_boundary
+
+        def recover(host, notification):
+            try:
+                return self.task(host, notification)
+            except exception.HostRecoveryFailureException as error:
+                return error
+
+        failed = eventlet.spawn(recover, 'source-a', failed_notification)
+        with eventlet.Timeout(5):
+            entered.wait()
+            other = eventlet.spawn(recover, 'source-b', other_notification)
+            release_failure.send()
+            eventlet.sleep(0.03)
+            self.assertFalse(failed.dead)
+            self.assertIn('powerops/host/source-a',
+                          self.coordinators['source-a'].active_locks)
+            self.assertTrue(any(vm not in first for vm, *_ in self.calls))
+            release_remaining.send()
+            self.assertIsInstance(failed.wait(),
+                                  exception.HostRecoveryFailureException)
+            self.assertNotIsInstance(other.wait(), Exception)
+        failed_ids = {v.instance_uuid
+                      for v in self.vmoves[failed_notification]}
+        self.assertEqual(set(first), {vm for vm, *_ in self.calls
+                                      if vm in failed_ids})
+        self.assertEqual(9, len(self.calls))
+        self.assertEqual(0, self.active)
+        self.assertLessEqual(self.peak, 3)
+        pending = [v for v in self.vmoves[failed_notification]
+                   if v.status == fields.VMoveStatus.PENDING]
+        self.assertEqual(9, len(pending))
+        calls = list(self.calls)
+        self.assertRaises(exception.HostRecoveryFailureException,
+                          self.task, 'source-a', failed_notification)
+        self.assertEqual(calls, self.calls)
