+"""Real TaskFlow, Nova SDK and Guard; only HTTP and VMove persistence faked."""
+import copy
+from unittest import mock
+from urllib import parse
+import uuid
+
+import eventlet
+from keystoneauth1 import noauth
+from oslo_serialization import jsonutils
+from powerops_evacuation_guard import config as guard_config
+from powerops_evacuation_guard import GuardBusy
+from powerops_evacuation_guard import GuardDenied
+import requests
+
+from masakari.compute import nova
+from masakari import conf
+from masakari import context
+from masakari.engine.drivers.taskflow import host_failure
+from masakari import exception
+from masakari import objects
+from masakari.objects import fields
+from masakari import test
+from masakari.tests.unit.powerops import evacuation_etcd
+from masakari.tests.unit.powerops import fakes
+
+objects.register_all()
+CONF = conf.CONF
+
+
+def uid():
+    return str(uuid.uuid4())
+
+
+class EvacuationTest(test.NoDBTestCase):
+    def setUp(self):
+        super().setUp()
+        for group, name, value in [
+                ('powerops_evacuation_guard', 'enabled', True),
+                ('powerops_evacuation_guard', 'cooldown', 0),
+                ('powerops_evacuation_guard', 'submission_workers', 3),
+                ('powerops', 'enabled', True),
+                ('powerops', 'evacuation_interval', 0),
+                ('host_failure', 'evacuate_all_instances', True),
+                ('keystone_authtoken', 'auth_type', 'none'),
+                (None, 'verify_interval', 0),
+                (None, 'wait_period_after_evacuation', 1)]:
+            CONF.set_override(name, value, group)
+            self.addCleanup(CONF.clear_override, name, group)
+        self.backend = evacuation_etcd.Etcd()
+        self.patch(requests, 'post', side_effect=self.backend.post)
+        self.guard = guard_config.from_conf(CONF)
+        self.guard.initialize('test', 'initialize isolated HTTP fake')
+        self.patch(requests.Session, 'request', side_effect=self.http)
+        loader = mock.Mock()
+        loader.load_from_options.return_value = noauth.NoAuth(
+            endpoint='http://nova.example/v2.1')
+        self.patch(nova.keystoneauth1.loading, 'get_plugin_loader',
+                   return_value=loader)
+        self.ctx = context.RequestContext(is_admin=True, overwrite=False)
+        self.original_context = self.ctx.to_dict()
+        self.servers = {}
+        self.vm_sequence = 0
+        self.vm_prefix = uuid.uuid4().int & ~0xffff
+        self.vmoves = {}
+        self.calls = []
+        self.active = 0
+        self.peak = 0
+        self.spawn_active = set()
+        self.spawn_peak = 0
+        self.mode = 'done'
+        self.events = []
+        self.coordinators = {}
+        self.patch(objects.VMoveList, 'get_all_vmoves', side_effect=(
+            lambda ctxt, notification, status=None: [
+                v for v in self.vmoves[notification]
+                if status is None or v.status == status]))
+        self.patch(objects.VMove, 'save', lambda obj: None)
+        self.patch(objects.VMove, 'create', lambda obj: self.vmoves.setdefault(
+            obj.notification_uuid, []).append(obj))
+
+    def patch(self, obj, name, *args, **kwargs):
+        patcher = mock.patch.object(obj, name, *args, **kwargs)
+        result = patcher.start()
+        self.addCleanup(patcher.stop)
+        return result
+
+    def inventory(self, host, count):
+        notification = uid()
+        self.vmoves[notification] = []
+        for index in range(count):
+            self.vm_sequence += 1
+            vm = str(uuid.UUID(int=self.vm_prefix + self.vm_sequence))
+            self.servers[vm] = dict(
+                id=vm, name=vm, metadata={}, locked=False,
+                **{'OS-EXT-SRV-ATTR:host': host,
+                   'OS-EXT-STS:vm_state': 'active',
+                   'OS-EXT-STS:task_state': None,
+                   'OS-EXT-STS:power_state': 1})
+            vmove = objects.VMove(context=self.ctx, instance_uuid=vm,
+                                  instance_name=vm,
+                                  notification_uuid=notification,
+                                  source_host=host,
+                                  status=fields.VMoveStatus.PENDING,
+                                  type=fields.VMoveType.EVACUATION)
+            vmove.create()
+        return notification
+
+    def http(self, method, url, **kwargs):
+        path = parse.urlsplit(url).path
+        headers = requests.structures.CaseInsensitiveDict(
+            kwargs.get('headers', {}))
+        if path.endswith('/servers/detail'):
+            query = parse.parse_qs(parse.urlsplit(url).query)
+            source = query['host'][0]
+            servers = sorted((v for v in self.servers.values()
+                              if v['OS-EXT-SRV-ATTR:host'] == source),
+                             key=lambda v: v['id'])
+            marker = query.get('marker', [None])[0]
+            if marker:
+                servers = [s for s in servers if s['id'] > marker]
+            body, status = {'servers': servers[:2]}, 200
+        elif method.upper() == 'GET':
+            vm = path.split('/')[-1]
+            body, status = {'server': copy.deepcopy(self.servers[vm])}, 200
+        else:
+            vm = path.split('/')[-2]
+            payload = kwargs.get('json')
+            if payload is None:
+                payload = jsonutils.loads(kwargs['data'])
+            if 'evacuate' in payload:
+                self.active += 1
+                self.peak = max(self.peak, self.active)
+                request_id = headers.get('X-Openstack-Request-Id')
+                self.calls.append((vm, request_id, payload, dict(headers)))
+                try:
+                    self.remote_evacuation(vm, request_id)
+                finally:
+                    self.active -= 1
+            elif 'lock' in payload:
+                self.servers[vm]['locked'] = True
+            elif 'unlock' in payload:
+                self.servers[vm]['locked'] = False
+            elif 'os-stop' in payload:
+                self.servers[vm]['OS-EXT-STS:vm_state'] = 'stopped'
+            elif 'os-resetState' in payload:
+                self.servers[vm]['OS-EXT-STS:vm_state'] = (
+                    payload['os-resetState']['state'])
+                self.servers[vm]['OS-EXT-STS:task_state'] = None
+            else:
+                raise AssertionError(payload)
+            body, status = {}, 202
+        response = requests.Response()
+        response.status_code = status
+        response._content = jsonutils.dumps(body).encode()
+        response.headers['Content-Type'] = 'application/json'
+        return response
+
+    def remote_evacuation(self, vm, request_id):
+        eventlet.sleep(0.005)
+        source = self.servers[vm]['OS-EXT-SRV-ATTR:host']
+        self.assertIn('powerops/host/' + source,
+                      self.coordinators[source].active_locks)
+        # Nova automatic scheduler boundary: two targets for every source.
+        target = 'target-' + str(int(uuid.UUID(vm)) % 2)
+        target_id = str(uuid.uuid5(uuid.NAMESPACE_DNS, target))
+        migration, owner = uid(), uid()
+        guard = guard_config.from_conf(CONF)
+        guard.register(migration, vm, source, target_id, target, owner,
+                       request_id=request_id)
+        while True:
+            try:
+                guard.try_admit(migration, owner)
+                break
+            except GuardBusy:
+                eventlet.sleep(0.001)
+        self.assertNotIn(target, self.spawn_active)
+        self.spawn_active.add(target)
+        self.spawn_peak = max(self.spawn_peak, len(self.spawn_active))
+        eventlet.sleep(0.005)
+        self.spawn_active.remove(target)
+        self.servers[vm]['OS-EXT-SRV-ATTR:host'] = target
+        final_state = ('stopped' if
+                       self.servers[vm]['OS-EXT-STS:vm_state'] == 'stopped'
+                       else 'active')
+        self.servers[vm]['OS-EXT-STS:vm_state'] = final_state
+        self.servers[vm]['OS-EXT-STS:task_state'] = None
+        if self.mode == 'unknown':
+            guard.mark_unknown(migration, owner, 'external uncertainty')
+        else:
+            guard.complete(migration, owner, dict(
+                migration_status='done', vm_uuid=vm, target_uuid=target_id,
+                target_host=target, vm_state=final_state, task_state=None))
+            if self.mode != 'cooldown':
+                guard.finish_cooldown(migration, owner)
+
+    def task(self, host, notification):
+        coordinator = fakes.recording_coordinator(self.events)
+        self.coordinators[host] = coordinator
+        task = host_failure.EvacuateInstancesTask(
+            self.ctx, nova.API(), update_host_method=None,
+            powerops_coordinator=coordinator)
+        with coordinator, coordinator.lock('powerops/host/' + host, 10):
+            task.execute(host, notification)
+        return coordinator
+
+    def test_process_pool_covers_all_vms_across_notifications(self):
+        jobs = [(host, self.inventory(host, 6))
