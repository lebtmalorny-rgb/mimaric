+"""Durable admission around the entire receiving-compute evacuation path.
+
+This must wrap *outside* Nova's state-changing error decorators. A duplicate
+RPC has no authority to reset the task or migration state of its executor.
+"""
+import functools
+import inspect
+import time
+import uuid
+
+from oslo_log import log as logging
+from oslo_utils import uuidutils
+from powerops_evacuation_guard import config
+from powerops_evacuation_guard import GuardBusy
+from powerops_evacuation_guard import GuardDenied
+from powerops_evacuation_guard import GuardDuplicate
+from powerops_evacuation_guard import GuardError
+
+from nova.compute import task_states
+from nova.compute import vm_states
+import nova.conf
+from nova import objects
+
+CONF = nova.conf.CONF
+LOG = logging.getLogger(__name__)
+
+
+def _uuid(value):
+    try:
+        if not isinstance(value, str) or str(uuid.UUID(value)) != value:
+            raise ValueError()
+    except (ValueError, AttributeError):
+        raise GuardDenied('Missing or invalid evacuation identity') from None
+    return value
+
+
+def _field(obj, name):
+    # Avoid lazy loading missing identities on RPC objects.
+    if obj is not None and obj.obj_attr_is_set(name):
+        return getattr(obj, name)
+    return None
+
+
+def _binding(migration, instance_uuid, host, node):
+    if (migration.instance_uuid != instance_uuid or
+            migration.migration_type != 'evacuation' or
+            not migration.source_compute or
+            migration.source_compute == host):
+        raise GuardDenied('Invalid evacuation migration binding')
+    # The API deliberately leaves these unset for automatic scheduling.
+    for field, expected in (('dest_compute', host),
+                            ('dest_node', node.hypervisor_hostname),
+                            ('dest_compute_id', node.id)):
+        if _field(migration, field) not in (None, expected):
+            raise GuardDenied('Evacuation destination binding changed')
+
+
+def _pending(context, migration_uuid, instance_uuid, source, node, host):
+    migration = objects.Migration.get_by_uuid(context, migration_uuid)
+    instance = objects.Instance.get_by_uuid(context, instance_uuid)
+    _binding(migration, instance_uuid, host, node)
+    if (migration.uuid != migration_uuid or
+            instance.uuid != instance_uuid or
+            migration.source_compute != source or
+            migration.status != 'accepted' or instance.host != source or
+            instance.node != migration.source_node or
+            instance.task_state != task_states.REBUILDING):
+        raise GuardDenied('Evacuation is no longer pending at its source')
+
+
+def _result(context, migration_uuid, instance_uuid, source, node, host,
+            expected_state):
+    migration = objects.Migration.get_by_uuid(context, migration_uuid)
+    instance = objects.Instance.get_by_uuid(context, instance_uuid)
+    current_node = objects.ComputeNode.get_by_host_and_nodename(
+        context, host, node.hypervisor_hostname)
+    if (migration.uuid != migration_uuid or
+            migration.instance_uuid != instance_uuid or
+            migration.migration_type != 'evacuation' or
+            migration.source_compute != source or migration.status != 'done' or
+            migration.dest_compute != host or
+            migration.dest_node != node.hypervisor_hostname or
+            migration.dest_compute_id != node.id or
+            instance.uuid != instance_uuid or instance.host != host or
+            instance.node != node.hypervisor_hostname or
+            instance.compute_id != node.id or
+            current_node.uuid != node.uuid or current_node.id != node.id or
+            instance.task_state is not None or
+            instance.vm_state != expected_state):
+        raise GuardDenied('Nova evacuation completion is not proven')
+    return dict(migration_status='done', vm_uuid=instance_uuid,
+                target_uuid=node.uuid, target_host=host,
+                vm_state=instance.vm_state, task_state=None)
+
+
+def _unknown(guard, migration_uuid, owner):
+    try:
+        guard.mark_unknown(migration_uuid, owner,
+                           'Receiving compute outcome is uncertain')
+    except GuardError:
+        # RUNNING, COOLDOWN or a tombstone remains durable even if this
+        # observation cannot be written. Never release on this error path.
+        LOG.warning('Could not record uncertain evacuation outcome for %s',
+                    migration_uuid)
+
+
+def _execute(function, args):
+    compute, context, instance = (args['self'], args['context'],
+                                  args['instance'])
+    migration_uuid = _uuid(_field(args['migration'], 'uuid'))
+    instance_uuid = _uuid(_field(instance, 'uuid'))
+    context = context.elevated()
+    scheduled_node = args['scheduled_node']
+    if scheduled_node:
+        node = objects.ComputeNode.get_by_host_and_nodename(
+            context, compute.host, scheduled_node)
+    else:
+        node = compute._get_compute_info(context, compute.host)
+    _uuid(_field(node, 'uuid'))
+    if (node.host != compute.host or not node.hypervisor_hostname or
+            (scheduled_node and node.hypervisor_hostname != scheduled_node)):
+        raise GuardDenied('Selected compute node is not local')
+    migration = objects.Migration.get_by_uuid(context, migration_uuid)
+    if _field(migration, 'uuid') != migration_uuid:
+        raise GuardDenied('Nova migration lookup identity changed')
+    _binding(migration, instance_uuid, compute.host, node)
+    _binding(args['migration'], instance_uuid, compute.host, node)
+    source = migration.source_compute
+    if (args['migration'].source_compute != source or
+            args['migration'].source_node != migration.source_node):
+        raise GuardDenied('RPC migration source does not match Nova')
+    guard = config.from_conf(CONF)
+    owner = uuidutils.generate_uuid()
+    try:
+        guard.register(migration_uuid, instance_uuid, source, node.uuid,
+                       compute.host, owner,
+                       request_id=getattr(context, 'global_request_id', None))
+    except GuardDuplicate:
+        # The request index may instead identify an already-bound intent.
+        # Only this exact migration's known COOLDOWN may be recovered. Never
+        # scan historical status pages or resolve RUNNING/UNKNOWN here.
+        LOG.info('Ignoring duplicate evacuation delivery %s', migration_uuid)
+        try:
+            existing = guard.get_operation(migration_uuid)
+        except GuardError:
+            return None
+        if (existing['state'] == 'COOLDOWN' and
+                existing['vm_uuid'] == instance_uuid and
+                existing['source_host'] == source and
+                existing['target_uuid'] == node.uuid and
+                existing['target_host'] == compute.host):
+            guard.recover_cooldown(
+                migration_uuid, existing['revision'], compute.host,
+                'Recover proven completion on duplicate delivery')
+        return None
+
+    try:
+        if (instance.host != source or
+                instance.node != migration.source_node or
+                instance.task_state != task_states.REBUILDING):
+            raise GuardDenied('RPC instance is not pending at its source')
+        _pending(context, migration_uuid, instance_uuid, source, node,
+                 compute.host)
+    except Exception:
+        guard.deny_waiting(migration_uuid, owner,
+                           'Nova evacuation is no longer pending')
+        raise
+
+    deadline = (time.monotonic() +
+                CONF.powerops_evacuation_guard.admission_timeout)
+    try:
+        while True:
+            if time.monotonic() >= deadline:
+                guard.deny_waiting(migration_uuid, owner,
+                                   'Receiving compute admission timed out')
+                raise GuardDenied('Evacuation admission timed out')
+            try:
+                guard.try_admit(migration_uuid, owner)
+                break
+            except GuardBusy:
+                time.sleep(min(CONF.powerops_evacuation_guard.poll_interval,
+                               max(0, deadline - time.monotonic())))
+        _pending(context, migration_uuid, instance_uuid, source, node,
+                 compute.host)
+        if time.monotonic() >= deadline:
+            # Admission may have committed while its response was delayed.
+            # Retain UNKNOWN; no late executor may start the local rebuild.
+            raise GuardDenied('Evacuation admission deadline elapsed')
+        # Preserve scheduler selection, including old explicit-host RPCs
+        # whose scheduled_node was None. No scheduling/Placement changes.
+        args['scheduled_node'] = node.hypervisor_hostname
+        expected_state = instance.vm_state
+        if args['target_state'] and expected_state != vm_states.ERROR:
+            expected_state = args['target_state']
+        if expected_state != vm_states.STOPPED:
+            expected_state = vm_states.ACTIVE
+        result = function(**args)
+        proof = _result(context, migration_uuid, instance_uuid, source, node,
+                        compute.host, expected_state)
+        guard.complete(migration_uuid, owner, proof)
+        guard.finish_cooldown(migration_uuid, owner)
+        return result
+    except BaseException:
+        _unknown(guard, migration_uuid, owner)
+        raise
+
+
+def guard_rebuild(function):
+    @functools.wraps(function)
+    def wrapped(self, context, instance, orig_image_ref, image_ref,
+                injected_files, new_pass, orig_sys_metadata,
+                bdms, recreate, on_shared_storage,
+                preserve_ephemeral, migration,
+                scheduled_node, limits, request_spec, accel_uuids,
+                reimage_boot_volume=None, target_state=None):
+        arguments = dict(
+            self=self, context=context, instance=instance,
+            orig_image_ref=orig_image_ref, image_ref=image_ref,
+            injected_files=injected_files, new_pass=new_pass,
+            orig_sys_metadata=orig_sys_metadata, bdms=bdms, recreate=recreate,
+            on_shared_storage=on_shared_storage,
+            preserve_ephemeral=preserve_ephemeral, migration=migration,
+            scheduled_node=scheduled_node, limits=limits,
+            request_spec=request_spec, accel_uuids=accel_uuids,
+            reimage_boot_volume=reimage_boot_volume, target_state=target_state)
+        if not CONF.powerops_evacuation_guard.enabled or not recreate:
+            return function(**arguments)
+        return _execute(function, arguments)
+    # oslo_messaging.expected_exceptions does not preserve __wrapped__.
+    # Publish the unchanged RPC signature explicitly, including defaults.
+    wrapped.__signature__ = inspect.signature(wrapped, follow_wrapped=False)
+    return wrapped
