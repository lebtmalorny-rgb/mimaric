+    def test_same_target_waits_while_other_target_spawns(self):
+        import eventlet
+        from eventlet import event
+        entered, release = event.Event(), event.Event()
+        inst1, mig1 = self._work()
+        inst2, mig2 = self._work()
+        other, node = self._compute('target-b', 'node-b')
+        inst3, mig3 = self._work(other, node)
+
+        def block_first(inst):
+            if inst.uuid == inst1.uuid:
+                entered.send()
+                release.wait()
+        self.spawn_effect = block_first
+        first = eventlet.spawn(self._run, inst1, mig1)
+        try:
+            with eventlet.timeout.Timeout(2):
+                entered.wait()
+                self._run(inst3, mig3, other, 'node-b')
+                self.assertRaises(GuardDenied, self._run, inst2, mig2)
+            self.assertEqual([inst1.uuid, inst3.uuid], self.spawns)
+            self.assertEqual('RUNNING',
+                             self.guard.get_operation(mig1.uuid)['state'])
+            self.assertEqual('DENIED',
+                             self.guard.get_operation(mig2.uuid)['state'])
+            # A timed-out attempt can never execute on later delivery.
+            self._run(inst2, mig2)
+            self.assertEqual([inst1.uuid, inst3.uuid], self.spawns)
+        finally:
+            release.send()
+            first.wait()
