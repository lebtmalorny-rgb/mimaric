+    def test_claim_held_during_finish_evacuation_and_cooldown(self):
+        from powerops_evacuation_guard import GuardBusy
+        inst, mig = self._work()
+        waiting_inst, waiting_mig = self._work()
+        owner = new_uuid()
+        self.guard.register(waiting_mig.uuid, waiting_inst.uuid, 'source',
+                            self.node.uuid, 'target-a', owner)
+        observed = []
+
+        def during_finish(saved):
+            if saved.uuid == inst.uuid and saved.host == 'target-a':
+                observed.append(self.guard.get_operation(mig.uuid)['state'])
+                self.assertRaises(GuardBusy, self.guard.try_admit,
+                                  waiting_mig.uuid, owner)
+                self.assertNotEqual('done', self.migrations[mig.uuid].status)
+        self.save_effect = during_finish
+
+        def during_cooldown():
+            if self.guard.get_operation(mig.uuid)['state'] == 'COOLDOWN':
+                self.gateway.after_write = None
+                observed.append('COOLDOWN')
+                self.assertEqual('done', self.migrations[mig.uuid].status)
+                self.assertRaises(GuardBusy, self.guard.try_admit,
+                                  waiting_mig.uuid, owner)
+        self.gateway.after_write = during_cooldown
+        self._run(inst, mig)
+        self.assertEqual(['RUNNING', 'COOLDOWN'], observed)
+        self.guard.try_admit(waiting_mig.uuid, owner)
+        self.assertEqual('RUNNING',
+                         self.guard.get_operation(waiting_mig.uuid)['state'])
