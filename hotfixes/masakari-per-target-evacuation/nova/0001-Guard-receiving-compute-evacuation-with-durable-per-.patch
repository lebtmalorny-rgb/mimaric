+"""Receiving-compute tests: real rebuild, claims, spawn and completion path.
+
+Only the external etcd HTTP, Nova DB, virt and service boundaries are faked.
+Removing the admission wrapper must allow the forbidden second spawn.
+"""
+import base64
+import copy
+import threading
+from unittest import mock
+
+import ddt
+from oslo_utils import uuidutils
+from powerops_evacuation_guard import config as guard_config
+from powerops_evacuation_guard import GuardDenied
+import requests
+
+from nova.compute import manager
+from nova.compute import task_states
+from nova.compute import utils as compute_utils
+from nova.compute import vm_states
+import nova.conf
+from nova import context
+from nova.db.main import api as db
+from nova import objects
+from nova import test
+from nova.tests import fixtures
+from nova.tests.unit.compute import fake_resource_tracker
+from nova.tests.unit.compute import test_resource_tracker
+from nova.tests.unit import fake_instance
+
+
+def new_uuid():
+    return uuidutils.generate_uuid()
+
+
+class Gateway:
+    """Atomic HTTP etcd boundary; exercises the installed production Guard."""
+
+    def __init__(self):
+        self.data = {}
+        self.revision = 1
+        self.lock = threading.RLock()
+        self.after_write = None
+
+    def keys(self, req):
+        lo = base64.b64decode(req['key'])
+        hi = (base64.b64decode(req['range_end'])
+              if 'range_end' in req else None)
+        return sorted(k for k in self.data
+                      if (lo <= k < hi if hi else k == lo))
+
+    def post(self, url, **kwargs):
+        with self.lock:
+            req = kwargs['json']
+            if url.endswith('/range'):
+                keys = self.keys(req)
+                limited = keys[:int(req.get('limit', len(keys)))]
+                body = {'kvs': [self.data[k] for k in limited],
+                        'count': str(len(keys)),
+                        'more': len(limited) < len(keys)}
+            else:
+                assert url.endswith('/txn')
+                ok = True
+                for cmp in req['compare']:
+                    field = {'MOD': 'mod_revision',
+                             'VERSION': 'version'}[cmp['target']]
+                    values = [self.data[k] for k in self.keys(cmp)] or [{}]
+                    ok &= all(int(v.get(field, 0)) == int(cmp[field])
+                              for v in values)
+                ops = req['success' if ok else 'failure']
+                if ops:
+                    self.revision += 1
+                out = []
+                for op in ops:
+                    if 'request_put' in op:
+                        put = op['request_put']
+                        assert not put.get('lease')
+                        key = base64.b64decode(put['key'])
+                        old = self.data.get(key, {})
+                        self.data[key] = dict(
+                            key=put['key'], value=put['value'],
+                            mod_revision=str(self.revision),
+                            create_revision=old.get(
+                                'create_revision', str(self.revision)),
+                            version=str(int(old.get('version', 0)) + 1))
+                        out.append({'response_put': {}})
+                    else:
+                        keys = self.keys(op['request_delete_range'])
+                        for key in keys:
+                            del self.data[key]
+                        out.append({'response_delete_range': {
+                            'deleted': str(len(keys))}})
+                body = {'succeeded': bool(ok), 'responses': out}
+                if ops and self.after_write:
+                    self.after_write()
+            body['header'] = {'revision': str(self.revision)}
+            response = mock.Mock(status_code=200)
+            response.json.return_value = copy.deepcopy(body)
+            return response
+
+
+@ddt.ddt
+class ReceivingComputeTest(test.NoDBTestCase):
+    REQUIRES_LOCKING = True
+    STUB_COMPUTE_ID = False
+
+    def setUp(self):
+        super().setUp()
+        self.flags(enabled=True, cooldown=0.01, admission_timeout=0.05,
+                   poll_interval=0.005, group='powerops_evacuation_guard')
+        self.flags(api_servers=['http://image.invalid'], group='glance')
+        self.useFixture(fixtures.EventReporterStub())
+        self.context = context.get_admin_context()
+        self.gateway = Gateway()
+        self._patch(requests, 'post', self.gateway.post)
+        self.guard = guard_config.from_conf(nova.conf.CONF)
+        self.guard.initialize('unit-test', 'isolated test namespace')
+        self.instances = {}
+        self.migrations = {}
+        self.spawns = []
+        self.spawn_effect = None
+        self.save_effect = None
+        self._patch(objects.Instance, 'save',
+                    lambda inst, **kw: self._save_instance(inst, **kw))
+        self._patch(objects.Migration, 'save',
+                    lambda mig, **kw: self._save_migration(mig, **kw))
+        self._patch(objects.Instance, 'get_by_uuid',
+                    lambda ctxt, uuid, **kw: self.instances[uuid].obj_clone())
+        self._patch(objects.Migration, 'get_by_uuid',
+                    lambda ctxt, uid: self.migrations[uid].obj_clone())
+        self._patch(db, 'instance_extra_update_by_uuid', lambda *a, **kw: None)
+        self._patch(objects.InstanceFault, 'create', lambda fault: None)
+        self._patch(objects.ShareMappingList, 'get_by_instance_uuid',
+                    lambda *a, **kw: objects.ShareMappingList(objects=[]))
+        self._patch(objects.BlockDeviceMappingList, 'get_by_instance_uuid',
+                    lambda *a, **kw: objects.BlockDeviceMappingList(
+                        objects=[]))
+        for name in ('notify_about_instance_rebuild', 'notify_usage_exists',
+                     'notify_about_instance_action',
+                     'notify_about_instance_usage'):
+            self._patch(compute_utils, name, lambda *a, **kw: None)
+        self.compute, self.node = self._compute('target-a', 'node-a')
+        self._patch(objects.ComputeNode, 'get_by_host_and_nodename',
+                    lambda ctxt, host, node: self.nodes[
+                        (host, node)].obj_clone())
+        self._patch(objects.ComputeNode,
+                    'get_first_node_by_host_for_old_compat',
+                    lambda ctxt, host: next(cn.obj_clone() for (h, n), cn in
+                                            self.nodes.items() if h == host))
+
+    def _patch(self, obj, name, value):
+        patch = mock.patch.object(obj, name, value)
+        patch.start()
+        self.addCleanup(patch.stop)
+
+    def _save_instance(self, inst, **kw):
+        self.instances[inst.uuid] = inst.obj_clone()
+        if self.save_effect:
+            self.save_effect(inst)
+
+    def _save_migration(self, mig, **kw):
+        self.migrations[mig.uuid] = mig.obj_clone()
+
+    def _compute(self, host, node):
+        compute = manager.ComputeManager(host=host)
+        compute.rt = fake_resource_tracker.FakeResourceTracker(
+            host, compute.driver)
+        template = test_resource_tracker._COMPUTE_NODE_FIXTURES[0]
+        values = {k: getattr(template, k) for k in template.fields
+                  if template.obj_attr_is_set(k)}
+        values.update(uuid=new_uuid(), host=host, hypervisor_hostname=node)
+        cn = objects.ComputeNode(**values)
+        compute.rt.compute_nodes[node] = cn
+        self.nodes = getattr(self, 'nodes', {})
+        self.nodes[(host, node)] = cn
+        compute.reportclient = mock.Mock()
+        compute.reportclient.get_allocations_for_consumer.return_value = {}
+        compute.rt.reportclient = compute.reportclient
+        compute.network_api = mock.Mock()
+        compute.network_api.get_instance_nw_info.return_value = []
+        compute.query_client = mock.Mock()
+        self._patch(compute.driver, 'get_available_nodes', lambda: [node])
+        self._patch(compute.driver, 'instance_exists', lambda inst: False)
+        self._patch(compute.driver, 'instance_on_disk', lambda inst: False)
+        original_spawn = compute.driver.spawn
+
+        def spawn(*args, **kwargs):
+            self._spawn(*args, **kwargs)
+            original_spawn(*args, **kwargs)
+        self._patch(compute.driver, 'spawn', spawn)
+        return compute, cn
+
+    def _spawn(self, ctxt, inst, *args, **kw):
+        self.spawns.append(inst.uuid)
+        if self.spawn_effect:
+            self.spawn_effect(inst)
+
+    def _work(self, compute=None, node=None):
+        compute, node = compute or self.compute, node or self.node
+        inst = fake_instance.fake_instance_obj(
+            self.context, uuid=new_uuid(), host='source', node='source-node',
+            vm_state=vm_states.ACTIVE, task_state=task_states.REBUILDING,
+            image_ref=new_uuid())
+        inst.system_metadata = {}
+        inst.metadata = {}
+        inst.numa_topology = None
+        inst.pci_requests = None
+        inst.pci_devices = objects.PciDeviceList(objects=[])
+        inst.trusted_certs = None
+        inst.info_cache = None
+        mig = objects.Migration(
+            self.context, uuid=new_uuid(), id=len(self.migrations) + 1,
+            instance_uuid=inst.uuid, source_compute='source',
+            source_node='source-node', dest_compute=compute.host,
+            dest_node=node.hypervisor_hostname, dest_compute_id=node.id,
+            status='accepted', migration_type='evacuation',
+            old_instance_type_id=inst.flavor.id,
+            new_instance_type_id=inst.flavor.id)
+        self._save_instance(inst)
+        self._save_migration(mig)
+        return inst, mig
+
+    def _run(self, inst, mig, compute=None, scheduled_node='node-a', **kw):
+        return (compute or self.compute).rebuild_instance(
+            self.context, inst, None, None, [], None, {}, [],
+            kw.pop('recreate', True), False, False, mig, scheduled_node,
+            {}, None, [], **kw)
+
+    def test_disabled_real_rebuild_path(self):
+        self.flags(enabled=False, group='powerops_evacuation_guard')
+        inst, mig = self._work()
+        self._run(inst, mig)
+        self.assertEqual([inst.uuid], self.spawns)
