+    def test_global_limit_blocks_fourth_target(self):
+        import eventlet
+        from eventlet import event
+        release = event.Event()
+        entered = [event.Event() for _ in range(3)]
+        works = [self._work()]
+        computes = [self.compute]
+        for number in range(1, 4):
+            compute, node = self._compute('target-%s' % number,
+                                          'node-%s' % number)
+            computes.append(compute)
+            works.append(self._work(compute, node))
+        blocked = {work[0].uuid: entered[i]
+                   for i, work in enumerate(works[:3])}
+
+        def hold(inst):
+            if inst.uuid in blocked:
+                blocked[inst.uuid].send()
+                release.wait()
+        self.spawn_effect = hold
+        running = []
+        try:
+            with eventlet.timeout.Timeout(2):
+                for i in range(3):
+                    inst, mig = works[i]
+                    running.append(eventlet.spawn(
+                        self._run, inst, mig, computes[i], mig.dest_node))
+                    entered[i].wait()
+                inst, mig = works[3]
+                self.assertRaises(GuardDenied, self._run, inst, mig,
+                                  computes[3], mig.dest_node)
+            self.assertEqual([w[0].uuid for w in works[:3]], self.spawns)
+            states = [self.guard.get_operation(m.uuid)['state']
+                      for inst, m in works]
+            self.assertEqual(['RUNNING', 'RUNNING', 'RUNNING', 'DENIED'],
+                             states)
+        finally:
+            release.send()
+            for worker in running:
+                worker.wait()
