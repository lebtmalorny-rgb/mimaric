+class OneObservationTimer:
+    """Replace wall-clock waiting only, keeping the real confirmation logic."""
+    def __init__(self, callback):
+        self.callback = callback
+
+    def start(self, **kwargs):
+        return self
+
+    def wait(self):
+        try:
+            self.callback()
+        except host_failure.loopingcall.LoopingCallDone as done:
+            return done.retvalue
+        raise host_failure.loopingcall.LoopingCallTimeOut()
+
+    def stop(self):
+        pass
+
