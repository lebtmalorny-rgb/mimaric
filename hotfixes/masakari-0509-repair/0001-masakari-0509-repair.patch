+class RecoveryLoadingTest(test.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.override_config('enabled', True, 'powerops')
+        self.coordinator = SimpleNamespace(assert_healthy=lambda: None)
+
+    def build(self, reserved=False, tasks=None):
+        option = ('host_rh_failure_recovery_tasks' if reserved else
+                  'host_auto_failure_recovery_tasks')
+        self.override_config(option, tasks if tasks is not None else
+                             copy.deepcopy(RH if reserved else AUTO),
+                             'taskflow_driver_recovery_flows')
+        build = (host_failure.get_rh_flow if reserved
+                 else host_failure.get_auto_flow)
+        with mock.patch.object(base, 'PERSISTENCE_BACKEND', None):
+            return build(None, None, {
+                'host_name': 'source.example', 'notification_uuid': 'offline',
+                'reserved_host_list': ['destination.example']},
+                powerops_coordinator=self.coordinator,
+                **({'update_host_method': None} if reserved else {}))
+
+    def test_broken_fencing_import_fails_before_engine_exists(self):
+        original = metadata.EntryPoint.load
+
+        def load(entry):
+            if entry.name == 'ironic_fence':
+                raise ImportError('simulated missing dependency')
+            return original(entry)
+
+        with mock.patch.object(metadata.EntryPoint, 'load', load):
+            for reserved in (False, True):
+                with self.subTest(reserved=reserved):
+                    self.assertRaises(exception.HostRecoveryFailureException,
+                                      self.build, reserved)
+
+    def test_real_loader_rejects_fencing_constructor_failure(self):
+        with mock.patch.object(powerops.IronicFenceTask, '__init__',
+                               side_effect=RuntimeError('broken constructor')):
+            for reserved in (False, True):
+                self.assertRaises(exception.HostRecoveryFailureException,
+                                  self.build, reserved)
+
+    def test_missing_duplicate_and_misordered_stages_fail_closed(self):
+        for reserved, valid in ((False, AUTO), (True, RH)):
+            for bad_pre in (['disable_compute_service_task'],
+                            ['ironic_fence', 'disable_compute_service_task'],
+                            ['disable_compute_service_task', 'ironic_fence',
+                             'ironic_fence']):
+                tasks = copy.deepcopy(valid)
+                tasks['pre'] = bad_pre
+                with self.subTest(reserved=reserved, pre=bad_pre):
+                    self.assertRaises(exception.HostRecoveryFailureException,
+                                      self.build, reserved, tasks)
+
+    def test_absent_custom_plugin_is_not_silently_skipped(self):
+        tasks = copy.deepcopy(AUTO)
+        tasks['post'].append('nonexistent_safety_check')
+        self.assertRaises(exception.HostRecoveryFailureException,
+                          self.build, False, tasks)
+
+    def test_duplicate_installed_fencing_entry_points_are_rejected(self):
+        entries = list(metadata.entry_points(group='masakari.task_flow.tasks'))
+        entries.append(next(e for e in entries if e.name == 'ironic_fence'))
+        original = base.named.NamedExtensionManager.list_entry_points
+
+        def listed(manager):
+            return (entries if manager.namespace == 'masakari.task_flow.tasks'
+                    else original(manager))
+
+        with mock.patch.object(base.named.NamedExtensionManager,
+                               'list_entry_points', listed):
+            self.assertRaises(exception.HostRecoveryFailureException,
+                              self.build)
+
+    def test_reserved_host_evacuation_cannot_leave_retry_stage(self):
+        for stage in ('pre', 'post'):
+            tasks = copy.deepcopy(RH)
+            tasks[stage].extend(tasks['main'])
+            tasks['main'] = []
+            self.assertRaises(exception.HostRecoveryFailureException,
+                              self.build, True, tasks)
+
+    def test_fence_entry_point_must_construct_the_fencing_task(self):
+        original = metadata.EntryPoint.load
+
+        class UnrelatedTask(taskflow_task.Task):
+            def execute(self):
+                pass
+
+        for obj in (linear_flow.Flow('empty-fence'), UnrelatedTask()):
+            def load(entry):
+                return ((lambda **kwargs: obj) if entry.name == 'ironic_fence'
+                        else original(entry))
+
+            with mock.patch.object(metadata.EntryPoint, 'load', load):
+                self.assertRaises(exception.HostRecoveryFailureException,
+                                  self.build)
+
+    def test_real_taskflow_executes_disable_fence_prepare_evacuate(self):
+        for reserved in (False, True):
+            events = []
+
+            def record(name):
+                def execute(*args, **kwargs):
+                    events.append(name)
+                return execute
+
+            with mock.patch.object(host_failure.DisableComputeServiceTask,
+                                   'execute', record('disable')), \
+                    mock.patch.object(powerops.IronicFenceTask,
+                                      'execute', record('fence')), \
+                    mock.patch.object(
+                        host_failure.PrepareHAEnabledInstancesTask,
+                        'execute', record('prepare')), \
+                    mock.patch.object(host_failure.EvacuateInstancesTask,
+                                      'execute', record('evacuate')):
+                engine = self.build(reserved)
+                engine.run()
+            self.assertEqual(['disable', 'fence', 'prepare', 'evacuate'],
+                             events)
+            self.assertEqual('SUCCESS', engine.storage.get_flow_state())
+
+    def test_both_priority_fallbacks_refuse_broken_fence(self):
+        self.build(False)
+        self.build(True)
+        original = metadata.EntryPoint.load
+
+        def load(entry):
+            if entry.name == 'ironic_fence':
+                raise ImportError('simulated missing fencing dependency')
+            return original(entry)
+
+        recovery = driver.TaskFlowDriver()
+        with mock.patch.object(metadata.EntryPoint, 'load', load), \
+                mock.patch.object(base, 'PERSISTENCE_BACKEND', None), \
+                mock.patch.object(host_failure.DisableComputeServiceTask,
+                                  'execute') as disable, \
+                mock.patch.object(host_failure.EvacuateInstancesTask,
+                                  'execute') as evacuate:
+            for run in (recovery._execute_auto_priority_workflow,
+                        recovery._execute_rh_priority_workflow):
+                self.assertRaises(
+                    exception.HostRecoveryFailureException, run, None, None,
+                    {'host_name': 'source.example',
+                     'notification_uuid': 'offline'},
+                    powerops_coordinator=self.coordinator,
+                    reserved_host_list=['destination.example'],
+                    update_host_method=None)
+            disable.assert_not_called()
+            evacuate.assert_not_called()
+
