             log=logger, fail_formatter=SpecialFormatter(engine))
 
 
-def get_recovery_flow(task_list, **kwargs):
+def validate_powerops_host_flow(task_dict, reserved_host=False):
+    """Reject unsafe host flows before constructing any executable engine.
+
+    The fence belongs in pre, outside the reserved-host retry loop. Extra
+    tasks remain supported, but every configured task must load successfully.
+    """
+    required = ['disable_compute_service_task', 'ironic_fence',
+                'prepare_HA_enabled_instances_task', 'evacuate_instances_task']
+    if (not isinstance(task_dict, dict) or
+            set(task_dict) != {'pre', 'main', 'post'} or
+            any(not isinstance(tasks, list) for tasks in task_dict.values())):
+        raise exception.HostRecoveryFailureException(
+            message='Invalid PowerOps host recovery stages')
+    names = [name for stage in ('pre', 'main', 'post')
+             for name in task_dict[stage]]
+    if (any(not isinstance(name, str) or not name for name in names) or
+            len(names) != len(set(names)) or
+            [name for name in names if name in required] != required or
+            any(name not in task_dict['pre'] for name in required[:2])):
+        raise exception.HostRecoveryFailureException(
+            message='PowerOps requires unique ordered disable, fence, prepare '
+                    'and evacuate tasks, with disable and fence in pre')
+    if reserved_host and any(name not in task_dict['main']
+                             for name in required[2:]):
+        raise exception.HostRecoveryFailureException(
+            message='PowerOps reserved-host prepare and evacuate tasks must '
+                    'remain in the main retry stage')
+
+
+def get_recovery_flow(task_list, strict=False, **kwargs):
     """This is used create extension object from provided task_list.
 
     This method returns the extension object of the each task provided
     in a list using stevedore extension manager.
     """
+    def fail_load(manager, entrypoint, error):
+        raise exception.HostRecoveryFailureException(
+            message='Cannot load recovery task %s (%s)' %
+                    (entrypoint.name, type(error).__name__)) from error
+
     extensions = named.NamedExtensionManager(
         'masakari.task_flow.tasks', names=task_list,
-        name_order=True, invoke_on_load=True, invoke_kwds=kwargs)
-    for extension in extensions.extensions:
+        name_order=not strict, invoke_on_load=True, invoke_kwds=kwargs,
+        on_load_failure_callback=fail_load if strict else None)
+    loaded = extensions.extensions
+    if strict:
+        # Stevedore's name_order mode hides duplicate installed entry points.
+        # Validate the full loaded set first, then restore configured order.
+        if (sorted(ext.name for ext in loaded) != sorted(task_list) or
+                len(task_list) != len(set(task_list))):
+            raise exception.HostRecoveryFailureException(
+                message='Missing or duplicate recovery task plugins')
+        by_name = {ext.name: ext for ext in loaded}
+        # Import after loading the plugins to avoid a module import cycle.
+        from masakari.engine.drivers.taskflow import host_failure
+        from masakari.engine.drivers.taskflow import powerops
+        required_types = {
+            'disable_compute_service_task':
+                host_failure.DisableComputeServiceTask,
+            'ironic_fence': powerops.IronicFenceTask,
+            'prepare_HA_enabled_instances_task':
+                host_failure.PrepareHAEnabledInstancesTask,
+            'evacuate_instances_task': host_failure.EvacuateInstancesTask,
+        }
+        for ext in loaded:
+            expected_type = required_types.get(ext.name, task.Task)
+            if not isinstance(ext.obj, expected_type):
+                raise exception.HostRecoveryFailureException(
+                    message='Recovery plugin %s constructed an unexpected '
+                            'task type' % ext.name)
+        loaded = [by_name[name] for name in task_list]
+    for extension in loaded:
         yield extension.obj
 
 
