+class EvacuationConfirmationTest(test.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.override_config('enabled', True, 'powerops')
+        self.nova = mock.Mock()
+        self.coordinator = SimpleNamespace(assert_healthy=mock.Mock())
+        self.task = host_failure.EvacuateInstancesTask(
+            None, self.nova, update_host_method=None,
+            powerops_coordinator=self.coordinator)
+
+    def server(self, host='source.example', state='active', task_state=None):
+        return SimpleNamespace(id='vm-1', locked=True, **{
+            'OS-EXT-SRV-ATTR:host': host,
+            'OS-EXT-SRV-ATTR:hypervisor_hostname': 'different-hypervisor-name',
+            'OS-EXT-STS:vm_state': state,
+            'OS-EXT-STS:task_state': task_state})
+
+    def evacuate(self, observation, initial=None, final=None, target=None):
+        initial = initial or self.server()
+        self.nova.get_server.side_effect = [initial, initial, observation,
+                                            final or observation]
+        vmove = SimpleNamespace(
+            instance_uuid='vm-1', source_host='source.example',
+            status='pending', dest_host=None, save=lambda: None)
+        with mock.patch.object(host_failure.loopingcall,
+                               'FixedIntervalWithTimeoutLoopingCall',
+                               OneObservationTimer):
+            self.task._evacuate_and_confirm(None, vmove, target)
+        return vmove
+
+    def test_different_hypervisor_name_on_same_nova_host_is_not_success(self):
+        result = self.evacuate(self.server())
+        self.assertEqual('failed', result.status)
+        self.assertIsNone(result.dest_host)
+
+    def test_missing_or_empty_nova_host_is_not_success(self):
+        for host in (None, '', '  ', 42):
+            with self.subTest(host=host):
+                self.assertEqual('failed',
+                                 self.evacuate(self.server(host)).status)
+        observation = self.server()
+        delattr(observation, 'OS-EXT-SRV-ATTR:host')
+        self.assertEqual('failed', self.evacuate(observation).status)
+
+    def test_pending_or_missing_task_state_is_not_success(self):
+        for task_state in ('rebuilding', 'spawning'):
+            observation = self.server('destination.example',
+                                      task_state=task_state)
+            self.assertEqual('failed', self.evacuate(observation).status)
+        observation = self.server('destination.example')
+        delattr(observation, 'OS-EXT-STS:task_state')
+        self.assertEqual('failed', self.evacuate(observation).status)
+
+    def test_destination_still_in_error_is_not_success(self):
+        self.assertEqual('failed', self.evacuate(
+            self.server('destination.example', state='error'),
+            initial=self.server(state='error')).status)
+
+    def test_changed_nova_host_records_canonical_destination(self):
+        for state in ('active', 'stopped'):
+            result = self.evacuate(self.server('destination.example', state),
+                                   initial=self.server(state=state))
+            self.assertEqual('succeeded', result.status)
+            self.assertEqual('destination.example', result.dest_host)
+
+    def test_reserved_destination_must_match(self):
+        result = self.evacuate(self.server('unexpected.example'),
+                               target='reserved.example')
+        self.assertEqual('failed', result.status)
+
+    def test_final_read_must_not_contradict_confirmation(self):
+        for final in (self.server(), self.server('third.example'),
+                      self.server('destination.example',
+                                  task_state='rebuilding'),
+                      self.server('destination.example', state='error')):
+            self.assertEqual('failed', self.evacuate(
+                self.server('destination.example'), final=final).status)
+
+    def test_ownership_error_before_timer_is_preserved(self):
+        error = RuntimeError('ownership lost')
+        self.coordinator.assert_healthy.side_effect = error
+        actual = self.assertRaises(
+            RuntimeError, self.task._stop_after_evacuation,
+            None, self.server())
+        self.assertIs(error, actual)
+        self.nova.stop_server.assert_not_called()
+
+    def test_stop_api_error_before_timer_is_preserved(self):
+        error = RuntimeError('stop API failed')
+        self.nova.stop_server.side_effect = error
+        actual = self.assertRaises(
+            RuntimeError, self.task._stop_after_evacuation,
+            None, self.server())
+        self.assertIs(error, actual)
