index 0000000..e23dc2c
--- /dev/null
+++ b/masakari/cmd/powerops_check.py
@@ -0,0 +1,114 @@
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+# http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Offline image/config gate; never executes recovery tasks or opens clients.
+
+python -m masakari.cmd.powerops_check [--config-file PATH]
+Without a config, use an explicit synthetic PowerOps flow. With a config,
+validate the deployed flow without filling missing fencing stages for it.
+"""
+
+import argparse
+import hashlib
+import importlib.metadata as metadata
+from pathlib import Path
+import signal
+import sys
+from unittest import mock
+
+from oslo_serialization import jsonutils
+
+
+CHECK_TIMEOUT_SECONDS = 50
+
+
+def check():
+    from masakari import conf
+    from masakari.engine.drivers.taskflow import base
+    from masakari.engine.drivers.taskflow import host_failure
+    from masakari import exception
+
+    if not conf.CONF.powerops.enabled:
+        raise exception.HostRecoveryFailureException(
+            message='PowerOps is not enabled in checked configuration')
+    # Even when a deployed config enables TaskFlow persistence, this check
+    # constructs only an in-memory engine. No DB/RPC/client setup is called.
+    with mock.patch.object(base, 'PERSISTENCE_BACKEND', None):
+        for build in (host_failure.get_auto_flow, host_failure.get_rh_flow):
+            kwargs = ({'update_host_method': None}
+                      if build is host_failure.get_rh_flow else {})
+            engine = build(None, None, {
+                'host_name': 'offline-source', 'notification_uuid': 'offline',
+                'reserved_host_list': ['offline-destination']}, **kwargs)
+            engine.compile()
+            engine.prepare()
+            engine.validate()
+
+    root = Path(__file__).resolve().parents[1]
+    paths = [root / 'engine/drivers/taskflow' / name for name in
+             ('base.py', 'driver.py', 'host_failure.py', 'powerops.py')]
+    paths.extend((root / 'powerops').glob('*.py'))
+    paths.append(Path(__file__).resolve())
+    return {
+        'result': 'ok', 'flows': ['auto', 'reserved_host'],
+        'sha256': {'masakari/' + str(path.relative_to(root)):
+                   hashlib.sha256(path.read_bytes()).hexdigest()
+                   for path in sorted(paths)},
+        'versions': {name: metadata.version(name) for name in
+                     ('masakari', 'openstacksdk', 'python-novaclient',
+                      'keystoneauth1', 'tooz', 'etcd3gw', 'taskflow',
+                      'stevedore')},
+        'python': sys.version.split()[0],
+    }
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--config-file')
+    args = parser.parse_args(argv)
+    # Killing a host-side podman/docker exec does not reliably kill its
+    # process inside a running engine container. Enforce a POSIX deadline
+    # in this disposable checker process, even for a hung native import.
+    previous_handler = signal.signal(signal.SIGALRM, signal.SIG_DFL)
+    signal.alarm(CHECK_TIMEOUT_SECONDS)
+    try:
+        from masakari import conf
+        # Do not call config.parse_args: it initializes RPC/SQLAlchemy.
+        conf.CONF([], project='masakari',
+                  default_config_files=[args.config_file]
+                  if args.config_file else [])
+        if not args.config_file:
+            conf.CONF.set_override('enabled', True, 'powerops')
+            for kind in ('auto', 'rh'):
+                tasks = {
+                    'pre': ['disable_compute_service_task', 'ironic_fence'],
+                    'main': ['prepare_HA_enabled_instances_task'],
+                    'post': ['evacuate_instances_task']}
+                if kind == 'rh':
+                    tasks['main'].extend(tasks['post'])
+                    tasks['post'] = []
+                conf.CONF.set_override('host_%s_failure_recovery_tasks' % kind,
+                                       tasks, 'taskflow_driver_recovery_flows')
+        result = check()
+    except Exception as exc:
+        # Avoid printing config values, credentials or arbitrary plugin errors.
+        print(jsonutils.dumps({'result': 'failed',
+                               'error_type': type(exc).__name__}))
+        return 1
+    finally:
+        signal.alarm(0)
+        signal.signal(signal.SIGALRM, previous_handler)
+    print(jsonutils.dumps(result, sort_keys=True))
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
