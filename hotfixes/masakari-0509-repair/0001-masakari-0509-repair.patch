+# limitations under the License.
+
+import importlib
+import importlib.metadata as metadata
+from pathlib import Path
+import signal
+import socket
+import subprocess
+import sys
+import tempfile
+from unittest import mock
+
+from masakari.engine.drivers.taskflow import base
+from masakari import exception
+from masakari import rpc
+from masakari import test
+from masakari.tests.unit.engine.drivers.taskflow import test_powerops_repair
+
+
+class PowerOpsCheckTest(test.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.checker = importlib.import_module('masakari.cmd.powerops_check')
+        self.override_config('enabled', True, 'powerops')
+        for kind, tasks in (('auto', test_powerops_repair.AUTO),
+                            ('rh', test_powerops_repair.RH)):
+            self.override_config('host_%s_failure_recovery_tasks' % kind,
+                                 tasks, 'taskflow_driver_recovery_flows')
+
+    def test_real_plugins_and_flows_compile_without_network(self):
+        with mock.patch.object(
+                socket.socket, 'connect',
+                side_effect=AssertionError('network forbidden')), \
+                mock.patch.object(base, 'PERSISTENCE_BACKEND',
+                                  'sqlite:////offline-forbidden.db'), \
+                mock.patch.object(
+                    base.backends, 'fetch',
+                    side_effect=AssertionError('DB forbidden')), \
+                mock.patch.object(rpc, 'init',
+                                  side_effect=AssertionError('RPC forbidden')):
+            report = self.checker.check()
+        self.assertEqual('ok', report['result'])
+        self.assertEqual(['auto', 'reserved_host'], report['flows'])
+        self.assertIn('masakari/engine/drivers/taskflow/host_failure.py',
+                      report['sha256'])
+
+    def test_broken_import_is_not_accepted_by_metadata_check(self):
+        original = metadata.EntryPoint.load
+
+        def broken(entry):
+            if entry.name == 'ironic_fence':
+                raise ImportError('offline missing SDK')
+            return original(entry)
+
+        with mock.patch.object(metadata.EntryPoint, 'load', broken):
+            self.assertRaises(exception.HostRecoveryFailureException,
+                              self.checker.check)
+
+    def test_disabled_powerops_and_unsafe_config_fail(self):
+        self.override_config('enabled', False, 'powerops')
+        self.assertRaises(exception.HostRecoveryFailureException,
+                          self.checker.check)
+        self.override_config('enabled', True, 'powerops')
+        self.override_config('host_rh_failure_recovery_tasks',
+                             {'pre': [], 'main': [], 'post': []},
+                             'taskflow_driver_recovery_flows')
+        self.assertRaises(exception.HostRecoveryFailureException,
+                          self.checker.check)
+
+    def test_cli_checks_deployed_config_without_filling_missing_fencing(self):
+        common = '[powerops]\nenabled = true\n[taskflow]\nconnection = ' \
+                 'sqlite:////offline-must-not-be-opened.db\n' \
+                 '[taskflow_driver_recovery_flows]\n'
+        valid = common + (
+            "host_auto_failure_recovery_tasks = "
+            "pre:['disable_compute_service_task',"
+            "'ironic_fence'],main:['prepare_HA_enabled_instances_task'],"
+            "post:['evacuate_instances_task']\n"
+            "host_rh_failure_recovery_tasks = "
+            "pre:['disable_compute_service_task',"
+            "'ironic_fence'],main:['prepare_HA_enabled_instances_task',"
+            "'evacuate_instances_task'],post:[]\n")
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'masakari.conf'
+            for content, expected in ((valid, 0), (common, 1),
+                                      ('[powerops]\nenabled = false\n', 1)):
+                path.write_text(content)
+                result = subprocess.run(
+                    [sys.executable, '-B', '-m', 'masakari.cmd.powerops_check',
+                     '--config-file', str(path)],
+                    capture_output=True, text=True, timeout=30)
+                self.assertEqual(expected, result.returncode, result.stdout)
+                self.assertIn('"result": "ok"' if expected == 0 else
+                              '"result": "failed"', result.stdout)
+
+    def test_cli_kills_its_own_hung_process_without_container_cli_help(self):
+        code = ('import sys, time; '
+                'from masakari.cmd import powerops_check as c; '
+                'c.CHECK_TIMEOUT_SECONDS = 1; '
+                'c.check = lambda: time.sleep(60); sys.exit(c.main([]))')
+        result = subprocess.run([sys.executable, '-B', '-c', code],
+                                capture_output=True, text=True, timeout=5)
+        self.assertEqual(-signal.SIGALRM, result.returncode)
