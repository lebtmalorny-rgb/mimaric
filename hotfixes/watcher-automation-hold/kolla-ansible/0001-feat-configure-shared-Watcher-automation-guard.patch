diff --git a/ansible/roles/watcher-automation-guard/tasks/main.yml b/ansible/roles/watcher-automation-guard/tasks/main.yml
new file mode 100644
index 0000000000000000000000000000000000000000..96cef25a919255db67d798fd2add3ce383b2fbd1
--- /dev/null
+++ b/ansible/roles/watcher-automation-guard/tasks/main.yml
@@ -0,0 +1,64 @@
+---
+- name: Validate Watcher automation guard dependencies
+  ansible.builtin.assert:
+    that:
+      - enable_watcher | bool
+      - enable_masakari | bool
+      - enable_powerops | bool
+      - >-
+        enable_etcd | bool or
+        watcher_automation_guard_endpoint !=
+        watcher_automation_guard_default_endpoint
+      - watcher_automation_guard_endpoint is string
+      - >-
+        watcher_automation_guard_endpoint |
+        regex_search(
+          '^https?://(?:\[[0-9A-Fa-f:]+\]|[^\s:/?#]+):[0-9]+$'
+        ) is not none
+      - watcher_automation_guard_prefix is string
+      - >-
+        watcher_automation_guard_prefix |
+        regex_search(
+          '^/[^\s/](?:[^\s]*[^/])?$'
+        ) is not none
+      - watcher_automation_guard_prefix | regex_search('//') is none
+      - >-
+        watcher_automation_guard_prefix |
+        regex_search('(?:^|/)\.\.?($|/)') is none
+      - watcher_automation_guard_timeout is number
+      - watcher_automation_guard_timeout | float > 0
+      - watcher_automation_guard_ca_file is string
+      - watcher_automation_guard_cert_file is string
+      - watcher_automation_guard_key_file is string
+      - powerops_masakari_api_image is string
+      - powerops_masakari_api_image | trim | length > 0
+      - powerops_masakari_api_tag is string
+      - powerops_masakari_api_tag | trim | length > 0
+      - >-
+        (watcher_automation_guard_cert_file | length > 0) ==
+        (watcher_automation_guard_key_file | length > 0)
+      - >-
+        watcher_automation_guard_ca_file | length == 0 or
+        watcher_automation_guard_ca_file |
+        regex_search(
+          '^/(?:etc/pki|etc/ssl|var/lib/kolla/share/ca-certificates)/(?!.*\.\.)[^\s]+$'
+        ) is not none
+      - >-
+        watcher_automation_guard_cert_file | length == 0 or
+        watcher_automation_guard_cert_file |
+        regex_search(
+          '^/(?:etc/pki|etc/ssl|var/lib/kolla/share/ca-certificates)/(?!.*\.\.)[^\s]+$'
+        ) is not none
+      - >-
+        watcher_automation_guard_key_file | length == 0 or
+        watcher_automation_guard_key_file |
+        regex_search(
+          '^/(?:etc/pki|etc/ssl|var/lib/kolla/share/ca-certificates)/(?!.*\.\.)[^\s]+$'
+        ) is not none
+    fail_msg: >-
+      The Watcher automation guard requires Watcher, Masakari and PowerOps,
+      Kolla etcd or an explicit HTTP(S) etcd v3 endpoint, and valid shared
+      container TLS paths. Optional client certificate and key files must be
+      preprovisioned in every patched Masakari API/engine and Watcher image.
+      A non-empty patched Masakari API image and tag are mandatory.
+  when: watcher_automation_guard_enabled | bool
