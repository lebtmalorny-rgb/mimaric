+
+class TestGuardContract(unittest.TestCase):
+    def setUp(self):
+        self.epoch = str(uuid.uuid4())
+        conf.CONF.set_override('enabled', True,
+                               group='watcher_automation_guard')
+        self.addCleanup(conf.CONF.clear_override, 'enabled',
+                        group='watcher_automation_guard')
+        patcher = mock.patch.object(Gate, 'admit', return_value=self.epoch)
+        patcher.start()
+        self.addCleanup(patcher.stop)
+
+    def test_background_old_build_cannot_overwrite_resumed_snapshot(self):
+        collector = nova.NovaClusterDataModelCollector(mock.Mock())
+        old_started = threading.Event()
+        release_old = threading.Event()
+        calls = []
+        old = model_root.ModelRoot()
+        old.marker = 'old'
+        fresh = model_root.ModelRoot()
+        fresh.marker = 'fresh'
+
+        def build():
+            calls.append(True)
+            if len(calls) == 1:
+                old_started.set()
+                if not release_old.wait(5):
+                    raise RuntimeError('test timeout')
+                return old
+            return fresh
+
+        with mock.patch.object(collector, 'execute', side_effect=build):
+            with futures.ThreadPoolExecutor(2) as pool:
+                background = pool.submit(collector.synchronize)
+                self.assertTrue(old_started.wait(5))
+                # Prove the entire old build holds the SAME snapshot lock;
+                # this avoids relying on worker timing for the regression.
+                acquired = collector.lock.acquire(blocking=False)
+                if acquired:
+                    collector.lock.release()
+                    release_old.set()
+                self.assertFalse(acquired)
+                resumed = pool.submit(automation_guard.fresh_model,
+                                      collector, self.epoch)
+                release_old.set()
+                background.result(timeout=5)
+                self.assertEqual('fresh', resumed.result(timeout=5).marker)
+            self.assertEqual('fresh', collector.cluster_data_model.marker)
+            self.assertEqual(2, len(calls))
+
+    def test_object_backport_drops_private_epoch(self):
+        plan = objects.ActionPlan(automation_epoch=self.epoch)
+        primitive = plan.obj_to_primitive(target_version='2.2')
+        self.assertNotIn('automation_epoch', primitive['watcher_object.data'])
+        current = objects.ActionPlan.obj_from_primitive(
+            plan.obj_to_primitive())
+        self.assertEqual(self.epoch, current.automation_epoch)
+
+    def test_alembic_preserves_legacy_null_and_new_epoch(self):
+        revision = importlib.import_module(
+            'watcher.db.sqlalchemy.alembic.versions.'
+            'a91c3f82d047_add_automation_epoch')
+        self.assertEqual('609bec748f2a', revision.down_revision)
+        engine = sa.create_engine('sqlite://')
+        self.addCleanup(engine.dispose)
+        with engine.begin() as conn:
+            conn.exec_driver_sql(
+                'CREATE TABLE action_plans (id INTEGER PRIMARY KEY)')
+            conn.exec_driver_sql('INSERT INTO action_plans (id) VALUES (1)')
+            context = migration.MigrationContext.configure(conn)
+            with operations.Operations.context(context):
+                revision.upgrade()
+                self.assertIsNone(conn.exec_driver_sql(
+                    'SELECT automation_epoch FROM action_plans '
+                    'WHERE id=1').scalar())
+                conn.execute(sa.text(
+                    'INSERT INTO action_plans (id, automation_epoch) '
+                    'VALUES (2, :epoch)'),
+                    {'epoch': self.epoch})
+                self.assertEqual(self.epoch, conn.exec_driver_sql(
+                    'SELECT automation_epoch FROM action_plans '
+                    'WHERE id=2').scalar())
+                revision.downgrade()
+                columns = sa.inspect(conn).get_columns('action_plans')
+                self.assertEqual(['id'], [c['name'] for c in columns])
+
+    def test_sample_discovers_shared_group(self):
+        groups = dict(opts.list_opts())
+        self.assertIn('watcher_automation_guard', groups)
+        options = {option.name: option
+                   for option in groups['watcher_automation_guard']}
+        self.assertFalse(options['enabled'].default)
+
+    def test_rest_rejects_private_provenance_patch(self):
+        from watcher.api.controllers.v1 import action_plan
+        import wsme
+        for operation in ('add', 'replace', 'remove'):
+            patch = action_plan.ActionPlanPatchType(
+                path='/automation_epoch', op=operation, value='manual')
+            self.assertRaises(wsme.exc.ClientSideError,
+                              action_plan.ActionPlanPatchType.validate, patch)
+
+    def test_custom_legacy_planner_fails_before_side_effect(self):
+        class Planner:
+            called = False
+
+            def schedule(self, context, audit_id, solution):
+                self.called = True
+
+        planner = Planner()
+        self.assertRaises(automation_guard.GuardDenied,
+                          automation_guard.schedule, planner, None, 1,
+                          None, self.epoch)
+        self.assertFalse(planner.called)
+
+    def test_custom_planner_cannot_discard_provenance(self):
+        class Planner:
+            def schedule(self, context, audit_id, solution,
+                         automation_epoch=None):
+                return objects.ActionPlan(automation_epoch=None)
+
+        self.assertRaises(automation_guard.GuardDenied,
+                          automation_guard.schedule, Planner(), None, 1,
+                          None, self.epoch)
+
+    def test_failed_initial_model_build_releases_collector_lock(self):
+        collector = nova.NovaClusterDataModelCollector(mock.Mock())
+        collector._cluster_data_model = None
+        lock = threading.RLock()
+
+        def can_acquire():
+            acquired = lock.acquire(blocking=False)
+            if acquired:
+                lock.release()
+            return acquired
+
+        with mock.patch.object(collector, 'lock', lock), \
+                mock.patch.object(collector, 'execute',
+                                  side_effect=RuntimeError('unavailable')):
+            self.assertRaises(RuntimeError,
+                              collector.get_latest_cluster_data_model)
+            try:
+                with futures.ThreadPoolExecutor(1) as pool:
+                    self.assertTrue(pool.submit(can_acquire).result(timeout=5))
+            finally:
+                # Clean up the baseline's leaked recursive lock after RED.
+                while lock._is_owned():
+                    lock.release()
+
+    def test_old_rpc_object_is_guard_denied(self):
+        plan = objects.ActionPlan()
+        self.assertRaises(automation_guard.GuardDenied,
+                          automation_guard.validate_plan, plan)
