+from watcher import objects
+from watcher.tests.db import base
+from watcher.tests.objects import utils
+
+
+class TestAutomationGuard(base.DbTestCase):
+    def setUp(self):
+        super().setUp()
+        guard_config.register_opts(cfg.CONF)
+        self.config(enabled=True, group='watcher_automation_guard')
+        self.epoch = str(uuid.uuid4())
+        self.blocked = False
+        self.gate = self.patch(Gate, 'admit', side_effect=self.admit)
+        self.model = model_root.ModelRoot()
+        self.build = self.patch(nova.NovaClusterDataModelCollector, 'execute',
+                                return_value=self.model)
+        self.goal = utils.create_test_goal(self.context, name='dummy')
+        self.strategy = utils.create_test_strategy(self.context, name='dummy',
+                                                   goal_id=self.goal.id)
+        self.audit = utils.create_test_audit(
+            self.context, goal_id=self.goal.id, strategy_id=self.strategy.id,
+            audit_type='CONTINUOUS', hostname=cfg.CONF.host,
+            next_run_time=timeutils.utcnow(), auto_trigger=True)
+        self.rpc = self.patch(
+            continuous.ContinuousAuditHandler().applier_client,
+            'launch_action_plan')
+
+    def patch(self, obj, name, **kwargs):
+        patcher = mock.patch.object(obj, name, **kwargs)
+        value = patcher.start()
+        self.addCleanup(patcher.stop)
+        return value
+
+    def admit(self, expected_epoch=None):
+        if self.blocked or (expected_epoch and expected_epoch != self.epoch):
+            raise GuardDenied('blocked or stale')
+        return self.epoch
+
+    def plans(self):
+        return objects.ActionPlan.list(self.context)
+
+    def tick(self):
+        continuous.ContinuousAuditHandler.execute_audit(
+            self.audit, self.context)
+        self.audit.refresh()
+
+    def test_blocked_tick_preserves_state_and_advances_time(self):
+        before = self.audit.next_run_time
+        self.blocked = True
+        self.tick()
+        self.assertEqual('PENDING', self.audit.state)
+        self.assertGreater(self.audit.next_run_time, before)
+        self.assertEqual([], self.plans())
+        self.assertEqual(0, self.build.call_count)
+        self.rpc.assert_not_called()
+
+    def test_scheduled_plan_roundtrip_and_manual_provenance(self):
+        self.tick()
+        self.assertEqual(self.epoch, self.plans()[0].automation_epoch)
+        plan = self.plans()[0]
+        self.audit.audit_type = 'ONESHOT'
+        self.audit.save()
+        self.blocked = True
+        self.run_plan(plan)
