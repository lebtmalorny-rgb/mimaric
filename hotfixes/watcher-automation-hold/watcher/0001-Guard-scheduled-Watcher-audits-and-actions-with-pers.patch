+    def test_running_migration_finishes_next_migration_is_blocked(self):
+        from watcher.common import nova_helper
+        plan = utils.create_test_action_plan(
+            self.context, state='RECOMMENDED', automation_epoch=self.epoch)
+        parameters = {'migration_type': 'live', 'source_node': 'source',
+                      'destination_node': 'destination',
+                      'resource_id': str(uuid.uuid4())}
+        first = utils.create_test_action(
+            self.context, uuid=str(uuid.uuid4()), action_plan_id=plan.id,
+            action_type='migrate', input_parameters=parameters,
+            state='PENDING', parents=[])
+        second = utils.create_test_action(
+            self.context, uuid=str(uuid.uuid4()), action_plan_id=plan.id,
+            action_type='migrate', input_parameters=parameters,
+            state='PENDING', parents=[first.uuid])
+        self.config(rollback_when_actionplan_failed=True,
+                    group='watcher_applier')
+
+        def migrate(**kwargs):
+            self.blocked = True
+            return True
+
+        with mock.patch.object(nova_helper.NovaHelper, 'find_instance',
+                               return_value=object()), \
+                mock.patch.object(nova_helper.NovaHelper,
+                                  'live_migrate_instance',
+                                  side_effect=migrate) as migrations, \
+                mock.patch.object(nova_helper.NovaHelper,
+                                  'abort_live_migrate') as abort:
+            plan_handler.DefaultActionPlanHandler(
+                self.context, mock.Mock(), plan.uuid).execute()
+            first.refresh()
+            second.refresh()
+            plan.refresh()
+            self.assertEqual('SUCCEEDED', first.state)
+            self.assertEqual('FAILED', second.state)
+            self.assertEqual('FAILED', plan.state)
+            # Explicitly exercise TaskFlow's rollback wrapper as well: default
+            # upstream swallows task errors and may not request a revert.
