+from unittest import mock
+
+from masakari.powerops import watcher_automation
+from masakari import test
+from masakari.tests.unit import fakes
+from masakari.tests import uuidsentinel
+
+
+class WatcherAutomationHoldTest(test.NoDBTestCase):
+
+    @staticmethod
+    def _notification(notification_type='COMPUTE_HOST', event='STOPPED',
+                      host_status='NORMAL'):
+        return fakes.create_fake_notification(
+            type=notification_type,
+            payload={
+                'event': event,
+                'host_status': host_status,
+                'cluster_status': 'ONLINE',
+            },
+            notification_uuid=uuidsentinel.fake_notification,
+        )
+
+    @mock.patch.object(watcher_automation.config, 'from_conf')
+    def test_eligible_host_failure_holds_with_notification_identity(
+            self, mock_from_conf):
+        conf = mock.Mock()
+        conf.watcher_automation_guard.enabled = True
+        gate = mock_from_conf.return_value
+
+        with mock.patch.object(watcher_automation, 'CONF', conf):
+            result = watcher_automation.hold(
+                self._notification(event='stopped', host_status='normal'),
+                'compute-01',
+            )
+
+        self.assertIs(gate.hold.return_value, result)
+        mock_from_conf.assert_called_once_with(conf)
+        gate.hold.assert_called_once_with(
+            uuidsentinel.fake_notification,
+            'compute-01',
+        )
+
+    @mock.patch.object(watcher_automation.config, 'from_conf')
+    def test_disabled_guard_does_not_contact_backend(self, mock_from_conf):
+        conf = mock.Mock()
+        conf.watcher_automation_guard.enabled = False
+
+        with mock.patch.object(watcher_automation, 'CONF', conf):
+            result = watcher_automation.hold(
+                self._notification(), 'compute-01')
+
+        self.assertIsNone(result)
+        mock_from_conf.assert_not_called()
+
+    @mock.patch.object(watcher_automation.config, 'from_conf')
+    def test_ineligible_notification_does_not_contact_backend(
+            self, mock_from_conf):
+        conf = mock.Mock()
+        conf.watcher_automation_guard.enabled = True
+        missing_status = self._notification()
+        missing_status.payload.pop('host_status')
+        cases = (
+            self._notification(notification_type='PROCESS'),
+            self._notification(event='STARTED'),
+            self._notification(event='UNKNOWN'),
+            self._notification(host_status='UNKNOWN'),
+            missing_status,
+        )
+
+        with mock.patch.object(watcher_automation, 'CONF', conf):
+            for notification in cases:
+                with self.subTest(notification=notification):
+                    self.assertIsNone(watcher_automation.hold(
+                        notification, 'compute-01'))
+
+        mock_from_conf.assert_not_called()
+
+    @mock.patch.object(watcher_automation.config, 'from_conf')
+    def test_replayed_notification_reuses_incident_uuid(self, mock_from_conf):
+        conf = mock.Mock()
+        conf.watcher_automation_guard.enabled = True
+        notification = self._notification()
+
+        with mock.patch.object(watcher_automation, 'CONF', conf):
+            watcher_automation.hold(notification, 'compute-01')
+            watcher_automation.hold(notification, 'compute-01')
+
+        self.assertEqual(
+            [mock.call(uuidsentinel.fake_notification, 'compute-01')] * 2,
+            mock_from_conf.return_value.hold.call_args_list,
+        )
