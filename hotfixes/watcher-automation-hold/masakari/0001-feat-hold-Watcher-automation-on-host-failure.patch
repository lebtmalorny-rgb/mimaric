+"""Bridge Masakari host-failure notifications to the automation guard."""
+
+from powerops_watcher_guard import config
+
+import masakari.conf
+from masakari.objects import fields
+
+
+CONF = masakari.conf.CONF
+
+
+def hold(notification, host):
+    """Hold scheduled automation for an eligible host failure."""
+    if not CONF.watcher_automation_guard.enabled:
+        return None
+    if notification.type != fields.NotificationType.COMPUTE_HOST:
+        return None
+
+    event = notification.payload.get('event')
+    host_status = notification.payload.get('host_status')
+    if not isinstance(event, str) or event.upper() != 'STOPPED':
+        return None
+    if not isinstance(host_status, str):
+        return None
+    if host_status.upper() != fields.HostStatusType.NORMAL:
+        return None
+
+    return config.from_conf(CONF).hold(notification.notification_uuid, host)
