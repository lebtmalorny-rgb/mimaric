+        self.assertTrue(all(call.args[0] == 0
+                            for call in sleep.call_args_list))
+
+    def test_short_deadline_caps_sleep_and_starts_after_fencing(self):
+        self.override_config('nova_down_timeout', 3, 'powerops')
+        self.override_config('poll_interval', 10, 'powerops')
+        clock = [0.0]
+
+        def fence(*args):
+            clock[0] += 25
+            return self.fence(*args)
+
+        def sleep(seconds):
+            clock[0] += seconds
+
+        self.ironic.return_value.fence.side_effect = fence
+        self.http.get(SERVICES_URL, json={'services': [service('up')]},
+                      complete_qs=True)
+        with mock.patch.object(time, 'monotonic', lambda: clock[0]), \
+                mock.patch.object(eventlet, 'sleep', sleep):
+            self.assertRaises(exception.HostRecoveryFailureException,
+                              self.run_flow)
+        self.assertEqual([3], self.request_timeouts)
+        self.assertEqual(28, clock[0])
+        self.assertNotIn('evacuate', self.events)
+
+    def test_down_response_arriving_after_deadline_is_rejected(self):
+        self.override_config('nova_down_timeout', 3, 'powerops')
+        clock = [0.0]
+
+        def respond(request, context):
+            clock[0] += 4
+            return {'services': [service()]}
+
+        self.http.get(SERVICES_URL, json=respond, complete_qs=True)
+        with mock.patch.object(time, 'monotonic', lambda: clock[0]):
+            self.assertRaises(exception.HostRecoveryFailureException,
+                              self.run_flow)
+        self.assertNotIn('evacuate', self.events)
+
+    def test_hanging_http_is_interrupted_by_total_timeout(self):
+        self.override_config('nova_down_timeout', 1, 'powerops')
+        completed = patcher.original('threading').Event()
+
+        def respond(request, context):
+            eventlet.sleep(2.2)
+            completed.set()
+            return {'services': [service()]}
+
+        self.http.get(SERVICES_URL, json=respond, complete_qs=True)
+        started = time.monotonic()
+        error = self.assertRaises(exception.HostRecoveryFailureException,
+                                  self.run_flow)
+        self.assertLess(time.monotonic() - started, 5)
+        self.assertIn('Timed out', str(error))
+        self.assertNotIn('evacuate', self.events)
+        cleanup_deadline = time.monotonic() + 3
+        while not completed.is_set() and time.monotonic() < cleanup_deadline:
+            eventlet.sleep(0.01)
+        self.assertTrue(completed.is_set())
+
+    def test_native_blocking_resolver_cannot_hold_recovery_past_deadline(self):
+        self.override_config('nova_down_timeout', 1, 'powerops')
+        native_sleep = patcher.original('time').sleep
+        completed = patcher.original('threading').Event()
+
+        def read_service(*args, **kwargs):
+            # Native DNS does not yield to the engine's eventlet hub.
+            native_sleep(2.2)
+            completed.set()
+            return service()
+
+        self.patch(self.task.novaclient, 'get_compute_service', read_service)
+        started = time.monotonic()
+        try:
+            self.assertRaises(exception.HostRecoveryFailureException,
+                              self.run_flow)
+            self.assertLess(time.monotonic() - started, 1.8)
+            self.assertFalse(completed.is_set())
+            self.assertNotIn('evacuate', self.events)
+        finally:
+            # Do not leak a still-running read into another test's fixtures.
+            cleanup_deadline = time.monotonic() + 3
+            while (not completed.is_set() and
+                   time.monotonic() < cleanup_deadline):
+                eventlet.sleep(0.01)
+
+    def test_initial_progress_notification_is_inside_total_timeout(self):
+        self.override_config('nova_down_timeout', 1, 'powerops')
+
+        def notify(*args):
+            eventlet.sleep(2.2)
+
+        self.patch(self.task, 'update_details', notify)
+        started = time.monotonic()
+        self.assertRaises(exception.HostRecoveryFailureException,
+                          self.run_flow)
+        self.assertLess(time.monotonic() - started, 1.8)
+        self.assertEqual([], self.http.request_history)
+
+    def test_real_client_native_dns_cannot_block_recovery_hub(self):
+        self.override_config('nova_down_timeout', 1, 'powerops')
+        self.http.stop()
+        native_sleep = patcher.original('time').sleep
+        completed = patcher.original('threading').Event()
+
+        def resolve(*args, **kwargs):
+            try:
+                native_sleep(2.2)
+                raise socket.gaierror('simulated DNS failure')
+            finally:
+                completed.set()
+
+        with mock.patch.object(socket, 'getaddrinfo', resolve):
+            started = time.monotonic()
+            try:
+                self.assertRaises(exception.HostRecoveryFailureException,
+                                  self.run_flow)
+                self.assertLess(time.monotonic() - started, 1.8)
+                self.assertFalse(completed.is_set())
+                self.assertNotIn('evacuate', self.events)
+            finally:
+                cleanup_deadline = time.monotonic() + 3
+                while (not completed.is_set() and
