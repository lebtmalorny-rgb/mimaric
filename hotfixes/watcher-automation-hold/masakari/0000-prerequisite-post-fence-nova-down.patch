+                        'host_auto_failure_recovery_tasks', tasks,
+                        'taskflow_driver_recovery_flows')
+
+                    def record(name):
+                        def execute(*args, **kwargs):
+                            self.events.append(name)
+                        return execute
+
+                    with mock.patch.object(
+                            base, 'PERSISTENCE_BACKEND', None), \
+                            mock.patch.object(eventlet, 'sleep'), \
+                            mock.patch.object(
+                                host_failure.DisableComputeServiceTask,
+                                'execute', record('disable')), \
+                            mock.patch.object(
+                                host_failure.PrepareHAEnabledInstancesTask,
+                                'execute', record('prepare')), \
+                            mock.patch.object(
+                                host_failure.EvacuateInstancesTask,
+                                'execute', record('evacuate')):
+                        build = (host_failure.get_rh_flow if reserved else
+                                 host_failure.get_auto_flow)
+                        engine = build(self.ctx, nova.API(), {
+                            'host_name': HOST,
+                            'notification_uuid': 'offline',
+                            'reserved_host_list': ['destination.example'],
+                        }, powerops_coordinator=self.coordinator,
+                            **({'update_host_method': None} if reserved else
+                               {}))
+                        if state == 'error':
+                            self.assertRaises(
+                                exception.HostRecoveryFailureException,
+                                engine.run)
+                        else:
+                            engine.run()
+                    expected = ['disable', 'fence', 'nova-' + state]
+                    if state == 'up':
+                        expected.append('nova-down')
+                    if state != 'error':
+                        expected.extend(['prepare', 'evacuate'])
+                    self.assertEqual(expected, self.events)
