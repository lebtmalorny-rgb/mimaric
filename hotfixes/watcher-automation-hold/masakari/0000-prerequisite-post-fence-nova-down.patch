+
+
+HOST = 'source.example'
+ENDPOINT = 'http://nova.test/v2.1'
+SERVICES_URL = ENDPOINT + '/os-services?host=' + HOST + '&binary=nova-compute'
+
+
+def service(state='down', status='disabled', **updates):
+    result = dict(id='5ccc9327-89c0-443f-8887-6f7b06be858b', host=HOST,
+                  binary='nova-compute', state=state, status=status,
+                  zone='nova', forced_down=False,
+                  updated_at='2026-09-08T12:38:26.000000',
+                  disabled_reason='Masakari detected host failure')
+    result.update(updates)
+    return result
+
+
+class PostFenceNovaDownTest(test.TestCase):
+    """Keep TaskFlow, the Nova API wrapper and HTTP parsing real."""
+
+    def setUp(self):
+        super().setUp()
+        self.override_config('enabled', True, 'powerops')
+        self.override_config('poll_interval', 1, 'powerops')
+        self.events = []
+        self.request_timeouts = []
+        self.ctx = context.get_admin_context()
+        self.coordinator = fakes.recording_coordinator(self.events)
+        self.fencing_result = {'power_state': 'power off'}
+        self.ironic = mock.Mock()
+        self.patch(powerops.ironic, 'IronicPowerClient', self.ironic)
+        self.patch(powerops.ironic, 'connection_from_conf', mock.Mock())
+        self.ironic.return_value.fence.side_effect = self.fence
+        nova_session = session.Session(auth=token_endpoint.Token(
+            endpoint=ENDPOINT, token='test-token'))
+        self.http_client = client.Client(
+            '2.53', session=nova_session, endpoint_override=ENDPOINT)
+        self.patch(nova, 'novaclient', self.nova_client)
+        self.http = requests_mock.Mocker()
+        self.http.start()
+        self.addCleanup(self.http.stop)
+        self.task = powerops.IronicFenceTask(
+            self.ctx, nova.API(), powerops_coordinator=self.coordinator)
+
+    def nova_client(self, ctx, timeout=None):
+        self.assertIs(self.ctx, ctx)
+        self.assertGreater(timeout, 0)
+        self.request_timeouts.append(timeout)
+        return self.http_client
+
+    def fence(self, host, *args):
+        self.assertEqual(HOST, host)
+        self.events.append('fence')
+        return self.fencing_result
+
+    def run_flow(self):
+        flow = linear_flow.Flow('post-fence-nova-down').add(
+            self.task,
+            taskflow_task.FunctorTask(
+                lambda: self.events.append('evacuate'), name='evacuate'))
+        engines.run(flow, store={'host_name': HOST})
+
+    def test_waits_for_fresh_down_before_downstream_evacuation(self):
+        states = iter(['up', 'up', 'down'])
+
+        def respond(request, context):
+            state = next(states)
+            self.events.append('nova-' + state)
+            return {'services': [service(state)]}
+
+        self.http.get(SERVICES_URL, json=respond, complete_qs=True)
+        with mock.patch.object(eventlet, 'sleep'):
+            self.run_flow()
+
+        self.assertEqual(['fence', 'nova-up', 'nova-up', 'nova-down',
+                          'evacuate'], self.events)
+        self.assertTrue(all(r.method == 'GET'
+                            for r in self.http.request_history))
+
+    def test_missing_or_ambiguous_service_never_allows_evacuation(self):
+        for services in ([], [service(), service()],
+                         [service(host='other.example')],
+                         [service(binary='nova-conductor')]):
+            with self.subTest(services=services):
+                self.events.clear()
+                self.http.get(SERVICES_URL, json={'services': services},
+                              complete_qs=True)
+                self.assertRaises(exception.HostRecoveryFailureException,
+                                  self.run_flow)
+                self.assertNotIn('evacuate', self.events)
+
+    def test_unknown_or_reenabled_service_never_allows_evacuation(self):
+        cases = [service(state=None), service(state='unknown'),
+                 service(status=None), service(status='enabled')]
+        missing_state = service()
+        del missing_state['state']
+        cases.append(missing_state)
+        for item in cases:
+            with self.subTest(service=item):
+                self.events.clear()
+                self.http.get(SERVICES_URL, json={'services': [item]},
+                              complete_qs=True)
+                self.assertRaises(exception.HostRecoveryFailureException,
+                                  self.run_flow)
+                self.assertNotIn('evacuate', self.events)
+
+    def test_failed_fence_never_queries_nova_or_evacuates(self):
+        self.ironic.return_value.fence.side_effect = (
+            powerops.ironic.FencingError('power state unknown'))
+        self.assertRaises(powerops.ironic.FencingError, self.run_flow)
+        self.assertEqual([], self.http.request_history)
+        self.assertNotIn('evacuate', self.events)
+
+    def test_unconfirmed_fence_result_never_queries_nova_or_evacuates(self):
+        for result in (None, {}, {'power_state': 'power on'}):
+            with self.subTest(result=result):
+                self.fencing_result = result
+                self.assertRaises(exception.HostRecoveryFailureException,
+                                  self.run_flow)
+                self.assertEqual([], self.http.request_history)
+                self.assertNotIn('evacuate', self.events)
+
+    def test_up_times_out_without_evacuation_or_power_on(self):
+        clock = [0.0]
+
+        def sleep(seconds):
+            clock[0] += seconds
+
+        self.http.get(SERVICES_URL, json={'services': [service('up')]},
+                      complete_qs=True)
+        with mock.patch.object(time, 'monotonic', lambda: clock[0]), \
+                mock.patch.object(eventlet, 'sleep', sleep), \
+                self.assertLogs(powerops.LOG.logger, level='CRITICAL') as logs:
+            error = self.assertRaises(exception.HostRecoveryFailureException,
+                                      self.run_flow)
+        self.assertIn(HOST, str(error))
+        self.assertIn('Nova', str(error))
+        self.assertEqual(180, clock[0])
+        self.assertNotIn('evacuate', self.events)
+        self.assertEqual(1, self.events.count('fence'))
+        self.assertIn('previously confirmed power off',
+                      logs.records[-1].getMessage())
+        self.assertEqual(['fence'], [c[0] for c in
+                                    self.ironic.return_value.method_calls])
+
+    def test_api_error_stops_recovery_and_keeps_fencing_evidence(self):
+        self.http.get(SERVICES_URL, status_code=403,
+                      json={'forbidden': {'message': 'denied', 'code': 403}},
+                      complete_qs=True)
+        with self.assertLogs(powerops.LOG.logger, level='CRITICAL') as logs:
+            self.assertRaises(exception.HostRecoveryFailureException,
+                              self.run_flow)
+        self.assertNotIn('evacuate', self.events)
+        self.assertIn('previously confirmed power off',
+                      logs.records[-1].getMessage())
+
+    def test_lost_coordination_after_response_never_allows_evacuation(self):
+        def respond(request, context):
+            self.coordinator.fail_health_after = 1
+            return {'services': [service()]}
+
+        self.http.get(SERVICES_URL, json=respond, complete_qs=True)
+        self.assertRaises(RuntimeError, self.run_flow)
+        self.assertNotIn('evacuate', self.events)
+
+    def test_immediate_down_does_not_add_a_fixed_delay(self):
+        self.http.get(SERVICES_URL, json={'services': [service()]},
+                      complete_qs=True)
+        with mock.patch.object(eventlet, 'sleep') as sleep:
+            self.run_flow()
