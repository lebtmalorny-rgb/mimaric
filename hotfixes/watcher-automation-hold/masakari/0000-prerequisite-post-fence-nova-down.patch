@@ -138,6 +142,23 @@ def novaclient(context, timeout=None):
 class API(object):
     """API for interacting with novaclient."""
 
+    @translate_nova_exception
+    def get_compute_service(self, context, host_name, timeout):
+        """Read exactly one source compute service, without SDK caching."""
+        nova = novaclient(context, timeout=timeout)
+        services = nova.services.list(host=host_name, binary='nova-compute')
