 """PowerOps TaskFlow tasks."""
 
+import time
+
+import eventlet
+from eventlet import patcher
+from eventlet import tpool
 from oslo_log import log as logging
 
 from masakari import conf
@@ -24,20 +29,24 @@ from masakari.powerops import ironic
 
 CONF = conf.CONF
 LOG = logging.getLogger(__name__)
+NATIVE_THREADING = patcher.original('threading')
 
 
 class IronicFenceTask(base.MasakariTask):
     def __init__(self, context, novaclient, **kwargs):
         kwargs["requires"] = ["host_name"]
         self.powerops_coordinator = kwargs.pop("powerops_coordinator", None)
+        self._fencing_result = None
         super(IronicFenceTask, self).__init__(context, novaclient, **kwargs)
 
     def execute(self, host_name):
+        self._fencing_result = None
         if not CONF.powerops.enabled or self.powerops_coordinator is None:
             raise exception.HostRecoveryFailureException(
                 message="PowerOps coordinator is required for fencing"
             )
-        return ironic.IronicPowerClient(
+        self.powerops_coordinator.assert_healthy()
+        result = ironic.IronicPowerClient(
             ironic.connection_from_conf(),
             health_check=self.powerops_coordinator.assert_healthy,
         ).fence(
@@ -46,12 +55,91 @@ class IronicFenceTask(base.MasakariTask):
             CONF.powerops.poll_interval,
             CONF.powerops.stable_off_observations,
         )
+        if (not isinstance(result, dict) or
+                result.get('power_state') != 'power off'):
+            raise exception.HostRecoveryFailureException(
+                message="Ironic did not confirm power off for host %r" %
+                        host_name)
+        # Retain the historical confirmation even if the subsequent Nova
+        # wait fails and TaskFlow supplies a Failure object to revert().
+        self._fencing_result = result
+        self._wait_for_nova_down(host_name)
+        return result
+
+    def _wait_for_nova_down(self, host_name):
+        timeout = CONF.powerops.nova_down_timeout
+        deadline = time.monotonic() + timeout
+        timeout_error = exception.HostRecoveryFailureException(
+            message="Timed out after %ss waiting for Nova compute service "
+                    "on host %r to become disabled/down after fencing; "
+                    "evacuation is not permitted" % (timeout, host_name))
+        caller_thread = NATIVE_THREADING.get_ident()
+
+        def read_service():
+            # tpool may execute inline when disabled or under an import lock.
+            # Never let native DNS block the recovery hub in that case.
+            if NATIVE_THREADING.get_ident() == caller_thread:
+                raise exception.HostRecoveryFailureException(
+                    message="Native worker is required to bound the Nova "
+                            "read for host %r" % host_name)
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                raise timeout_error
+            return self.novaclient.get_compute_service(
+                self.context, host_name, timeout=remaining)
+
+        msg = ("Ironic confirmed power off for host %r; waiting up to %ss "
+               "for Nova disabled/down" % (host_name, timeout))
+        # Bound Nova authentication, HTTP and polling as one budget, not just
+        # each request. Existing coordination/progress callbacks retain their
+        # backend blocking semantics. Nova DNS runs off the recovery hub.
+        # An in-flight read may finish after timeout, with no recovery or
+        # power side effects; queued reads refuse to start after the deadline.
+        with eventlet.Timeout(timeout, timeout_error):
+            LOG.info(msg)
+            self.update_details(msg)
+            while True:
+                self.powerops_coordinator.assert_healthy()
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    raise timeout_error
+                try:
+                    service = tpool.execute(read_service)
+                except exception.HostRecoveryFailureException:
+                    raise
+                except Exception as exc:
+                    raise exception.HostRecoveryFailureException(
+                        message="Cannot verify Nova compute service on "
+                                "host %r after fencing: %s" %
+                                (host_name, exc)) from exc
+                self.powerops_coordinator.assert_healthy()
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    raise timeout_error
+                state = service.get('state')
+                status = service.get('status')
+                if status != 'disabled' or state not in ('up', 'down'):
+                    raise exception.HostRecoveryFailureException(
+                        message="Unsafe Nova compute service on host %r "
+                                "after fencing: status=%r state=%r" %
+                                (host_name, status, state))
+                if state == 'down':
+                    msg = ("Nova confirmed disabled/down for fenced host %r; "
+                           "host recovery may proceed" % host_name)
+                    LOG.info(msg)
+                    self.update_details(msg, 1.0)
+                    return
+                LOG.debug("Nova compute service on fenced host %s is still "
+                          "up; %.1fs left", host_name, remaining)
+                eventlet.sleep(min(CONF.powerops.poll_interval, remaining))
 
     def revert(self, host_name, result, flow_failures):
         # TaskFlow also reverts a failed execute(), passing a Failure instead
         # of a fencing result. Neither case establishes current power state.
-        if (isinstance(result, dict) and
-                result.get("power_state") == "power off"):
+        confirmation = (result if isinstance(result, dict)
+                        else self._fencing_result)
+        if (isinstance(confirmation, dict) and
+                confirmation.get("power_state") == "power off"):
             LOG.critical(
                 "Fencing for host %s previously confirmed power off; "
                 "current power state is not rechecked during rollback. "
