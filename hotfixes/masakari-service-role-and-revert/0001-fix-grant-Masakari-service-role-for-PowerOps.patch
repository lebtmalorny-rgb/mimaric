From 7fe65f436be842fc6bc0ea3fdb09d748f7254780 Mon Sep 17 00:00:00 2001
From: Lebt <lebtmalorny@gmail.com>
Date: Mon, 7 Sep 2026 20:18:32 +0300
Subject: [PATCH] fix: grant Masakari service role for PowerOps

Create and grant the service role in the service project when enable_powerops is enabled, preserving the admin assignment and configurable username. Do not revoke existing assignments when PowerOps is disabled.

Regression tests render Masakari registration through the shared Keystone task arguments. Local validation: 64 PowerOps and Masakari Kolla tests passed. No live Keystone or deployment actions performed.
---
 ansible/roles/masakari/defaults/main.yml      |   7 ++
 ansible/roles/masakari/tasks/register.yml     |   2 +
 .../tests/unit/test_masakari_service_role.py  | 103 ++++++++++++++++++
 3 files changed, 112 insertions(+)
 create mode 100644 kolla_ansible/tests/unit/test_masakari_service_role.py

diff --git a/ansible/roles/masakari/defaults/main.yml b/ansible/roles/masakari/defaults/main.yml
index 8fc16ac..e6207cf 100644
--- a/ansible/roles/masakari/defaults/main.yml
+++ b/ansible/roles/masakari/defaults/main.yml
@@ -194,6 +194,13 @@ masakari_ks_users:
     password: "{{ masakari_keystone_password }}"
     role: "admin"
 
+# Ironic service policy requires this role in the service project in addition
+# to admin. Disabling PowerOps must not revoke an operator-managed assignment.
+masakari_ks_roles: "{{ ['service'] if enable_powerops | bool else [] }}"
+masakari_ks_user_roles: >-
+  {{ [{'project': 'service', 'user': masakari_keystone_user, 'role': 'service'}]
+     if enable_powerops | bool else [] }}
+
 ####################
 # libvirt
 ####################
diff --git a/ansible/roles/masakari/tasks/register.yml b/ansible/roles/masakari/tasks/register.yml
index 9f2413a..b436c9a 100644
--- a/ansible/roles/masakari/tasks/register.yml
+++ b/ansible/roles/masakari/tasks/register.yml
@@ -5,3 +5,5 @@
     service_ks_register_auth: "{{ openstack_masakari_auth }}"
     service_ks_register_services: "{{ masakari_ks_services }}"
     service_ks_register_users: "{{ masakari_ks_users }}"
+    service_ks_register_roles: "{{ masakari_ks_roles }}"
+    service_ks_register_user_roles: "{{ masakari_ks_user_roles }}"
diff --git a/kolla_ansible/tests/unit/test_masakari_service_role.py b/kolla_ansible/tests/unit/test_masakari_service_role.py
new file mode 100644
index 0000000..f258a4f
--- /dev/null
+++ b/kolla_ansible/tests/unit/test_masakari_service_role.py
@@ -0,0 +1,103 @@
