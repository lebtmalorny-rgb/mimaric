+from pathlib import Path
+import unittest
+
+from ansible.parsing.dataloader import DataLoader
+from ansible.template import Templar
+import yaml
+
+
+ROLES = Path(__file__).resolve().parents[3] / 'ansible/roles'
+
+
+def load(relative):
+    return yaml.safe_load((ROLES / relative).read_text(encoding='utf-8'))
+
+
+class MasakariServiceRoleTest(unittest.TestCase):
+    """Render Masakari registration through the shared Keystone tasks."""
+
+    def render_registration(self, enabled, username='masakari'):
+        variables = load('service-ks-register/defaults/main.yml')
+        variables.update(load('masakari/defaults/main.yml'))
+        variables.update(load('masakari/tasks/register.yml')[0]['vars'])
+        variables.update({
+            'enable_powerops': enabled,
+            'masakari_keystone_user': username,
+            'masakari_keystone_password': 'test-only-password',
+            'openstack_region_name': 'RegionOne',
+            'openstack_masakari_auth': {},
+            'openstack_interface': 'internal',
+            'openstack_cacert': '',
+            'service_ks_register_mtls': False,
+            'omit': '__omit__',
+        })
+        tasks = load('service-ks-register/tasks/main.yml')[0]['block']
+        rendered = {}
+        for module in ('identity_role', 'identity_user', 'role_assignment'):
+            task = next(t for t in tasks if t['kolla_toolbox'][
+                'module_name'] == 'openstack.cloud.' + module)
+            templar = Templar(loader=DataLoader(), variables=variables)
+            items = templar.template(task['with_items'])
+            rendered[module] = []
+            for item in items:
+                templar = Templar(loader=DataLoader(), variables={
+                    **variables, 'item': item,
+                    'update_keystone_service_user_passwords': False,
+                })
+                args = templar.template(task['kolla_toolbox']['module_args'])
+                rendered[module].append({
+                    key: value for key, value in args.items()
+                    if value != '__omit__'
+                })
+        return rendered
+
+    def test_enabled_creates_service_role_and_project_assignment(self):
+        for enabled in (True, 'yes', 'true'):
+            with self.subTest(enabled=enabled):
+                result = self.render_registration(enabled)
+                self.assertEqual(['admin', 'service'], [
+                    r['name'] for r in result['identity_role']])
+                self.assertEqual([
+                    ('masakari', 'service', 'admin', 'present'),
+                    ('masakari', 'service', 'service', 'present'),
+                ], [(r['user'], r['project'], r['role'], r['state'])
+                    for r in result['role_assignment']])
+                for assignment in result['role_assignment']:
+                    self.assertNotIn('system', assignment)
+                    self.assertNotIn('domain', assignment)
+
+    def test_disabled_does_not_grant_or_revoke_service_role(self):
+        for enabled in (False, 'no', 'false'):
+            with self.subTest(enabled=enabled):
+                result = self.render_registration(enabled)
+                self.assertEqual(['admin'], [
+                    r['name'] for r in result['identity_role']])
+                self.assertEqual([('admin', 'present')], [
+                    (r['role'], r['state'])
+                    for r in result['role_assignment']])
+
+    def test_custom_username_receives_both_roles(self):
+        result = self.render_registration(True, 'custom-masakari')
+        self.assertEqual([
+            ('custom-masakari', 'admin'),
+            ('custom-masakari', 'service'),
+        ], [(r['user'], r['role']) for r in result['role_assignment']])
+
+    def test_additional_role_does_not_duplicate_user_creation(self):
+        result = self.render_registration(True)
+        self.assertEqual(1, len(result['identity_user']))
+        self.assertEqual('masakari', result['identity_user'][0]['name'])
+        self.assertEqual('on_create',
+                         result['identity_user'][0]['update_password'])

