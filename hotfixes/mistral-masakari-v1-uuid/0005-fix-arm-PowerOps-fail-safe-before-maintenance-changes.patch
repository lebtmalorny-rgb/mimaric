+
+from unittest import mock
+
+from mistral.actions.powerops import base as action_base
+from mistral.actions.powerops import clients
+from mistral.actions.powerops import exceptions
+from mistral.actions.powerops import planned
+from mistral.actions.powerops import return_host
+from mistral.tests.unit.actions.powerops import fakes
+from mistral.tests.unit import base
+
+
+class TransitionSafetyTest(base.BaseTest):
+    action_classes = (
+        planned.PlannedPowerOffAction,
+        planned.PlannedRebootAction,
+        return_host.PowerOnForInspectionAction,
+    )
+
+    def setUp(self):
+        super(TransitionSafetyTest, self).setUp()
+        self.override_config('enabled', True, 'powerops')
+        self.override_config(
+            'allowed_project_names', ['operations'], 'powerops'
+        )
+        self.override_config(
+            'allowed_user_names', ['powerops-operator'], 'powerops'
+        )
+
+    def _failed_transition(self, action_class, failure_mode,
+                           lose_health=False):
+        events = []
+        node = fakes.node('node-1', 'compute-01')
+        service = fakes.service('service-1', 'compute-01', status='enabled')
+        host = fakes.masakari_host('host-1', 'compute-01', False)
+        data = fakes.cloud(
+            ironic_nodes=[node], nova_services=[service],
+            masakari_hosts=[host], events=events,
+        )
+        original_error = RuntimeError('maintenance response lost')
+        original_get = data.ha_adapter.get.side_effect
+        original_put = data.ha_adapter.put.side_effect
+        healthy = True
+
+        def fail():
+            nonlocal healthy
+            healthy = not lose_health
+            raise original_error
+
+        def get(path):
+            if host.on_maintenance and failure_mode == 'readback':
+                fail()
+            return original_get(path)
+
+        def put(*args, **kwargs):
+            if failure_mode == 'put-before-apply':
+                fail()
+            result = original_put(*args, **kwargs)
+            if failure_mode == 'put-after-apply':
+                fail()
+            return result
+
+        def assert_healthy():
+            if not healthy:
+                raise RuntimeError('coordination lost')
+
+        data.ha_adapter.get.side_effect = get
+        data.ha_adapter.put.side_effect = put
+        coordinator = fakes.recording_coordinator(events)
+        coordinator.assert_healthy = assert_healthy
+        cloud = clients.CloudClients(
+            data.connection, ha_adapter=data.ha_adapter, sleep=lambda _: None,
+            health_check=assert_healthy,
+        )
+        if failure_mode == 'preflight':
+            node.name = 'other-host'
+
+        with mock.patch.object(
+                action_base.coordination, 'OperationCoordinator',
+                return_value=coordinator), mock.patch.object(
+                clients, 'connection_from_conf',
+                return_value=data.connection), mock.patch.object(
+                clients, 'CloudClients', return_value=cloud):
+            action = action_class('compute-01', 'segment-1')
+            raised = self.assertRaises(
+                exceptions.HostResolutionError
+                if failure_mode == 'preflight' else RuntimeError,
+                action.run, fakes.action_context('failed-transition'),
+            )
+
+        data.connection.baremetal.set_node_power_state.assert_not_called()
+        data.connection.compute.enable_service.assert_not_called()
+        self.assertEqual('power on', node.power_state)
+        if failure_mode == 'preflight':
+            data.ha_adapter.put.assert_not_called()
+        else:
+            self.assertIs(original_error, raised)
+            self.assertEqual(
+                failure_mode != 'put-before-apply', host.on_maintenance
+            )
+
+        if lose_health or failure_mode == 'preflight':
+            self.assertEqual('enabled', service.status)
+            data.connection.compute.disable_service.assert_not_called()
+        else:
+            self.assertEqual('disabled', service.status)
+            disable_index = next(
+                index for index, event in enumerate(events)
+                if isinstance(event, tuple) and event[0] == 'disable'
+            )
+            self.assertLess(events.index('host-lock-enter'), disable_index)
+            self.assertLess(disable_index, events.index('host-lock-exit'))
+
+    def test_maintenance_readback_failure_disables_nova_inside_lock(self):
+        for action_class in self.action_classes:
+            with self.subTest(action=action_class.__name__):
+                self._failed_transition(action_class, 'readback')
+
+    def test_uncertain_maintenance_put_disables_nova_inside_lock(self):
+        for action_class in self.action_classes:
+            for mode in ('put-before-apply', 'put-after-apply'):
+                with self.subTest(action=action_class.__name__, mode=mode):
+                    self._failed_transition(action_class, mode)
+
+    def test_maintenance_failure_does_not_bypass_coordination_loss(self):
+        for action_class in self.action_classes:
+            with self.subTest(action=action_class.__name__):
+                self._failed_transition(
+                    action_class, 'readback', lose_health=True
+                )
+
+    def test_preflight_failure_does_not_trigger_mutations(self):
+        for action_class in self.action_classes:
+            with self.subTest(action=action_class.__name__):
+                self._failed_transition(action_class, 'preflight')
