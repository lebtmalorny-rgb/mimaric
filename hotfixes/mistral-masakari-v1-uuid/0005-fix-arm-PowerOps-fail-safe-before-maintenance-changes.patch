From: Lebt <lebtmalorny@gmail.com>
Date: Sat, 5 Sep 2026 13:58:45 +0300
Subject: [PATCH 5/5] fix: arm PowerOps fail-safe before maintenance changes

---
 mistral/actions/powerops/base.py              |   4 +-
 mistral/actions/powerops/planned.py           |   6 +-
 mistral/actions/powerops/return_host.py       |   5 +-
 .../powerops/test_transition_safety.py        | 148 ++++++++++++++++++
 4 files changed, 157 insertions(+), 6 deletions(-)
 create mode 100644 mistral/tests/unit/actions/powerops/test_transition_safety.py

diff --git a/mistral/actions/powerops/base.py b/mistral/actions/powerops/base.py
index 29a0bb4..dfcb63b 100644
--- a/mistral/actions/powerops/base.py
+++ b/mistral/actions/powerops/base.py
@@ -66,7 +66,7 @@ class PowerOpsAction(actions.Action):
                         clients.connection_from_conf(),
                         health_check=coordinator.assert_healthy,
                     )
-                    self._nova_disabled = False
+                    self._fail_safe_required = False
 
                     try:
                         result = operation(cloud)
@@ -78,7 +78,7 @@ class PowerOpsAction(actions.Action):
                     except Exception as exc:
                         fail_safe_errors = []
 
-                        if self._nova_disabled:
+                        if self._fail_safe_required:
                             fail_safe_errors = self._fail_safe(cloud)
 
                         try:
diff --git a/mistral/actions/powerops/planned.py b/mistral/actions/powerops/planned.py
index 0e47e23..8430fb9 100644
--- a/mistral/actions/powerops/planned.py
+++ b/mistral/actions/powerops/planned.py
@@ -56,10 +56,11 @@ class PlannedPowerOffAction(_PlannedPowerAction):
     def run(self, context):
         def operation(cloud):
             cloud.resolve_host_set(self.segment_uuid, self.host)
+            # A failed maintenance call may already have changed the host.
+            self._fail_safe_required = True
             cloud.set_masakari_maintenance(
                 self.segment_uuid, self.host, True
             )
-            self._nova_disabled = True
             cloud.disable_nova(
                 self.host, CONF.powerops.nova_disable_reason
             )
@@ -101,10 +102,11 @@ class PlannedRebootAction(_PlannedPowerAction):
     def run(self, context):
         def operation(cloud):
             cloud.resolve_host_set(self.segment_uuid, self.host)
+            # A failed maintenance call may already have changed the host.
+            self._fail_safe_required = True
             cloud.set_masakari_maintenance(
                 self.segment_uuid, self.host, True
             )
-            self._nova_disabled = True
             cloud.disable_nova(
                 self.host, CONF.powerops.nova_disable_reason
             )
diff --git a/mistral/actions/powerops/return_host.py b/mistral/actions/powerops/return_host.py
index 66af3c2..31b4ac3 100644
--- a/mistral/actions/powerops/return_host.py
+++ b/mistral/actions/powerops/return_host.py
@@ -77,10 +77,11 @@ class PowerOnForInspectionAction(base.PowerOpsAction):
     def run(self, context):
         def operation(cloud):
             cloud.resolve_host_set(self.segment_uuid, self.host)
+            # A failed maintenance call may already have changed the host.
+            self._fail_safe_required = True
             cloud.set_masakari_maintenance(
                 self.segment_uuid, self.host, True
             )
-            self._nova_disabled = True
             cloud.disable_nova(
                 self.host, CONF.powerops.nova_disable_reason
             )
@@ -131,7 +132,7 @@ class ReturnToServiceAction(base.PowerOpsAction):
     def run(self, context):
         def operation(cloud):
             cloud.resolve_host_set(self.segment_uuid, self.host)
-            self._nova_disabled = True
+            self._fail_safe_required = True
             cloud.require_stable_power_on(self.host)
             cloud.wait_nova_service(
                 self.host, enabled=False, up=True
diff --git a/mistral/tests/unit/actions/powerops/test_transition_safety.py b/mistral/tests/unit/actions/powerops/test_transition_safety.py
new file mode 100644
index 0000000..086ea80
--- /dev/null
+++ b/mistral/tests/unit/actions/powerops/test_transition_safety.py
@@ -0,0 +1,148 @@
+# Copyright 2026 OpenStack Foundation
