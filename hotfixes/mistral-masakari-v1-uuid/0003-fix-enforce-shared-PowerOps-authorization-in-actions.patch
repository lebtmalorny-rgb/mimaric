+# under the License.
+
+from unittest import mock
+
+from mistral.actions.powerops import base as action_base
+from mistral.actions.powerops import exceptions
+from mistral.actions.powerops import planned
+from mistral.actions.powerops import return_host
+from mistral.tests.unit.actions.powerops import fakes
+from mistral.tests.unit import base
+
+
+class ActionAuthorizationTest(base.BaseTest):
+    def setUp(self):
+        super(ActionAuthorizationTest, self).setUp()
+        self.override_config('enabled', True, 'powerops')
+        self.override_config(
+            'allowed_project_names', ['operations'], 'powerops'
+        )
+        self.override_config(
+            'allowed_user_names', ['powerops-operator'], 'powerops'
+        )
+
+    @staticmethod
+    def _actions():
+        return (
+            planned.PlannedPowerOffAction('compute-01', 'segment-1'),
+            planned.PlannedRebootAction('compute-01', 'segment-1'),
+            return_host.HostPowerStatusAction('compute-01', 'segment-1'),
+            return_host.PowerOnForInspectionAction('compute-01', 'segment-1'),
+            return_host.ReturnToServiceAction(
+                'compute-01', 'segment-1', [], stale_domains_checked=True
+            ),
+        )
+
+    @mock.patch.object(action_base.coordination, 'OperationCoordinator')
+    @mock.patch.object(action_base.clients, 'connection_from_conf')
+    def test_direct_actions_reject_untrusted_roles_before_cloud_access(
+            self, connection_from_conf, coordinator_cls):
+        coordinator_cls.side_effect = AssertionError(
+            'unauthorized action reached coordination'
+        )
+        connection_from_conf.side_effect = AssertionError(
+            'unauthorized action reached OpenStack'
+        )
+        for roles in ([], None, ['member'], 'admin', [1], ['Admin']):
+            context = fakes.action_context('direct-action')
+            context.security.roles = roles
+
+            for action in self._actions():
+                with self.subTest(action=type(action).__name__, roles=roles):
+                    self.assertRaises(
+                        exceptions.PowerOpsUnauthorized, action.run, context
+                    )
+
+        connection_from_conf.assert_not_called()
+        coordinator_cls.assert_not_called()
+
+    def test_admin_is_not_restricted_by_operator_allowlists(self):
+        context = fakes.action_context(
+            'admin-action', project_name='admin', user_name='admin',
+            roles=['admin'],
+        )
+        self.override_config('allowed_project_names', [], 'powerops')
+        self.override_config('allowed_user_names', [], 'powerops')
+
+        for action in self._actions():
+            action._authorize(context)
+
+    def test_allowlisted_operator_is_authorized_for_soft_actions(self):
+        for action in self._actions():
+            action._authorize(fakes.action_context('operator-action'))
+
+    @mock.patch.object(action_base.coordination, 'OperationCoordinator')
+    @mock.patch.object(action_base.clients, 'connection_from_conf')
+    def test_direct_hard_off_requires_admin_role(
+            self, connection_from_conf, coordinator_cls):
+        coordinator_cls.side_effect = AssertionError(
+            'operator hard-off reached coordination'
+        )
+        for action_class in (
+                planned.PlannedPowerOffAction, planned.PlannedRebootAction):
+            action = action_class(
+                'compute-01', 'segment-1', allow_hard_off=True
+            )
+            self.assertRaises(
+                exceptions.PowerOpsUnauthorized, action.run,
+                fakes.action_context('operator-hard-off'),
+            )
+            action._authorize(fakes.action_context(
+                'admin-hard-off', project_name='admin', user_name='admin',
+                roles=['admin'],
+            ))
+
+        connection_from_conf.assert_not_called()
+        coordinator_cls.assert_not_called()
