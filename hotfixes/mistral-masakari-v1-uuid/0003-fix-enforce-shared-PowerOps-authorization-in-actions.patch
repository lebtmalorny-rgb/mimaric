From 3dec4eae7a40f3fd6b587db4a52967bb0c9bbec0 Mon Sep 17 00:00:00 2001
From: Lebt <lebtmalorny@gmail.com>
Date: Sat, 5 Sep 2026 13:48:52 +0300
Subject: [PATCH 3/5] fix: enforce shared PowerOps authorization in actions

---
 mistral/actions/powerops/base.py              |  16 +--
 .../actions/powerops/test_authorization.py    | 108 ++++++++++++++++++
 2 files changed, 114 insertions(+), 10 deletions(-)
 create mode 100644 mistral/tests/unit/actions/powerops/test_authorization.py

diff --git a/mistral/actions/powerops/base.py b/mistral/actions/powerops/base.py
index 8ba1dc3..29a0bb4 100644
--- a/mistral/actions/powerops/base.py
+++ b/mistral/actions/powerops/base.py
@@ -18,6 +18,7 @@ from oslo_log import log as logging
 from mistral.actions.powerops import clients
 from mistral.actions.powerops import coordination
 from mistral.actions.powerops import exceptions
+from mistral.services import powerops
 from mistral_lib import actions
 
 
@@ -29,16 +30,11 @@ class PowerOpsAction(actions.Action):
     """Shared authorization, coordination and fail-safe action template."""
 
     def _authorize(self, context):
-        security = context.security
-
-        if (
-                security.project_name
-                not in CONF.powerops.allowed_project_names
-                or security.user_name
-                not in CONF.powerops.allowed_user_names):
-            raise exceptions.PowerOpsUnauthorized(
-                'caller is not authorized for PowerOps'
-            )
+        powerops.authorize(
+            context.security,
+            allow_hard_off=getattr(self, 'allow_hard_off', False),
+            error_cls=exceptions.PowerOpsUnauthorized,
+        )
 
     def _validate_inputs(self):
         try:
diff --git a/mistral/tests/unit/actions/powerops/test_authorization.py b/mistral/tests/unit/actions/powerops/test_authorization.py
new file mode 100644
index 0000000..586e694
--- /dev/null
+++ b/mistral/tests/unit/actions/powerops/test_authorization.py
@@ -0,0 +1,108 @@
