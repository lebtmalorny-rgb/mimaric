+import pickle
+from unittest import mock
+
+from mistral.actions.powerops import exceptions
+from mistral.actions.powerops import return_host
+from mistral import context
+from mistral.executors import default_executor
+from mistral.tests.unit import base
+
+
+ERROR_TYPES = (
+    exceptions.PowerOpsError,
+    exceptions.PowerOpsConfigurationError,
+    exceptions.PowerOpsTimeout,
+    exceptions.PowerOpsCallTimeout,
+    exceptions.HostResolutionError,
+    exceptions.PowerStateError,
+    exceptions.InstancePolicyError,
+    exceptions.InstanceManifestError,
+    exceptions.PowerOpsUnauthorized,
+    exceptions.PowerOpsDisabled,
+    exceptions.OperatorGateRequired,
+)
+
+
+class PowerOpsExceptionTest(base.BaseTest):
+    def test_errors_without_arguments_have_diagnostic_text(self):
+        for error_type in ERROR_TYPES:
+            with self.subTest(error_type=error_type):
+                self.assertTrue(str(error_type()).strip())
+
+    def test_explicit_empty_message_uses_diagnostic_text(self):
+        for error_type in ERROR_TYPES:
+            with self.subTest(error_type=error_type):
+                self.assertTrue(str(error_type('')).strip())
+
+    def test_explicit_message_and_exception_args_are_preserved(self):
+        for error_type in ERROR_TYPES:
+            with self.subTest(error_type=error_type):
+                error = error_type('specific safe failure detail')
+                self.assertEqual('specific safe failure detail', str(error))
+                self.assertEqual(('specific safe failure detail',), error.args)
+                self.assertEqual((), error_type().args)
+
+    def test_default_message_survives_exception_serialization(self):
+        error = pickle.loads(pickle.dumps(exceptions.PowerOpsDisabled()))
+
+        self.assertIsInstance(error, exceptions.PowerOpsDisabled)
+        self.assertIn('enabled=false', str(error))
+
+    @mock.patch.object(default_executor.rpc, 'get_engine_client')
+    def test_disabled_status_reaches_executor_result_with_message(self, rpc):
+        self.override_config('enabled', False, 'powerops')
+        previous = context.ctx() if context.has_ctx() else None
+        self.addCleanup(context.set_ctx, previous)
+        context.set_ctx(base.get_context())
+        action = return_host.HostPowerStatusAction('compute-01', 'segment-1')
+        executor = default_executor.DefaultExecutor()
+
+        result = executor._do_run_action(
+            action, None, {}, redelivered=False, safe_rerun=False, timeout=None
+        )
+
+        self.assertTrue(result.is_error())
+        self.assertIn('PowerOps actions are disabled', result.error)
+        self.assertIn('[powerops] enabled=false', result.error)
+        self.assertNotIn("msg=''", result.error)
