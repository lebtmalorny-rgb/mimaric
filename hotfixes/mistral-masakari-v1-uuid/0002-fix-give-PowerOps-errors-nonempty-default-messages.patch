From ca39c2eeb35b9008a45109b315d7b06c8fe3c620 Mon Sep 17 00:00:00 2001
From: Lebt <lebtmalorny@gmail.com>
Date: Sat, 5 Sep 2026 13:01:59 +0300
Subject: [PATCH] fix: give PowerOps errors nonempty default messages

Preserve explicit exception details and args while providing safe diagnostic text for bare PowerOps exceptions, including PowerOpsDisabled. Test actual DefaultExecutor error formatting without changing global executor behavior.
---
 mistral/actions/powerops/exceptions.py        | 29 +++++++
 .../unit/actions/powerops/test_exceptions.py  | 81 +++++++++++++++++++
 2 files changed, 110 insertions(+)
 create mode 100644 mistral/tests/unit/actions/powerops/test_exceptions.py

diff --git a/mistral/actions/powerops/exceptions.py b/mistral/actions/powerops/exceptions.py
index e7b0c0f..c136cda 100644
--- a/mistral/actions/powerops/exceptions.py
+++ b/mistral/actions/powerops/exceptions.py
@@ -16,42 +16,71 @@
 class PowerOpsError(Exception):
     """Base error for planned PowerOps actions."""
 
+    default_message = 'PowerOps operation failed'
+
+    def __str__(self):
+        # Mistral embeds str(error) in the action result. Preserve supplied
+        # details and exception args, but never format an empty PowerOps error.
+        return super().__str__() or self.default_message
+
 
 class PowerOpsConfigurationError(PowerOpsError):
     """PowerOps service authentication is not configured safely."""
 
+    default_message = 'PowerOps configuration is incomplete or unsafe'
+
 
 class PowerOpsTimeout(PowerOpsError):
     """A bounded PowerOps operation did not finish in time."""
 
+    default_message = 'PowerOps operation timed out'
+
 
 class PowerOpsCallTimeout(PowerOpsTimeout):
     """An individual yielding SDK or adapter call hit its deadline."""
 
+    default_message = 'PowerOps API call timed out'
+
 
 class HostResolutionError(PowerOpsError):
     """A host did not resolve to one exact compatible resource."""
 
+    default_message = 'Host must resolve to one exact compatible resource'
+
 
 class PowerStateError(PowerOpsError):
     """An Ironic power state is unsafe or inconsistent."""
 
+    default_message = 'Ironic power state is unsafe or inconsistent'
+
 
 class InstancePolicyError(PowerOpsError):
     """An instance policy is invalid or cannot be applied safely."""
 
+    default_message = 'Instance policy is invalid or cannot be applied safely'
+
 
 class InstanceManifestError(PowerOpsError):
     """An explicit instance restart manifest is unsafe."""
 
+    default_message = 'Instance restart manifest is unsafe'
+
 
 class PowerOpsUnauthorized(PowerOpsError):
     """The Mistral caller is not authorized for PowerOps."""
 
+    default_message = 'Caller is not authorized for PowerOps'
+
 
 class PowerOpsDisabled(PowerOpsError):
     """PowerOps actions are disabled."""
 
+    default_message = (
+        'PowerOps actions are disabled ([powerops] enabled=false)'
+    )
+
 
 class OperatorGateRequired(PowerOpsError):
     """The operator inspection gate has not been acknowledged."""
+
+    default_message = 'Operator inspection gate has not been acknowledged'
diff --git a/mistral/tests/unit/actions/powerops/test_exceptions.py b/mistral/tests/unit/actions/powerops/test_exceptions.py
new file mode 100644
index 0000000..84fda28
--- /dev/null
+++ b/mistral/tests/unit/actions/powerops/test_exceptions.py
@@ -0,0 +1,81 @@
