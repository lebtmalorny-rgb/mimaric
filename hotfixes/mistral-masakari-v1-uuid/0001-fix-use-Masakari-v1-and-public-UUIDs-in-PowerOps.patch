From e5c5bcf412b618ea2dfdc74b21bd34139827fb27 Mon Sep 17 00:00:00 2001
From: Lebt <lebtmalorny@gmail.com>
Date: Sat, 5 Sep 2026 12:42:51 +0300
Subject: [PATCH] fix: use Masakari v1 and public UUIDs in PowerOps

Negotiate API v1 for unversioned Keystone catalog endpoints and use the REST uuid rather than the unrelated numeric database id. Keep canonical identifier validation and fail closed when uuid is absent.

Add real keystoneauth HTTP-boundary regression coverage for discovery, segment and host identifiers, and maintenance writes with state read-back. Update action fakes to expose both REST identifiers.
---
 mistral/actions/powerops/clients.py           |  20 +-
 mistral/tests/unit/actions/powerops/fakes.py  |  15 +-
 .../unit/actions/powerops/test_clients.py     |   9 +-
 .../actions/powerops/test_masakari_http.py    | 193 ++++++++++++++++++
 4 files changed, 215 insertions(+), 22 deletions(-)
 create mode 100644 mistral/tests/unit/actions/powerops/test_masakari_http.py

diff --git a/mistral/actions/powerops/clients.py b/mistral/actions/powerops/clients.py
index d3d9d27..3192a71 100644
--- a/mistral/actions/powerops/clients.py
+++ b/mistral/actions/powerops/clients.py
@@ -159,6 +159,7 @@ class CloudClients:
             self.ha_adapter = ks_adapter.Adapter(
                 session=connection.session,
                 service_type='ha',
+                version='1',
                 interface=CONF.powerops.interface,
                 region_name=CONF.powerops.region_name,
             )
@@ -279,20 +280,11 @@ class CloudClients:
 
     @classmethod
     def _masakari_identifier(cls, item, description):
-        identifiers = []
-
-        for field in ('uuid', 'id'):
-            if field in item:
-                value = item[field]
-                cls._validate_resource_id(value, description)
-                identifiers.append(value)
-
-        if not identifiers or len(set(identifiers)) != 1:
-            raise exceptions.HostResolutionError(
-                '{} is missing or ambiguous'.format(description)
-            )
-
-        return identifiers[0]
+        # REST resources expose a numeric database id alongside their UUID.
+        # Only the UUID identifies a resource in Masakari API paths.
+        value = item.get('uuid')
+        cls._validate_resource_id(value, description)
+        return value
 
     @classmethod
     def _masakari_resource(cls, item):
diff --git a/mistral/tests/unit/actions/powerops/fakes.py b/mistral/tests/unit/actions/powerops/fakes.py
index d72510b..32425f9 100644
--- a/mistral/tests/unit/actions/powerops/fakes.py
+++ b/mistral/tests/unit/actions/powerops/fakes.py
@@ -143,12 +143,19 @@ def cloud(ironic_nodes=None, instances=None, nova_services=None,
     ha_adapter.session = connection.session
     segment_response = mock.Mock()
     segment_response.json.return_value = {
-        "segment": {"uuid": "segment-1"}
+        "segment": {"uuid": "segment-1", "id": 4}
     }
     hosts_response = mock.Mock()
-    hosts_response.json.return_value = {
-        "hosts": [vars(item) for item in hosts]
-    }
+
+    def hosts_body():
+        return {
+            "hosts": [
+                dict(vars(item), uuid=item.id, id=index)
+                for index, item in enumerate(hosts, start=1)
+            ]
+        }
+
+    hosts_response.json.side_effect = hosts_body
 
     def ha_get(path):
         if path.endswith("/hosts"):
