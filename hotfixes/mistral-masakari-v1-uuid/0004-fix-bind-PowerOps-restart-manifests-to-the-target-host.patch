@@ -675,10 +676,69 @@ class CloudClientsTest(base.BaseTest):
         self.assertRaises(
             exceptions.InstanceManifestError,
             self._client(cloud).start_instances,
-            ["vm-a", "vm-a"],
+            'compute-01', ["vm-a", "vm-a"],
         )
         cloud.connection.compute.start_server.assert_not_called()
 
+    def test_restart_validates_entire_manifest_host_before_first_start(self):
+        for observed_host in ('compute-02', None, '', 'Compute-01'):
+            for status in ('ACTIVE', 'SHUTOFF'):
+                data = fakes.cloud(instances=[
+                    fakes.server('vm-a', 'compute-01', 'SHUTOFF'),
+                    fakes.server('vm-b', observed_host, status),
+                ])
+                self.assertRaises(
+                    exceptions.InstanceManifestError,
+                    self._client(data).start_instances,
+                    'compute-01', ['vm-a', 'vm-b'],
+                )
+                data.connection.compute.start_server.assert_not_called()
+
+    def test_restart_rechecks_host_and_state_before_start(self):
+        for field, value in (
+                ('compute_host', 'compute-02'), ('compute_host', None),
+                ('id', 'other-vm'), ('status', 'ERROR')):
+            data = fakes.cloud(instances=[
+                fakes.server('vm-a', 'compute-01', 'SHUTOFF'),
+            ])
+            current = fakes.server('vm-a', 'compute-01', 'SHUTOFF')
+            setattr(current, field, value)
+            data.connection.compute.get_server.side_effect = lambda _: current
+            client = self._client(data, monotonic=fakes.monotonic())
+
+            self.assertRaises(
+                exceptions.InstanceManifestError,
+                client.start_instances,
+                'compute-01', ['vm-a'],
+            )
+            data.connection.compute.start_server.assert_not_called()
+
+    def test_restart_host_change_during_wait_stops_remaining_manifest(self):
+        first = fakes.server('vm-a', 'compute-01', 'SHUTOFF')
+        second = fakes.server('vm-b', 'compute-01', 'SHUTOFF')
+        data = fakes.cloud(instances=[first, second])
+        data.connection.compute.get_server.side_effect = [
+            first, fakes.server('vm-a', 'compute-02', 'ACTIVE'),
+        ]
+
+        self.assertRaises(
+            exceptions.InstanceManifestError,
+            self._client(data, monotonic=fakes.monotonic()).start_instances,
+            'compute-01', ['vm-a', 'vm-b'],
+        )
+        self.assertEqual('SHUTOFF', second.status)
+        data.connection.compute.start_server.assert_called_once_with(first)
+
+    def test_restart_rejects_malformed_manifest_before_lookup(self):
+        for manifest in (None, 'vm-a', [1], ['vm/a'], ['vm-a', 'vm-a']):
+            data = fakes.cloud()
+            self.assertRaises(
+                exceptions.InstanceManifestError,
+                self._client(data).start_instances, 'compute-01', manifest,
+            )
+            data.connection.compute.servers.assert_not_called()
+            data.connection.compute.start_server.assert_not_called()
+
