+
+import os
+from unittest import mock
+
+import fixtures
+
+from kolla.common import sources
+from kolla.image import build
+from kolla.tests import base
+
+
+POWEROPS_SOURCES = {
+    'horizon-plugin-powerops-dashboard': {
+        'type': 'local',
+        'location': '$locals_base/powerops-dashboard',
+        'enabled': False,
+    },
+    'mistral-base-plugin-mistral-lib': {
+        'type': 'local',
+        'location': '$locals_base/worktrees/mistral-lib-horizon-clean',
+        'enabled': False,
+    },
+}
+
+
+class PowerOpsPluginTest(base.TestCase):
+
+    def _write_image(self, images_dir, name):
+        image_dir = os.path.join(images_dir, name)
+        os.makedirs(image_dir)
+        with open(os.path.join(image_dir, 'Dockerfile'), 'w') as dockerfile:
+            dockerfile.write('FROM base\n')
+
+    @mock.patch('kolla.image.kolla_worker.engine.getEngineClient')
+    def test_sources_are_disabled_local_and_have_exact_parents(
+            self, mock_engine):
+        for name, expected in POWEROPS_SOURCES.items():
+            self.assertEqual(expected, sources.SOURCES.get(name))
+
+        images_dir = self.useFixture(fixtures.TempDir()).path
+        for image_name in ('horizon', 'mistral-base', 'mistral'):
+            self._write_image(images_dir, image_name)
+
+        worker = build.KollaWorker(self.conf)
+        worker.working_dir = images_dir
+        worker.find_dockerfiles()
+        worker.build_image_list()
+
+        parents = {}
+        for image in worker.images:
+            for plugin in image.plugins:
+                parents.setdefault(plugin['name'], set()).add(image.name)
+
+        self.assertEqual(
+            {'horizon'}, parents['horizon-plugin-powerops-dashboard'])
+        self.assertEqual(
+            {'mistral-base'},
+            parents['mistral-base-plugin-mistral-lib'])
+
+    def test_horizon_activation_is_opt_in_and_precedes_static_collection(self):
+        script_path = os.path.abspath(os.path.join(
+            os.path.dirname(__file__), '..', '..',
+            'docker', 'horizon', 'extend_start.sh'))
+        with open(script_path) as script_file:
+            script = script_file.read()
+
+        expected_function = '''function config_powerops_dashboard {
+    config_dashboard "${ENABLE_POWEROPS:-no}" \\
+        "${SITE_PACKAGES}/poweropsdashboard/enabled/_50_powerops.py" \\
+        "${SITE_PACKAGES}/openstack_dashboard/local/enabled/_50_powerops.py"
+}'''
+        self.assertIn(expected_function, script)
+        self.assertLess(
+            script.index('\nconfig_powerops_dashboard\n'),
+            script.index('\nif settings_changed; then\n'))
+        self.assertNotIn('pip install', script)
