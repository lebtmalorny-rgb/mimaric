From b3d5501f01eb9412c3eca059d60ae2211e867698 Mon Sep 17 00:00:00 2001
From: Lebt <lebtmalorny@gmail.com>
Date: Thu, 3 Sep 2026 09:22:47 +0300
Subject: [PATCH] feat: carry PowerOps identity in action context

---
 mistral_lib/actions/context.py            | 11 +++++-
 mistral_lib/tests/actions/test_context.py | 48 +++++++++++++++++++++++
 2 files changed, 57 insertions(+), 2 deletions(-)

diff --git a/mistral_lib/actions/context.py b/mistral_lib/actions/context.py
index fbde99b..fa22fe8 100644
--- a/mistral_lib/actions/context.py
+++ b/mistral_lib/actions/context.py
@@ -49,7 +49,7 @@ class SecurityContext(object):
                  service_catalog=None, region_name=None, is_trust_scoped=None,
                  redelivered=None, expires_at=None, trust_id=None,
                  is_target=None, project_id=None, project_name=None,
-                 user_name=None, auth_token=None):
+                 user_name=None, auth_token=None, user_id=None, roles=None):
         self.auth_uri = auth_uri
         self.auth_cacert = auth_cacert
         self.insecure = insecure
@@ -64,6 +64,8 @@ class SecurityContext(object):
         self.project_name = project_name
         self.user_name = user_name
         self.auth_token = auth_token
+        self.user_id = user_id
+        self.roles = list(roles) if roles else []
 
 
 class ExecutionContext(object):
@@ -71,7 +73,8 @@ class ExecutionContext(object):
                  action_execution_id=None, workflow_name=None,
                  callback_url=None, task_id=None, with_items_index=0,
                  task_rerun_no=0, task_rerun_id=None,
-                 workflow_propagated_headers=None):
+                 workflow_propagated_headers=None,
+                 workflow_resume_authorization=None):
         self.workflow_execution_id = workflow_execution_id
         self.task_execution_id = task_execution_id
         self.action_execution_id = action_execution_id
@@ -81,6 +84,10 @@ class ExecutionContext(object):
         self.task_rerun_no = task_rerun_no
         self.task_rerun_id = task_rerun_id
         self.workflow_propagated_headers = workflow_propagated_headers
+        self.workflow_resume_authorization = (
+            dict(workflow_resume_authorization)
+            if workflow_resume_authorization else None
+        )
 
         if task_id is not None:
             self.task_execution_id = task_id
diff --git a/mistral_lib/tests/actions/test_context.py b/mistral_lib/tests/actions/test_context.py
index c2d00a1..e74c8e6 100644
--- a/mistral_lib/tests/actions/test_context.py
+++ b/mistral_lib/tests/actions/test_context.py
@@ -43,6 +43,45 @@ def _fake_context():
 
 class TestActionsBase(tests_base.TestCase):
 
+    def test_security_context_carries_exact_roles_defensively(self):
+        roles = ['admin', 'powerops_operator']
+        security = context.SecurityContext(user_id='user-id', roles=roles)
+        roles.append('forged')
+        self.assertEqual('user-id', security.user_id)
+        self.assertEqual(['admin', 'powerops_operator'], security.roles)
+
+    def test_security_context_preserves_legacy_positional_arguments(self):
+        values = [
+            'auth-uri', 'auth-cacert', 'insecure', 'service-catalog',
+            'region-name', 'is-trust-scoped', 'redelivered', 'expires-at',
+            'trust-id', 'is-target', 'project-id', 'project-name',
+            'user-name', 'auth-token'
+        ]
+        security = context.SecurityContext(*values)
+
+        for name, value in zip([
+            'auth_uri', 'auth_cacert', 'insecure', 'service_catalog',
+            'region_name', 'is_trust_scoped', 'redelivered', 'expires_at',
+            'trust_id', 'is_target', 'project_id', 'project_name',
+            'user_name', 'auth_token'
+        ], values):
+            self.assertEqual(value, getattr(security, name))
+
+    def test_execution_context_copies_resume_authorization(self):
+        record = {
+            'user_id': 'u',
+            'project_id': 'p',
+            'authorization_branch': 'admin',
+            'authorized_at': '2026-09-02T10:00:00+00:00',
+        }
+        execution = context.ExecutionContext(
+            workflow_resume_authorization=record,
+        )
+        record['authorization_branch'] = 'forged'
+        self.assertEqual('admin', execution.workflow_resume_authorization[
+            'authorization_branch'
+        ])
+
     def test_empty_context(self):
         ctx = context.ActionContext(
             context.SecurityContext(),
@@ -74,6 +113,15 @@ class TestActionsBase(tests_base.TestCase):
 
 class TestActionContextSerializer(tests_base.TestCase):
 
+    def test_deserializes_legacy_payload_without_powerops_fields(self):
+        restored = context.ActionContextSerializer().deserialize_from_dict({
+            'security': {'project_id': 'legacy-project'},
+            'execution': {'workflow_execution_id': 'legacy-execution'},
+        })
+        self.assertIsNone(restored.security.user_id)
+        self.assertEqual([], restored.security.roles)
+        self.assertIsNone(restored.execution.workflow_resume_authorization)
+
     def test_serialization(self):
         ctx = _fake_context()
 
-- 
2.49.0

