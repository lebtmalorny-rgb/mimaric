+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+import datetime
+from unittest import mock
+
+from oslo_config import cfg
+import oslo_messaging
+
+from mistral.db.v2 import api as db_api
+from mistral.db.v2.sqlalchemy import models
+from mistral import exceptions as exc
+from mistral.rpc import base as rpc_base
+from mistral.rpc import clients as rpc_clients
+from mistral.services import powerops
+from mistral.tests.unit.api import base
+from mistral.workflow import states
+
+
+# This line is needed for correct initialization of messaging config.
+oslo_messaging.get_rpc_transport(cfg.CONF)
+
+
+POWEROPS_WF_ID = '1b5c8fa3-26b6-4de6-93e2-d9e7e5482301'
+ORDINARY_WF_ID = 'aa9b8dd0-5b47-4db5-bf68-c91615df7f10'
+EXECUTION_ID = 'f3bb9549-6c8b-4540-b310-6f71371b69d0'
+
+
+def _workflow_definition(workflow_id=POWEROPS_WF_ID,
+                         name='power_ops.planned_power_off',
+                         scope='public'):
+    return models.WorkflowDefinition(
+        id=workflow_id,
+        name=name,
+        namespace='',
+        scope=scope,
+        project_id='workflow-owner-project',
+    )
+
+
+def _execution_result(workflow_id=POWEROPS_WF_ID,
+                      workflow_name='power_ops.planned_power_off'):
+    return models.WorkflowExecution(
+        id=EXECUTION_ID,
+        workflow_name=workflow_name,
+        workflow_id=workflow_id,
+        description='',
+        spec={'name': workflow_name},
+        state=states.RUNNING,
+        context={},
+        input={},
+        output={},
+        params={},
+        created_at=datetime.datetime(1970, 1, 1),
+        updated_at=datetime.datetime(1970, 1, 1),
+    ).to_dict()
+
+
+@mock.patch.object(rpc_base, '_IMPL_CLIENT', mock.Mock())
+class PowerOpsExecutionStartTest(base.APITest):
+
+    def setUp(self):
+        super(PowerOpsExecutionStartTest, self).setUp()
+
+        self.override_config(
+            'allowed_project_names', ['operations'], 'powerops'
+        )
+        self.override_config(
+            'allowed_user_names', ['powerops-operator'], 'powerops'
+        )
+        self.ctx.project_name = 'operations'
+        self.ctx.user_name = 'powerops-operator'
+        self.ctx.user_id = 'powerops-user-id'
+        self.ctx.roles = ['powerops_operator']
+
+    @staticmethod
+    def _body(identifier=POWEROPS_WF_ID, by_id=True,
+              workflow_input=None, env=None):
+        body = {
+            'input': workflow_input or {},
+            'params': {'env': env or {}},
+        }
+        body['workflow_id' if by_id else 'workflow_name'] = identifier
+
+        return body
+
+    @mock.patch.object(rpc_clients.EngineClient, 'start_workflow')
+    @mock.patch.object(powerops, 'authorize')
+    @mock.patch.object(powerops, 'reject_reserved_auth_fields')
+    @mock.patch.object(db_api, 'get_workflow_definition')
+    def test_powerops_definition_is_resolved_and_checked_before_rpc(
+            self, get_definition, reject_reserved, authorize,
+            start_workflow):
+        events = []
+        workflow_input = {
+            'host': 'compute-01',
+            'allow_hard_off': True,
+        }
+        env = {'request_id': 'request-1'}
+        get_definition.side_effect = lambda *args, **kwargs: (
+            events.append('resolve'), _workflow_definition()
+        )[1]
+        reject_reserved.side_effect = (
+            lambda *args, **kwargs: events.append('reject-reserved')
+        )
+        authorize.side_effect = (
+            lambda *args, **kwargs: events.append('authorize') or 'admin'
+        )
+        start_workflow.side_effect = lambda *args, **kwargs: (
+            events.append('start-rpc'), _execution_result()
+        )[1]
+
+        response = self.app.post_json(
+            '/v2/executions',
+            self._body(
+                workflow_input=workflow_input,
+                env=env,
+            ),
+        )
+
+        self.assertEqual(201, response.status_int)
+        self.assertEqual(
+            ['resolve', 'reject-reserved', 'authorize', 'start-rpc'],
+            events,
+        )
+        get_definition.assert_called_once_with(POWEROPS_WF_ID, '')
+        reject_reserved.assert_called_once_with(workflow_input, env)
+        authorize.assert_called_once_with(
+            self.ctx,
+            allow_hard_off=True,
+        )
+
+    @mock.patch.object(rpc_clients.EngineClient, 'start_workflow')
+    @mock.patch.object(powerops, 'authorize', return_value='admin')
+    @mock.patch.object(powerops, 'reject_reserved_auth_fields')
+    @mock.patch.object(db_api, 'get_workflow_definition')
+    def test_powerops_definition_lookup_accepts_name_and_uuid(
+            self, get_definition, reject_reserved, authorize,
+            start_workflow):
+        start_workflow.return_value = _execution_result()
+
+        cases = (
+            (POWEROPS_WF_ID, True),
+            ('power_ops.planned_power_off', False),
+        )
+
+        for identifier, by_id in cases:
+            with self.subTest(identifier=identifier):
+                get_definition.return_value = _workflow_definition()
+
+                response = self.app.post_json(
+                    '/v2/executions',
+                    self._body(identifier=identifier, by_id=by_id),
+                )
+
+                self.assertEqual(201, response.status_int)
+                get_definition.assert_called_once_with(identifier, '')
+                reject_reserved.assert_called_once_with({}, {})
+                authorize.assert_called_once_with(
+                    self.ctx,
+                    allow_hard_off=False,
+                )
+                get_definition.reset_mock()
+                reject_reserved.reset_mock()
+                authorize.reset_mock()
+                start_workflow.reset_mock()
+
+    @mock.patch.object(rpc_clients.EngineClient, 'start_workflow')
+    @mock.patch.object(db_api, 'get_workflow_definition')
+    def test_public_powerops_definition_uses_exact_role_matrix(
+            self, get_definition, start_workflow):
+        get_definition.return_value = _workflow_definition(scope='public')
+        start_workflow.return_value = _execution_result()
+        cases = (
+            (['admin'], 'other-project', 'other-user', True, 201),
+            (['admin', 'powerops_operator'], 'other-project', 'other-user',
+             True, 201),
+            (['powerops_operator'], 'operations', 'powerops-operator',
+             False, 201),
+            (['powerops_operator'], 'operations', 'powerops-operator',
+             True, 403),
+            (['powerops_operator'], 'Operations', 'powerops-operator',
+             False, 403),
+            (['powerops_operator'], 'operations', 'PowerOps-Operator',
+             False, 403),
+            (['member'], 'operations', 'powerops-operator', False, 403),
+            (['Admin'], 'operations', 'powerops-operator', False, 403),
+        )
+
+        for roles, project_name, user_name, hard_off, expected_status in cases:
+            with self.subTest(
+                    roles=roles,
+                    project_name=project_name,
+                    user_name=user_name,
+                    hard_off=hard_off):
+                self.ctx.roles = roles
+                self.ctx.project_name = project_name
+                self.ctx.user_name = user_name
+
+                response = self.app.post_json(
+                    '/v2/executions',
+                    self._body(
+                        workflow_input={'allow_hard_off': hard_off},
+                    ),
+                    expect_errors=expected_status != 201,
+                )
+
+                self.assertEqual(expected_status, response.status_int)
+
+                if expected_status == 201:
+                    start_workflow.assert_called_once()
+                else:
+                    start_workflow.assert_not_called()
+
+                start_workflow.reset_mock()
+
+    @mock.patch.object(rpc_clients.EngineClient, 'start_workflow')
+    @mock.patch.object(db_api, 'get_workflow_definition')
+    def test_powerops_reserved_or_malformed_fields_fail_before_rpc(
+            self, get_definition, start_workflow):
+        get_definition.return_value = _workflow_definition()
+        cases = (
+            ({'roles': ['admin']}, {}, 400),
+            ({}, {'authorization_branch': 'admin'}, 400),
+            (['not-a-mapping'], {}, 400),
+        )
+
+        for workflow_input, env, expected_status in cases:
+            with self.subTest(workflow_input=workflow_input, env=env):
+                response = self.app.post_json(
+                    '/v2/executions',
+                    self._body(workflow_input=workflow_input, env=env),
+                    expect_errors=True,
+                )
+
+                self.assertEqual(expected_status, response.status_int)
+                start_workflow.assert_not_called()
+
+    @mock.patch.object(rpc_clients.EngineClient, 'start_workflow')
+    @mock.patch.object(db_api, 'get_workflow_definition')
+    @mock.patch.object(powerops, 'authorize')
+    @mock.patch.object(powerops, 'reject_reserved_auth_fields')
+    def test_unknown_workflow_is_not_classified_from_caller_name(
+            self, reject_reserved, authorize, get_definition,
+            start_workflow):
+        get_definition.side_effect = exc.DBEntityNotFoundError(
+            'Workflow not found'
+        )
+        start_workflow.return_value = _execution_result(
+            workflow_id=ORDINARY_WF_ID,
+            workflow_name='power_ops.not_registered',
+        )
+
+        response = self.app.post_json(
+            '/v2/executions',
+            self._body(identifier='power_ops.not_registered', by_id=False),
+        )
+
+        self.assertEqual(201, response.status_int)
+        reject_reserved.assert_not_called()
+        authorize.assert_not_called()
+        start_workflow.assert_called_once()
+
+    @mock.patch.object(rpc_clients.EngineClient, 'start_workflow')
+    @mock.patch.object(powerops, 'authorize')
+    @mock.patch.object(powerops, 'reject_reserved_auth_fields')
+    @mock.patch.object(db_api, 'get_workflow_definition')
+    def test_ordinary_workflow_retains_start_behavior(
+            self, get_definition, reject_reserved, authorize,
+            start_workflow):
+        ordinary_definition = _workflow_definition(
+            workflow_id=ORDINARY_WF_ID,
+            name='ordinary.workflow',
+            scope='private',
+        )
+        get_definition.return_value = ordinary_definition
+        start_workflow.return_value = _execution_result(
+            workflow_id=ORDINARY_WF_ID,
+            workflow_name='ordinary.workflow',
+        )
+        self.ctx.roles = ['member']
+
+        response = self.app.post_json(
+            '/v2/executions',
+            self._body(identifier=ORDINARY_WF_ID),
+        )
+
+        self.assertEqual(201, response.status_int)
+        reject_reserved.assert_not_called()
+        authorize.assert_not_called()
+        start_workflow.assert_called_once()
