+
+        try:
+            wf_def = db_api.get_workflow_definition(
+                wf_identifier,
+                wf_namespace,
+            )
+        except exc.DBEntityNotFoundError:
+            # Preserve the generic start path and its authoritative engine
+            # error for unknown definitions. Most importantly, never infer a
+            # privileged PowerOps workflow from a caller-provided name.
+            wf_def = None
+
+        if wf_def and wf_def.name in powerops.POWEROPS_WORKFLOW_NAMES:
