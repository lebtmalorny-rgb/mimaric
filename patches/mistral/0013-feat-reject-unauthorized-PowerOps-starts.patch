diff --git a/mistral/tests/unit/api/v2/test_executions_powerops.py b/mistral/tests/unit/api/v2/test_executions_powerops.py
new file mode 100644
index 00000000..15b728c6
--- /dev/null
+++ b/mistral/tests/unit/api/v2/test_executions_powerops.py
@@ -0,0 +1,302 @@
+# Copyright 2026 OpenStack Foundation
