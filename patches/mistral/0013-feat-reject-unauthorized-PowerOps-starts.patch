+            env = params.get('env') if isinstance(params, dict) else None
+
+            powerops.reject_reserved_auth_fields(workflow_input, env)
+            powerops.authorize(
+                context.ctx(),
+                allow_hard_off=(workflow_input or {}).get(
+                    'allow_hard_off', False
+                ),
+            )
+
         engine = rpc.get_engine_client()
 
