+from mistral.tests.unit.actions.powerops import fakes
+from mistral.tests.unit import base
+
+
+class PlannedPowerActionsTest(base.BaseTest):
+    def setUp(self):
+        super(PlannedPowerActionsTest, self).setUp()
+
+        self.override_config('enabled', True, 'powerops')
+        self.override_config(
+            'allowed_project_names', ['operations'], 'powerops'
+        )
+        self.override_config(
+            'allowed_user_names', ['powerops-operator'], 'powerops'
+        )
+
+    @staticmethod
+    def _coordinator(events, health_side_effect=None):
+        coordinator = fakes.recording_coordinator(events)
+        coordinator.assert_healthy = mock.Mock(
+            side_effect=health_side_effect
+        )
+
+        return coordinator
+
+    @staticmethod
+    def _successful_cloud(cloud):
+        cloud.resolve_host_set.return_value = None
+        cloud.set_masakari_maintenance.return_value = None
+        cloud.disable_nova.return_value = None
+        cloud.apply_instance_policy.return_value = []
+        cloud.assert_host_safe_for_power_off.return_value = None
+        cloud.power_off.return_value = fakes.node(
+            'n1', 'compute-01', 'power off'
+        )
+        cloud.power_on.return_value = fakes.node(
+            'n1', 'compute-01', 'power on'
+        )
+        cloud.wait_nova_service.return_value = None
+        cloud.start_instances.return_value = None
+        cloud.enable_nova.return_value = None
+
+    @mock.patch.object(planned.coordination, 'OperationCoordinator')
+    @mock.patch.object(planned.clients, 'connection_from_conf')
+    def test_disabled_action_stops_before_coordination_or_auth(
+            self, connection_from_conf, coordinator_cls):
+        self.override_config('enabled', False, 'powerops')
+        action = planned.PlannedPowerOffAction(
+            'compute-01', 'segment-1'
+        )
+
+        self.assertRaises(
+            exceptions.PowerOpsDisabled,
+            action.run,
+            fakes.action_context('execution-disabled'),
+        )
+        coordinator_cls.assert_not_called()
+        connection_from_conf.assert_not_called()
+
+    @mock.patch.object(planned.coordination, 'OperationCoordinator')
+    @mock.patch.object(planned.clients, 'connection_from_conf')
+    def test_empty_allowlists_deny_all_callers(
+            self, connection_from_conf, coordinator_cls):
+        self.override_config('allowed_project_names', [], 'powerops')
+        self.override_config('allowed_user_names', [], 'powerops')
+        action = planned.PlannedPowerOffAction(
+            'compute-01', 'segment-1'
+        )
+
+        self.assertRaises(
+            exceptions.PowerOpsUnauthorized,
+            action.run,
+            fakes.action_context('execution-empty-allowlists'),
+        )
+        coordinator_cls.assert_not_called()
+        connection_from_conf.assert_not_called()
+
+    @mock.patch.object(planned.coordination, 'OperationCoordinator')
+    @mock.patch.object(planned.clients, 'connection_from_conf')
+    def test_authorization_uses_both_exact_caller_names(
+            self, connection_from_conf, coordinator_cls):
+        callers = (
+            ('Operations', 'powerops-operator'),
+            ('operations-team', 'powerops-operator'),
+            ('operations', 'PowerOps-Operator'),
+            ('operations', 'powerops-operator-2'),
+        )
+
+        for index, (project_name, user_name) in enumerate(callers):
+            action = planned.PlannedPowerOffAction(
+                'compute-01', 'segment-1'
+            )
+            context = fakes.action_context(
+                'execution-{}'.format(index),
+                project_name=project_name,
+                user_name=user_name,
+            )
+
+            self.assertRaises(
+                exceptions.PowerOpsUnauthorized, action.run, context
+            )
+
+        coordinator_cls.assert_not_called()
+        connection_from_conf.assert_not_called()
+
+    @mock.patch.object(planned.coordination, 'OperationCoordinator')
+    @mock.patch.object(planned.clients, 'CloudClients')
+    @mock.patch.object(planned.clients, 'connection_from_conf')
+    def test_power_off_keeps_one_lock_for_complete_transition(
+            self, connection_from_conf, cloud_cls, coordinator_cls):
+        events = []
+        coordinator = self._coordinator(
+            events,
+            health_side_effect=lambda: events.append('return-health'),
+        )
+        coordinator_cls.return_value = coordinator
+        connection = object()
+        cloud = mock.Mock(unsafe=True)
+        self._successful_cloud(cloud)
+
+        connection_from_conf.side_effect = lambda: (
+            events.append('connection'), connection
+        )[1]
+
+        def make_cloud(received_connection, health_check=None):
+            self.assertIs(connection, received_connection)
+            self.assertIs(coordinator.assert_healthy, health_check)
+            events.append('cloud-clients')
+
+            return cloud
+
+        cloud_cls.side_effect = make_cloud
+        cloud.resolve_host_set.side_effect = (
+            lambda *args: events.append('resolve')
+        )
+        cloud.set_masakari_maintenance.side_effect = (
+            lambda *args: events.append('maintenance-true')
+        )
+        cloud.disable_nova.side_effect = (
+            lambda *args: events.append('nova-disable')
+        )
+        cloud.apply_instance_policy.side_effect = lambda *args: (
+            events.append('instances-stop'), ['vm-a']
+        )[1]
+        cloud.assert_host_safe_for_power_off.side_effect = (
+            lambda *args: events.append('safety-guard')
+        )
+        cloud.power_off.side_effect = lambda *args: (
+            events.append('power-off'),
+            fakes.node('n1', 'compute-01', 'power off'),
+        )[1]
+        action = planned.PlannedPowerOffAction(
+            'compute-01', 'segment-1', 'stop', False
+        )
+        action._audit = mock.Mock(
+            side_effect=lambda *args: events.append('audit-success')
+        )
+
+        result = action.run(fakes.action_context('execution-off'))
+
+        self.assertEqual(
+            [
+                'coordinator-start',
+                'host-lock-enter',
+                'connection',
+                'cloud-clients',
+                'resolve',
+                'maintenance-true',
+                'nova-disable',
+                'instances-stop',
+                'safety-guard',
+                'power-off',
+                'audit-success',
+                'return-health',
+                'host-lock-exit',
+                'coordinator-stop',
+            ],
+            events,
+        )
+        self.assertEqual(
+            {
+                'host': 'compute-01',
+                'operation': 'planned_power_off',
+                'power_state': 'power off',
+                'stopped_instance_ids': ['vm-a'],
+                'nova_enabled': False,
+                'masakari_maintenance': True,
+            },
+            result,
+        )
+        cloud.assert_host_safe_for_power_off.assert_called_once_with(
+            'compute-01', 'stop', ['vm-a']
+        )
+
+    @mock.patch.object(planned.coordination, 'OperationCoordinator')
+    @mock.patch.object(planned.clients, 'CloudClients')
+    @mock.patch.object(planned.clients, 'connection_from_conf')
+    def test_disable_failure_reasserts_state_inside_lock(
+            self, connection_from_conf, cloud_cls, coordinator_cls):
+        events = []
+        coordinator_cls.return_value = self._coordinator(events)
+        cloud = mock.Mock(unsafe=True)
+        cloud_cls.return_value = cloud
+        original = exceptions.PowerStateError('disable outcome unknown')
+        cloud.resolve_host_set.return_value = None
+        cloud.set_masakari_maintenance.side_effect = (
+            lambda *args: events.append('maintenance-true')
+        )
+        disable_outcomes = iter((original, None))
+
+        def disable(*args):
+            events.append('nova-disable')
+            outcome = next(disable_outcomes)
+
+            if outcome is not None:
+                raise outcome
+
+        cloud.disable_nova.side_effect = disable
+        action = planned.PlannedPowerOffAction(
+            'compute-01', 'segment-1'
+        )
+        action._audit = mock.Mock(
+            side_effect=lambda *args: events.append('audit-failure')
+        )
+
+        raised = self.assertRaises(
+            exceptions.PowerStateError,
+            action.run,
+            fakes.action_context('execution-disable-failure'),
+        )
+
+        self.assertIs(original, raised)
+        self.assertEqual(
+            [
+                'coordinator-start',
+                'host-lock-enter',
+                'maintenance-true',
+                'nova-disable',
+                'maintenance-true',
+                'nova-disable',
+                'audit-failure',
+                'host-lock-exit',
+                'coordinator-stop',
+            ],
+            events,
+        )
+
+    @mock.patch.object(planned.coordination, 'OperationCoordinator')
+    @mock.patch.object(planned.clients, 'CloudClients')
+    @mock.patch.object(planned.clients, 'connection_from_conf')
+    def test_fail_safe_errors_do_not_hide_original_or_leak_secrets(
+            self, connection_from_conf, cloud_cls, coordinator_cls):
+        events = []
+        coordinator_cls.return_value = self._coordinator(events)
+        cloud = mock.Mock(unsafe=True)
+        cloud_cls.return_value = cloud
+        original = exceptions.PowerStateError('api-token=original-secret')
+        cloud.resolve_host_set.return_value = None
+        cloud.set_masakari_maintenance.side_effect = (
+            None,
+            RuntimeError('password=maintenance-secret'),
+        )
+        cloud.disable_nova.side_effect = (
+            None,
+            RuntimeError('token=nova-secret'),
+        )
+        cloud.apply_instance_policy.return_value = []
+        cloud.assert_host_safe_for_power_off.return_value = None
+        cloud.power_off.side_effect = original
+        action = planned.PlannedPowerOffAction(
+            'compute-01', 'segment-1'
+        )
+        action._audit = mock.Mock()
+        context = fakes.action_context('execution-secret-failure')
+
+        raised = self.assertRaises(
+            exceptions.PowerStateError, action.run, context
+        )
+
+        self.assertIs(original, raised)
+        action._audit.assert_called_once_with(
+            context,
+            'planned_power_off',
+            'failure',
+            {
+                'error_type': 'PowerStateError',
+                'fail_safe_error_count': 2,
+            },
+        )
+        audit_details = action._audit.call_args.args[3]
+        self.assertNotIn('secret', repr(audit_details))
+
+    @mock.patch.object(planned.coordination, 'OperationCoordinator')
+    @mock.patch.object(planned.clients, 'CloudClients')
+    @mock.patch.object(planned.clients, 'connection_from_conf')
+    def test_success_audit_failure_enters_same_fail_safe_path(
+            self, connection_from_conf, cloud_cls, coordinator_cls):
+        events = []
+        coordinator_cls.return_value = self._coordinator(events)
+        cloud = mock.Mock(unsafe=True)
+        cloud_cls.return_value = cloud
+        self._successful_cloud(cloud)
+        audit_error = RuntimeError('audit unavailable')
+        action = planned.PlannedPowerOffAction(
+            'compute-01', 'segment-1'
+        )
+        action._audit = mock.Mock(side_effect=(audit_error, None))
+        context = fakes.action_context('execution-audit-failure')
+
+        raised = self.assertRaises(
+            RuntimeError, action.run, context
+        )
+
+        self.assertIs(audit_error, raised)
+        self.assertEqual(2, cloud.set_masakari_maintenance.call_count)
+        self.assertEqual(2, cloud.disable_nova.call_count)
+        self.assertEqual(
+            mock.call(
+                context,
+                'planned_power_off',
+                'failure',
+                {
+                    'error_type': 'RuntimeError',
+                    'fail_safe_error_count': 0,
+                },
+            ),
+            action._audit.call_args_list[-1],
+        )
+
+    @mock.patch.object(planned.coordination, 'OperationCoordinator')
+    @mock.patch.object(planned.clients, 'CloudClients')
+    @mock.patch.object(planned.clients, 'connection_from_conf')
+    def test_reboot_restarts_only_its_stop_manifest(
+            self, connection_from_conf, cloud_cls, coordinator_cls):
+        events = []
+        coordinator_cls.return_value = self._coordinator(events)
+        cloud = mock.Mock(unsafe=True)
+        cloud_cls.return_value = cloud
+        self._successful_cloud(cloud)
+        cloud.apply_instance_policy.return_value = ['vm-b', 'vm-a']
+        action = planned.PlannedRebootAction(
+            'compute-01', 'segment-1', 'stop', False
+        )
+
+        result = action.run(fakes.action_context('execution-reboot'))
+
+        cloud.assert_host_safe_for_power_off.assert_called_once_with(
+            'compute-01', 'stop', ['vm-b', 'vm-a']
+        )
+        cloud.start_instances.assert_called_once_with(['vm-b', 'vm-a'])
+        self.assertEqual(['vm-b', 'vm-a'], result['stopped_instance_ids'])
+        self.assertEqual('planned_reboot', result['operation'])
+        self.assertEqual('power on', result['power_state'])
+        self.assertTrue(result['nova_enabled'])
+        self.assertFalse(result['masakari_maintenance'])
+
+    @mock.patch.object(planned.coordination, 'OperationCoordinator')
+    @mock.patch.object(planned.clients, 'CloudClients')
+    @mock.patch.object(planned.clients, 'connection_from_conf')
+    def test_reboot_power_on_failure_reasserts_safe_service_state(
+            self, connection_from_conf, cloud_cls, coordinator_cls):
+        events = []
+        coordinator_cls.return_value = self._coordinator(events)
+        cloud = mock.Mock(unsafe=True)
+        cloud_cls.return_value = cloud
+        self._successful_cloud(cloud)
+        cloud.set_masakari_maintenance.side_effect = lambda *args: (
+            events.append('maintenance-{}'.format(args[-1]))
+        )
+        cloud.disable_nova.side_effect = (
+            lambda *args: events.append('nova-disable')
+        )
+        original = exceptions.PowerStateError('power on failed')
+        cloud.power_on.side_effect = original
+        action = planned.PlannedRebootAction(
+            'compute-01', 'segment-1', 'require_empty', False
+        )
+
+        raised = self.assertRaises(
+            exceptions.PowerStateError,
+            action.run,
+            fakes.action_context('execution-reboot-failure'),
+        )
+
+        self.assertIs(original, raised)
+        state_events = [
+            event for event in events
+            if event.startswith(('maintenance-', 'nova-'))
+        ]
+        self.assertEqual(
