+
+    def test_legacy_provider_discovers_catalogue_ready_powerops_actions(self):
+        self.override_config(
+            'load_action_plugins',
+            True,
+            'legacy_action_provider'
+        )
+        self.override_config(
+            'load_action_generators',
+            False,
+            'legacy_action_provider'
+        )
+
+        provider = legacy.LegacyActionProvider()
+        action_descs = {
+            action_desc.name: action_desc
+            for action_desc in provider.find_all()
+            if action_desc.name.startswith('powerops.')
+        }
+
+        self.assertEqual(set(EXPECTED_ACTIONS), set(action_descs))
+
+        for name, expected_class in EXPECTED_ACTIONS.items():
+            with self.subTest(action=name):
+                action_desc = action_descs[name]
+
+                self.assertIsInstance(
+                    action_desc,
+                    ml_actions.PythonActionDescriptor
+                )
+                self.assertIs(expected_class, action_desc.action_class)
+                self.assertEqual(
+                    EXPECTED_PARAMS_SPECS[name],
+                    action_desc.params_spec
+                )
