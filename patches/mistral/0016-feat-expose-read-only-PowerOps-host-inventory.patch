@@ -389,6 +387,446 @@ class CloudClients:
 
         return matches[0]
 
+    @classmethod
+    def _masakari_page_marker(cls, item, description):
+        if not isinstance(item, dict):
+            raise exceptions.HostResolutionError(
+                '{} entry must be a mapping'.format(description)
+            )
+
+        marker = item.get('id')
+
+        if marker is None:
+            marker = item.get('uuid')
+
+        if isinstance(marker, bool):
+            marker = None
+        elif isinstance(marker, int):
+            marker = str(marker) if marker > 0 else None
+
+        try:
+            cls._validate_resource_id(marker, '{} marker'.format(description))
+        except exceptions.HostResolutionError:
+            raise exceptions.HostResolutionError(
+                '{} marker is invalid'.format(description)
+            ) from None
+
+        return marker
+
+    @classmethod
+    def _validate_masakari_page_links(
+            cls, body, collection, path, expected_marker):
+        if 'next' in body or 'next_marker' in body:
+            raise exceptions.HostResolutionError(
+                'Masakari pagination data is invalid'
+            )
+
+        link_keys = [
+            key for key in ('{}_links'.format(collection), 'links')
+            if key in body
+        ]
+
+        if len(link_keys) > 1:
+            raise exceptions.HostResolutionError(
+                'Masakari pagination data is ambiguous'
+            )
+
+        if not link_keys:
+            return
+
+        links = body[link_keys[0]]
+
+        if not isinstance(links, list):
+            raise exceptions.HostResolutionError(
+                'Masakari pagination links must be a list'
+            )
+
+        next_links = []
+
+        for link in links:
+            if (
+                    not isinstance(link, dict)
+                    or not isinstance(link.get('rel'), str)):
+                raise exceptions.HostResolutionError(
+                    'Masakari pagination link is invalid'
+                )
+
+            if link['rel'] == 'next':
+                next_links.append(link)
+
+        if len(next_links) > 1:
+            raise exceptions.HostResolutionError(
+                'Masakari pagination next link is ambiguous'
+            )
+
+        if not next_links:
+            return
+
+        href = next_links[0].get('href')
+
+        if not isinstance(href, str) or not href:
+            raise exceptions.HostResolutionError(
+                'Masakari pagination next link is invalid'
+            )
+
+        parsed = urlparse.urlsplit(href)
+
+        if (
+                parsed.scheme
+                or parsed.netloc
+                or parsed.fragment
+                or parsed.path not in ('', path)):
+            raise exceptions.HostResolutionError(
+                'Masakari pagination next target is unsafe'
+            )
+
+        try:
+            query = urlparse.parse_qs(
+                parsed.query,
+                keep_blank_values=True,
+                strict_parsing=True,
+                max_num_fields=2,
+            )
+        except ValueError:
+            raise exceptions.HostResolutionError(
+                'Masakari pagination next query is invalid'
+            ) from None
+
+        if (
+                set(query) != {'limit', 'marker'}
+                or len(query['limit']) != 1
+                or query['limit'][0] != str(_MASAKARI_PAGE_LIMIT)
+                or len(query['marker']) != 1
+                or query['marker'][0] != expected_marker):
+            raise exceptions.HostResolutionError(
+                'Masakari pagination next query is invalid'
+            )
+
+    def _list_masakari_collection(
+            self, path, collection, deadline, description):
+        result = []
+        marker = None
+        seen_markers = set()
+
+        while True:
+            params = {'limit': _MASAKARI_PAGE_LIMIT}
+
+            if marker is not None:
+                params['marker'] = marker
+
+            body = self._call_with_deadline(
+                lambda params=params: self.ha_adapter.get(
+                    path, params=params
+                ).json(),
+                deadline,
+                description,
+            )
+
+            if not isinstance(body, dict):
+                raise exceptions.HostResolutionError(
+                    'Masakari {} response must be a mapping'.format(
+                        collection
+                    )
+                )
+
+            entries = body.get(collection)
+
+            if not isinstance(entries, list):
+                raise exceptions.HostResolutionError(
+                    'Masakari {0} response must contain a {0} list'.format(
+                        collection
+                    )
+                )
+
+            next_marker = None
+
+            if entries:
+                next_marker = self._masakari_page_marker(
+                    entries[-1], 'Masakari {}'.format(collection)
+                )
+
+            self._validate_masakari_page_links(
+                body, collection, path, next_marker
+            )
+
+            if not entries:
+                return result
+
+            if next_marker in seen_markers:
+                raise exceptions.HostResolutionError(
+                    'Masakari pagination marker repeated'
+                )
+
+            seen_markers.add(next_marker)
+            result.extend(entries)
+            marker = next_marker
+
+    def _list_masakari_inventory(self, deadline):
+        segment_entries = self._list_masakari_collection(
+            '/segments',
+            'segments',
+            deadline,
+            'timed out listing Masakari segments',
+        )
+
+        result = []
+
+        for segment_entry in segment_entries:
+            if not isinstance(segment_entry, dict):
+                raise exceptions.HostResolutionError(
+                    'Masakari segment entry must be a mapping'
+                )
+
+            segment_uuid = self._masakari_identifier(
+                segment_entry, 'Masakari segment UUID'
+            )
+            hosts_url = '/segments/{}/hosts'.format(segment_uuid)
+            host_entries = self._list_masakari_collection(
+                hosts_url,
+                'hosts',
+                deadline,
+                'timed out listing Masakari hosts',
+            )
+
+            result.extend(
+                (segment_uuid, self._masakari_resource(host_entry))
+                for host_entry in host_entries
+            )
+
+        return result
+
+    @staticmethod
+    def _inventory_node_fields(node):
+        node_id = getattr(node, 'id', None)
+        power_state = getattr(node, 'power_state', None)
+        target_power_state = getattr(node, 'target_power_state', None)
+        compatible = (
+            isinstance(node_id, str)
+            and _PATH_RESOURCE_ID_RE.fullmatch(node_id)
+            and getattr(node, 'provision_state', None) == 'manageable'
+            and getattr(node, 'network_interface', None) == 'noop'
+            and not getattr(node, 'last_error', None)
+            and power_state in _KNOWN_POWER_STATES
+            and target_power_state in (None, power_state)
+        )
+
+        return {
+            'ironic_node_uuid': (
+                node_id
+                if isinstance(node_id, str)
+                and _PATH_RESOURCE_ID_RE.fullmatch(node_id)
+                else None
+            ),
+            'power_state': (
+                power_state if power_state in _KNOWN_POWER_STATES else None
+            ),
+            'target_power_state': (
+                target_power_state
+                if target_power_state in _KNOWN_POWER_STATES
+                else None
+            ),
+        }, compatible
+
+    @staticmethod
+    def _inventory_instances(servers):
+        records = []
+        valid = True
+        seen_ids = set()
+
+        for server in servers:
+            server_id = getattr(server, 'id', None)
+            name = getattr(server, 'name', None)
+            project_id = getattr(server, 'project_id', None)
+            status = getattr(server, 'status', None)
+
+            if (
+                    not isinstance(server_id, str)
+                    or not _PATH_RESOURCE_ID_RE.fullmatch(server_id)
+                    or server_id in seen_ids
+                    or not isinstance(name, str)
+                    or not name
+                    or not isinstance(project_id, str)
+                    or not project_id
+                    or not isinstance(status, str)
+                    or not status):
+                valid = False
+                continue
+
+            seen_ids.add(server_id)
+            records.append({
+                'id': server_id,
+                'name': name,
+                'project_id': project_id,
+                'status': status,
+            })
+
+        return sorted(records, key=lambda item: item['id']), valid
+
+    @classmethod
+    def _build_inventory_rows(
+            cls, segments_and_hosts, nodes, services, servers):
+        masakari_host_counts = {}
+
+        for _segment_uuid, masakari_host in segments_and_hosts:
+            masakari_host_counts[masakari_host.name] = (
+                masakari_host_counts.get(masakari_host.name, 0) + 1
+            )
+
+        servers_by_host = {}
+        server_hosts_by_id = {}
+
+        for server in servers:
+            compute_host = getattr(server, 'compute_host', None)
+
+            if (
+                    not isinstance(compute_host, str)
+                    or not coordination.HOST_RE.fullmatch(compute_host)):
+                raise exceptions.InventoryUnavailable(
+                    'PowerOps inventory is unavailable'
+                )
+
+            servers_by_host.setdefault(compute_host, []).append(server)
+            server_id = getattr(server, 'id', None)
+
+            if (
+                    isinstance(server_id, str)
+                    and _PATH_RESOURCE_ID_RE.fullmatch(server_id)):
+                server_hosts_by_id.setdefault(server_id, set()).add(
+                    compute_host
+                )
+
+        duplicate_instance_hosts = set()
+
+        for instance_hosts in server_hosts_by_id.values():
+            if len(instance_hosts) > 1:
+                duplicate_instance_hosts.update(instance_hosts)
+
+        rows = []
+
+        for segment_uuid, masakari_host in segments_and_hosts:
+            host = masakari_host.name
+            matching_services = [
+                service for service in services
+                if (
+                    getattr(service, 'binary', None) == 'nova-compute'
+                    and getattr(service, 'host', None) == host
+                )
+            ]
+            matching_nodes = [
+                node for node in nodes
+                if getattr(node, 'name', None) == host
+            ]
+            host_servers = servers_by_host.get(host, [])
+            instance_records, instance_data_valid = (
+                cls._inventory_instances(host_servers)
+            )
+            row = {
+                'region_name': CONF.powerops.region_name,
+                'segment_uuid': segment_uuid,
+                'host': host,
+                'ironic_node_uuid': None,
+                'power_state': None,
+                'target_power_state': None,
+                'nova_status': None,
+                'nova_state': None,
+                'masakari_maintenance': masakari_host.on_maintenance,
+                'instance_count': len(host_servers),
+                'instances': instance_records,
+                'operable': False,
+                'blocking_reason': None,
+            }
+
+            if masakari_host_counts[host] != 1:
+                row['blocking_reason'] = 'ambiguous_masakari_host'
+            elif not matching_services:
+                row['blocking_reason'] = 'missing_nova_service'
+            elif len(matching_services) != 1:
+                row['blocking_reason'] = 'ambiguous_nova_service'
+            else:
+                service = matching_services[0]
+                service_status = getattr(service, 'status', None)
+                service_state = getattr(service, 'state', None)
+                row['nova_status'] = (
+                    service_status
+                    if service_status in ('enabled', 'disabled')
+                    else None
+                )
+                row['nova_state'] = (
+                    service_state
+                    if service_state in ('up', 'down')
+                    else None
+                )
+
+                if row['nova_status'] is None or row['nova_state'] is None:
+                    row['blocking_reason'] = 'missing_nova_service'
+
+            if row['blocking_reason'] is None:
+                if not matching_nodes:
+                    row['blocking_reason'] = 'missing_ironic_node'
+                elif len(matching_nodes) != 1:
+                    row['blocking_reason'] = 'ambiguous_ironic_node'
+                else:
+                    node_fields, compatible = cls._inventory_node_fields(
+                        matching_nodes[0]
+                    )
+                    row.update(node_fields)
+
+                    if not compatible:
+                        row['blocking_reason'] = (
+                            'ironic_node_incompatible'
+                        )
+
+            if host in duplicate_instance_hosts:
+                row['blocking_reason'] = 'invalid_instance_data'
+            elif (
+                    row['blocking_reason'] is None
+                    and not instance_data_valid):
+                row['blocking_reason'] = 'invalid_instance_data'
+
+            row['operable'] = row['blocking_reason'] is None
+            rows.append(row)
+
+        return sorted(
+            rows,
+            key=lambda row: (row['segment_uuid'], row['host']),
+        )
+
+    def host_inventory(self):
+        try:
+            deadline = self._deadline(CONF.powerops.service_timeout)
+            nodes = self._call_with_deadline(
+                lambda: list(
+                    self.connection.baremetal.nodes(details=True)
+                ),
+                deadline,
+                'timed out listing Ironic nodes',
+            )
+            services = self._call_with_deadline(
+                lambda: list(self.connection.compute.services(
+                    binary='nova-compute'
+                )),
+                deadline,
+                'timed out listing Nova compute services',
+            )
+            servers = self._call_with_deadline(
+                lambda: list(self.connection.compute.servers(
+                    details=True, all_projects=True
+                )),
+                deadline,
+                'timed out listing Nova instances',
+            )
+            segments_and_hosts = self._list_masakari_inventory(deadline)
+
+            return self._build_inventory_rows(
+                segments_and_hosts, nodes, services, servers
+            )
+        except exceptions.InventoryUnavailable:
+            raise
+        except Exception:
+            raise exceptions.InventoryUnavailable(
+                'PowerOps inventory is unavailable'
+            ) from None
+
     def resolve_host_set(self, segment_uuid, host):
         deadline = self._deadline(CONF.powerops.service_timeout)
         node = self.ironic_node(host, _deadline=deadline)
