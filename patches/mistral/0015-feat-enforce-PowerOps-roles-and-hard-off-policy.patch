@@ -28,17 +29,12 @@ LOG = logging.getLogger(__name__)
 class PowerOpsAction(actions.Action):
     """Shared authorization, coordination and fail-safe action template."""
 
-    def _authorize(self, context):
-        security = context.security
-
-        if (
-                security.project_name
-                not in CONF.powerops.allowed_project_names
-                or security.user_name
-                not in CONF.powerops.allowed_user_names):
-            raise exceptions.PowerOpsUnauthorized(
-                'caller is not authorized for PowerOps'
-            )
+    def _authorize(self, context, allow_hard_off=False):
+        return powerops.authorize(
+            context.security,
+            allow_hard_off=allow_hard_off,
+            error_cls=exceptions.PowerOpsUnauthorized,
+        )
 
     def _validate_inputs(self):
         try:
@@ -55,11 +51,20 @@ class PowerOpsAction(actions.Action):
     def _validate_action_context(self, context):
         pass
 
-    def _run_locked(self, context, operation_name, operation):
+    def _run_locked(self, context, operation_name, operation,
+                    allow_hard_off=False):
         if not CONF.powerops.enabled:
             raise exceptions.PowerOpsDisabled()
 
-        self._authorize(context)
+        branch = self._authorize(
+            context,
+            allow_hard_off=allow_hard_off,
+        )
+        self._authorization_branch = branch
+        self._hard_off_authorized = (
+            allow_hard_off is True
+            and branch == powerops.ADMIN_BRANCH
+        )
         self._validate_action_context(context)
         self._validate_inputs()
         execution_id = context.execution.action_execution_id
@@ -147,12 +152,46 @@ class PowerOpsAction(actions.Action):
         return errors
 
     def _audit(self, context, operation, outcome, details):
-        LOG.info(
-            'PowerOps audit operation=%s outcome=%s host=%s '
-            'workflow_execution_id=%s details=%s',
-            operation,
-            outcome,
-            self.host,
-            context.execution.workflow_execution_id,
-            details,
-        )
+        error_type = None
+        fail_safe_error_count = 0
+
+        if isinstance(details, dict):
+            if isinstance(details.get('error_type'), str):
+                error_type = details['error_type']
+
+            if (type(details.get('fail_safe_error_count')) is int
+                    and details['fail_safe_error_count'] >= 0):
+                fail_safe_error_count = details[
+                    'fail_safe_error_count'
+                ]
+
+        audit_record = {
+            'actor_user_id': getattr(
+                context.security, 'user_id', None
+            ),
+            'actor_project_id': getattr(
+                context.security, 'project_id', None
+            ),
+            'authorization_branch': getattr(
+                self, '_authorization_branch', None
+            ),
+            'region_name': CONF.powerops.region_name,
+            'host': self.host,
+            'segment_uuid': self.segment_uuid,
+            'operation': operation,
+            'instance_policy': getattr(self, 'instance_policy', None),
+            'hard_off_authorized': getattr(
+                self, '_hard_off_authorized', False
+            ),
+            'workflow_execution_id': (
+                context.execution.workflow_execution_id
+            ),
+            'action_execution_id': (
+                context.execution.action_execution_id
+            ),
+            'outcome': outcome,
+            'error_type': error_type,
+            'fail_safe_error_count': fail_safe_error_count,
+        }
+
+        LOG.info('PowerOps audit %s', audit_record)
