+from mistral.services import powerops
 from mistral.tests.unit.actions.powerops import fakes
 from mistral.tests.unit import base
 
@@ -96,6 +97,244 @@ class PlannedPowerActionsTest(base.BaseTest):
         cloud.start_instances.return_value = None
         cloud.enable_nova.return_value = None
 
+    @mock.patch.object(planned.coordination, 'OperationCoordinator')
+    @mock.patch.object(planned.clients, 'connection_from_conf')
+    def test_planned_actions_authorize_before_external_objects(
+            self, connection_from_conf, coordinator_cls):
+        actions = (
+            planned.PlannedPowerOffAction(
+                'compute-01', 'segment-1', allow_hard_off=False
+            ),
+            planned.PlannedRebootAction(
+                'compute-01', 'segment-1', allow_hard_off=False
+            ),
+        )
+
+        for action in actions:
+            with self.subTest(action=type(action).__name__):
+                self.assertRaises(
+                    exceptions.PowerOpsUnauthorized,
+                    action.run,
+                    fakes.action_context(
+                        'execution-unauthorized-{}'.format(
+                            type(action).__name__
+                        ),
+                        roles=['member'],
+                    ),
+                )
+
+                coordinator_cls.assert_not_called()
+                connection_from_conf.assert_not_called()
+
+    @mock.patch.object(planned.coordination, 'OperationCoordinator')
+    @mock.patch.object(planned.clients, 'connection_from_conf')
+    def test_planned_actions_pass_exact_hard_off_to_shared_authorizer(
+            self, connection_from_conf, coordinator_cls):
+        action_cases = (
+            (
+                planned.PlannedPowerOffAction(
+                    'compute-01', 'segment-1', allow_hard_off=False
+                ),
+                False,
+            ),
+            (
+                planned.PlannedRebootAction(
+                    'compute-01', 'segment-1', allow_hard_off=True
+                ),
+                True,
+            ),
+        )
+
+        for action, hard_off in action_cases:
+            with self.subTest(action=type(action).__name__):
+                context = fakes.action_context(
+                    'execution-routed-{}'.format(type(action).__name__)
+                )
+
+                with mock.patch.object(
+                        powerops,
+                        'authorize',
+                        side_effect=exceptions.PowerOpsUnauthorized(
+                            'denied by shared helper'
+                        )) as authorize:
+                    self.assertRaises(
+                        exceptions.PowerOpsUnauthorized,
+                        action.run,
+                        context,
+                    )
+
+                authorize.assert_called_once_with(
+                    context.security,
+                    allow_hard_off=hard_off,
+                    error_cls=exceptions.PowerOpsUnauthorized,
+                )
+                coordinator_cls.assert_not_called()
+                connection_from_conf.assert_not_called()
+
+    @mock.patch.object(planned.coordination, 'OperationCoordinator')
+    @mock.patch.object(planned.clients, 'CloudClients')
+    @mock.patch.object(planned.clients, 'connection_from_conf')
+    def test_hard_off_is_admin_only_before_host_resolution(
+            self, connection_from_conf, cloud_cls, coordinator_cls):
+        delegated = planned.PlannedPowerOffAction(
+            'compute-01',
+            'segment-1',
+            allow_hard_off=True,
+        )
+
+        self.assertRaises(
+            exceptions.PowerOpsUnauthorized,
+            delegated.run,
+            fakes.action_context('execution-delegated-hard-off'),
+        )
+
+        coordinator_cls.assert_not_called()
+        connection_from_conf.assert_not_called()
+        cloud_cls.assert_not_called()
+
+        events = []
+        coordinator_cls.return_value = self._coordinator(events)
+        cloud = mock.Mock(unsafe=True)
+        cloud_cls.return_value = cloud
+        self._successful_cloud(cloud)
+        admin = planned.PlannedPowerOffAction(
+            'compute-01',
+            'segment-1',
+            allow_hard_off=True,
+        )
+        admin._audit = mock.Mock()
+
+        result = admin.run(
+            fakes.action_context(
+                'execution-admin-hard-off',
+                project_name='outside-allowlist',
+                user_name='outside-allowlist',
+                roles=['admin', 'powerops_operator'],
+            )
+        )
+
+        self.assertEqual('power off', result['power_state'])
+        cloud.resolve_host_set.assert_called_once_with(
+            'segment-1', 'compute-01'
+        )
+        cloud.power_off.assert_called_once_with('compute-01', True)
+
+    def test_action_rbac_is_exact_and_malformed_roles_fail_closed(self):
+        action = planned.PlannedPowerOffAction(
+            'compute-01', 'segment-1'
+        )
+        cases = (
+            (['admin'], 'other-project', 'other-user', 'admin'),
+            (['admin', 'powerops_operator'], 'other-project', 'other-user',
+             'admin'),
+            (['powerops_operator'], 'operations', 'powerops-operator',
+             'powerops_operator'),
+            (['PowerOps_Operator'], 'operations', 'powerops-operator', None),
+            ('admin', 'operations', 'powerops-operator', None),
+            (('admin',), 'operations', 'powerops-operator', None),
+            ({'admin': True}, 'operations', 'powerops-operator', None),
+        )
+
+        for roles, project_name, user_name, expected in cases:
+            with self.subTest(roles=roles):
+                context = fakes.action_context(
+                    'execution-rbac',
+                    project_name=project_name,
+                    user_name=user_name,
+                    roles=roles,
+                )
+
+                if expected is None:
+                    self.assertRaises(
+                        exceptions.PowerOpsUnauthorized,
+                        action._authorize,
+                        context,
+                    )
+                else:
+                    self.assertEqual(
+                        expected,
+                        action._authorize(context),
+                    )
+
+    def test_audit_has_only_bounded_secret_free_fields(self):
+        self.override_config('region_name', 'RegionPowerOps', 'powerops')
+        action = planned.PlannedPowerOffAction(
+            'compute-01',
+            'segment-1',
+            instance_policy='stop',
+            allow_hard_off=True,
+        )
+        action._authorization_branch = 'admin'
+        action._hard_off_authorized = True
+        context = fakes.action_context(
+            'workflow-execution-id',
+            project_id='actor-project-id',
+            user_id='actor-user-id',
+            roles=['admin'],
+        )
+        context.security.auth_token = 'audit-token-secret'
+        context.security.password = 'audit-password-secret'
+        context.security.service_catalog = {'secret': 'catalog-secret'}
+
+        with mock.patch.object(planned.base.LOG, 'info') as log_info:
+            action._audit(
+                context,
+                'planned_power_off',
+                'failure',
+                {
+                    'error_type': 'PowerStateError',
+                    'fail_safe_error_count': 2,
+                    'driver_info': {'address': '192.0.2.99'},
+                },
+            )
+
+        log_info.assert_called_once()
+        self.assertEqual('PowerOps audit %s', log_info.call_args.args[0])
+        record = log_info.call_args.args[1]
+        self.assertEqual(
+            {
+                'actor_user_id',
+                'actor_project_id',
+                'authorization_branch',
+                'region_name',
+                'host',
+                'segment_uuid',
+                'operation',
+                'instance_policy',
+                'hard_off_authorized',
+                'workflow_execution_id',
+                'action_execution_id',
+                'outcome',
+                'error_type',
+                'fail_safe_error_count',
+            },
+            set(record),
+        )
+        self.assertEqual('actor-user-id', record['actor_user_id'])
+        self.assertEqual('actor-project-id', record['actor_project_id'])
+        self.assertEqual('admin', record['authorization_branch'])
+        self.assertEqual('RegionPowerOps', record['region_name'])
+        self.assertEqual('compute-01', record['host'])
+        self.assertEqual('segment-1', record['segment_uuid'])
+        self.assertEqual('planned_power_off', record['operation'])
+        self.assertEqual('stop', record['instance_policy'])
+        self.assertIs(True, record['hard_off_authorized'])
+        self.assertEqual(
+            'workflow-execution-id', record['workflow_execution_id']
+        )
+        self.assertEqual(
+            'workflow-execution-id-action', record['action_execution_id']
+        )
+        serialized_arguments = repr(log_info.call_args)
+
+        for forbidden in (
+                'audit-token-secret',
+                'audit-password-secret',
+                'catalog-secret',
+                'driver_info',
+                '192.0.2.99'):
+            self.assertNotIn(forbidden, serialized_arguments)
+
