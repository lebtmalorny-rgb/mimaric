+import contextlib
+import re
+from urllib import parse
+
+from oslo_config import cfg
+from tooz import coordination as tooz_coordination
+
+
+CONF = cfg.CONF
+
+HOST_RE = re.compile(r'^[A-Za-z0-9][A-Za-z0-9._-]*$')
+REQUIRED_CHARACTERISTICS = frozenset({
+    tooz_coordination.Characteristics.DISTRIBUTED_ACROSS_PROCESSES,
+    tooz_coordination.Characteristics.LINEARIZABLE,
+})
+_SUPPORTED_SCHEMES = frozenset({'etcd3+http', 'etcd3+https'})
+
+
+def host_lock_name(host):
+    if not isinstance(host, str) or not HOST_RE.fullmatch(host):
+        raise ValueError('host must be a canonical Nova hostname')
+
+    return 'powerops/host/{}'.format(host)
+
+
+class OperationCoordinator:
+    def __init__(self, member_id):
+        self.member_id = member_id
+        self.backend = None
+        self._active_lock = None
+        self._started = False
+        self._unhealthy_reason = None
+
+    def _mark_unhealthy(self, reason):
+        if self._unhealthy_reason is None:
+            self._unhealthy_reason = reason
+
+        return RuntimeError(self._unhealthy_reason)
+
+    def start(self):
+        if self._unhealthy_reason is not None:
+            raise RuntimeError(self._unhealthy_reason)
+
+        if self._started:
+            raise RuntimeError('PowerOps coordinator is already started')
+
+        url = CONF.powerops.coordination_url
+
+        if not CONF.powerops.enabled or not url:
+            raise RuntimeError('PowerOps etcd coordination is not configured')
+
+        if parse.urlsplit(url).scheme not in _SUPPORTED_SCHEMES:
+            raise RuntimeError('PowerOps requires an etcd3 HTTP(S) backend')
+
+        try:
+            backend = tooz_coordination.get_coordinator(
+                url,
+                self.member_id.encode('utf-8'),
+                characteristics=REQUIRED_CHARACTERISTICS,
+            )
+        except Exception as exc:
+            raise self._mark_unhealthy(
+                'could not create the PowerOps coordinator'
+            ) from exc
+
+        try:
+            characteristics = set(backend.CHARACTERISTICS)
+        except Exception as exc:
+            raise self._mark_unhealthy(
+                'PowerOps coordinator characteristics are unavailable'
+            ) from exc
+
+        if not REQUIRED_CHARACTERISTICS.issubset(characteristics):
+            raise self._mark_unhealthy(
+                'PowerOps coordinator lacks required characteristics'
+            )
+
+        self.backend = backend
+
+        try:
+            self.backend.start(start_heart=True)
+        except Exception as exc:
+            raise self._mark_unhealthy(
+                'could not start the PowerOps coordinator'
+            ) from exc
+
+        self._started = True
+
+        try:
+            self.assert_healthy()
+        except Exception:
+            try:
+                self.stop()
+            except Exception:
+                pass
+            raise
+
+        return self
+
+    def stop(self):
+        if not self._started:
+            return
+
+        self._started = False
+
+        try:
+            self.backend.stop()
+        except Exception as exc:
+            raise self._mark_unhealthy(
+                'could not stop the PowerOps coordinator'
+            ) from exc
+
+    def _validate_lock(self, lock):
+        try:
+            compatible = (
+                lock._coord is self.backend
+                and isinstance(lock._key_b64, str)
+                and isinstance(lock._uuid, str)
+                and callable(lock._coord.client.transaction)
+                and callable(lock.acquire)
+                and callable(lock.release)
+            )
+        except (AttributeError, TypeError):
+            compatible = False
+
+        if not compatible:
+            raise self._mark_unhealthy(
+                'PowerOps lock cannot prove etcd ownership'
+            )
+
+    @staticmethod
+    def _ownership_transaction(lock):
+        return {
+            'compare': [{
+                'key': lock._key_b64,
+                'result': 'EQUAL',
+                'target': 'VALUE',
+                'value': lock._uuid,
+            }],
+            'success': [{
+                'request_range': {'key': lock._key_b64}
+            }],
+            'failure': [],
+        }
+
+    def assert_healthy(self):
+        if self._unhealthy_reason is not None:
+            raise RuntimeError(self._unhealthy_reason)
+
+        if not self._started or self.backend is None:
+            raise self._mark_unhealthy(
+                'PowerOps coordinator is not running'
+            )
+
+        try:
+            heartbeat_alive = self.backend.heart.is_alive()
+        except Exception as exc:
+            raise self._mark_unhealthy(
+                'PowerOps coordinator heartbeat state is unavailable'
+            ) from exc
+
+        if heartbeat_alive is not True:
+            raise self._mark_unhealthy(
+                'PowerOps coordinator heartbeat is not alive'
+            )
+
+        if self._active_lock is None:
+            return
+
+        try:
+            result = self.backend.client.transaction(
+                self._ownership_transaction(self._active_lock)
+            )
+        except Exception as exc:
+            raise self._mark_unhealthy(
+                'could not prove PowerOps lock ownership'
+            ) from exc
+
+        if not isinstance(result, dict) or result.get('succeeded') is not True:
+            raise self._mark_unhealthy(
+                'PowerOps host lock ownership was lost'
+            )
+
+    @contextlib.contextmanager
+    def lock_host(self, host):
+        self.assert_healthy()
+
+        if self._active_lock is not None:
+            raise self._mark_unhealthy(
+                'PowerOps coordinator already owns a host lock'
+            )
+
+        lock = self.backend.get_lock(
+            host_lock_name(host).encode('utf-8')
+        )
+        self._validate_lock(lock)
+
+        try:
+            acquired = lock.acquire(
+                blocking=CONF.powerops.host_lock_timeout
+            )
+        except Exception as exc:
+            raise RuntimeError(
+                'could not acquire the PowerOps host lock'
+            ) from exc
+
+        if acquired is not True:
+            raise RuntimeError('timed out acquiring host PowerOps lock')
+
+        self._active_lock = lock
+        protected_error = False
+
+        try:
+            self.assert_healthy()
+            yield self
+        except BaseException:
+            protected_error = True
+            raise
+        finally:
+            release_error = None
+
+            try:
+                released = lock.release()
+            except Exception as exc:
+                release_error = self._mark_unhealthy(
+                    'could not release the PowerOps host lock'
+                )
+                release_error.__cause__ = exc
+            else:
+                if released is not True:
+                    release_error = self._mark_unhealthy(
+                        'PowerOps host lock release was not confirmed'
+                    )
+
+            if release_error is None:
+                self._active_lock = None
+            elif not protected_error:
+                raise release_error
+
+    def __enter__(self):
+        return self.start()
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        try:
+            self.stop()
+        except Exception:
+            if exc_type is None:
+                raise
+
+        return False
