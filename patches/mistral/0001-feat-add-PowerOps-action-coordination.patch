+
+from unittest import mock
+
+from tooz import coordination as tooz_coordination
+from tooz.drivers import etcd3gw
+
+from mistral.actions.powerops import coordination
+from mistral import config
+from mistral.tests.unit import base
+
+
+_REQUIRED_CHARACTERISTICS = frozenset({
+    tooz_coordination.Characteristics.DISTRIBUTED_ACROSS_PROCESSES,
+    tooz_coordination.Characteristics.LINEARIZABLE,
+})
+
+
+class OperationCoordinatorTest(base.BaseTest):
+    def setUp(self):
+        super().setUp()
+
+        self.override_config("enabled", True, "powerops")
+        self.override_config(
+            "coordination_url",
+            "etcd3+http://etcd:2379?api_version=v3",
+            "powerops",
+        )
+
+    @staticmethod
+    def _backend():
+        backend = mock.Mock()
+        backend.CHARACTERISTICS = tuple(_REQUIRED_CHARACTERISTICS)
+        backend.heart.is_alive.return_value = True
+
+        lock = mock.Mock()
+        lock._coord = backend
+        lock._key_b64 = "encoded-host-lock-key"
+        lock._uuid = "encoded-owner-uuid"
+        lock.acquire.return_value = True
+        lock.release.return_value = True
+
+        backend.get_lock.return_value = lock
+        backend.client.transaction.return_value = {"succeeded": True}
+
+        return backend, lock
+
+    def test_powerops_config_is_exported_in_list_opts_shape(self):
+        exported = config.list_opts()
+        entries = [entry for entry in exported if entry[0] == "powerops"]
+
+        self.assertIsInstance(exported, list)
+        self.assertEqual(
+            [(config.POWEROPS_GROUP, config.powerops_opts)],
+            entries,
+        )
+
+        options = {option.name: option for option in entries[0][1]}
+        expected_defaults = {
+            "enabled": False,
+            "coordination_url": None,
+            "host_lock_timeout": 30.0,
+            "power_timeout": 180,
+            "poll_interval": 5,
+            "stable_observations": 3,
+            "graceful_shutdown_timeout": 300,
+            "vm_action_timeout": 600,
+            "service_timeout": 300,
+            "instance_interval": 5,
+            "region_name": "RegionOne",
+            "interface": "internal",
+            "nova_disable_reason": "PowerOps planned operation",
+            "allowed_project_names": [],
+            "allowed_user_names": [],
+        }
+
+        self.assertEqual(expected_defaults, {
+            name: option.default for name, option in options.items()
+        })
+        self.assertTrue(options["coordination_url"].secret)
+
+    def test_host_lock_name_accepts_only_canonical_host(self):
+        self.assertEqual(
+            "powerops/host/compute-01.example",
+            coordination.host_lock_name("compute-01.example"),
+        )
+
+        for host in (" host-1", "host-1 ", "host/1", "", None):
+            self.assertRaises(ValueError, coordination.host_lock_name, host)
+
+    @mock.patch.object(tooz_coordination, "get_coordinator")
+    def test_action_owns_exact_host_lock(self, get_coordinator):
+        backend, lock = self._backend()
+        get_coordinator.return_value = backend
+
+        with coordination.OperationCoordinator("action-1") as coordinator:
+            with coordinator.lock_host("compute-01"):
+                coordinator.assert_healthy()
+
+        get_coordinator.assert_called_once_with(
+            "etcd3+http://etcd:2379?api_version=v3",
+            b"action-1",
+            characteristics=_REQUIRED_CHARACTERISTICS,
+        )
+        backend.start.assert_called_once_with(start_heart=True)
+        backend.get_lock.assert_called_once_with(
+            b"powerops/host/compute-01"
+        )
+        lock.acquire.assert_called_once_with(blocking=30.0)
+        self.assertEqual(2, backend.client.transaction.call_count)
+        backend.client.transaction.assert_called_with({
+            "compare": [{
+                "key": "encoded-host-lock-key",
+                "result": "EQUAL",
+                "target": "VALUE",
+                "value": "encoded-owner-uuid",
+            }],
+            "success": [{
+                "request_range": {"key": "encoded-host-lock-key"}
+            }],
+            "failure": [],
+        })
+        lock.release.assert_called_once_with()
+        backend.stop.assert_called_once_with()
+
+    @mock.patch.object(tooz_coordination, "get_coordinator")
+    def test_pinned_etcd3_lock_owner_fields_are_supported(
+            self, get_coordinator):
+        backend, _lock = self._backend()
+        lock = etcd3gw.Etcd3Lock(
+            backend,
+            b"powerops/host/compute-01",
+            30,
+        )
+        lock.acquire = mock.Mock(return_value=True)
+        lock.release = mock.Mock(return_value=True)
+        backend.get_lock.return_value = lock
+        get_coordinator.return_value = backend
+
+        with coordination.OperationCoordinator("action-1") as coordinator:
+            with coordinator.lock_host("compute-01"):
+                pass
+
+        transaction = backend.client.transaction.call_args.args[0]
+        self.assertIsInstance(transaction["compare"][0]["key"], str)
+        self.assertIsInstance(transaction["compare"][0]["value"], str)
+
+    @mock.patch.object(tooz_coordination, "get_coordinator")
+    def test_disabled_powerops_fails_before_backend_creation(
+            self, get_coordinator):
+        self.override_config("enabled", False, "powerops")
+
+        self.assertRaises(
+            RuntimeError,
+            coordination.OperationCoordinator("action-1").start,
+        )
+        get_coordinator.assert_not_called()
+
+    @mock.patch.object(tooz_coordination, "get_coordinator")
+    def test_enabled_powerops_requires_coordination_url(
+            self, get_coordinator):
+        self.override_config("coordination_url", None, "powerops")
+
+        self.assertRaises(
+            RuntimeError,
+            coordination.OperationCoordinator("action-1").start,
+        )
+        get_coordinator.assert_not_called()
+
+    @mock.patch.object(tooz_coordination, "get_coordinator")
+    def test_unsupported_backend_scheme_is_rejected(self, get_coordinator):
+        for url in (
+                "redis://redis:6379",
+                "etcd3://etcd:2379",
+                "zake://"):
+            self.override_config("coordination_url", url, "powerops")
+
+            self.assertRaises(
+                RuntimeError,
+                coordination.OperationCoordinator("action-1").start,
+            )
+
+        get_coordinator.assert_not_called()
+
+    @mock.patch.object(tooz_coordination, "get_coordinator")
+    def test_missing_required_characteristics_fails_closed(
+            self, get_coordinator):
+        backend, _lock = self._backend()
+        backend.CHARACTERISTICS = (
+            tooz_coordination.Characteristics.DISTRIBUTED_ACROSS_PROCESSES,
+        )
+        get_coordinator.return_value = backend
+
+        coordinator = coordination.OperationCoordinator("action-1")
+
+        self.assertRaises(RuntimeError, coordinator.start)
+        backend.start.assert_not_called()
+
+    @mock.patch.object(tooz_coordination, "get_coordinator")
+    def test_dead_heartbeat_makes_failure_sticky(self, get_coordinator):
+        backend, _lock = self._backend()
+        get_coordinator.return_value = backend
+        coordinator = coordination.OperationCoordinator("action-1")
+        coordinator.start()
+        self.addCleanup(coordinator.stop)
+        backend.heart.is_alive.return_value = False
+
+        self.assertRaises(RuntimeError, coordinator.assert_healthy)
+
+        backend.heart.is_alive.return_value = True
+        self.assertRaises(RuntimeError, coordinator.assert_healthy)
+        backend.client.transaction.assert_not_called()
+
+    @mock.patch.object(tooz_coordination, "get_coordinator")
+    def test_failed_owner_compare_releases_and_stays_unhealthy(
+            self, get_coordinator):
+        backend, lock = self._backend()
+        backend.client.transaction.return_value = {"succeeded": False}
+        get_coordinator.return_value = backend
+        coordinator = coordination.OperationCoordinator("action-1")
+
+        with coordinator:
+            self.assertRaises(
+                RuntimeError,
+                self._enter_host_lock,
+                coordinator,
+            )
+
+            calls = backend.client.transaction.call_count
+            backend.client.transaction.return_value = {"succeeded": True}
+            self.assertRaises(RuntimeError, coordinator.assert_healthy)
+            self.assertEqual(calls, backend.client.transaction.call_count)
+
+        lock.release.assert_called_once_with()
+
+    @mock.patch.object(tooz_coordination, "get_coordinator")
+    def test_owner_compare_error_fails_closed(self, get_coordinator):
+        backend, lock = self._backend()
+        backend.client.transaction.side_effect = RuntimeError("etcd down")
+        get_coordinator.return_value = backend
+
+        with coordination.OperationCoordinator("action-1") as coordinator:
+            self.assertRaises(
+                RuntimeError,
+                self._enter_host_lock,
+                coordinator,
+            )
+
+        lock.release.assert_called_once_with()
+
+    @mock.patch.object(tooz_coordination, "get_coordinator")
+    def test_incompatible_lock_is_rejected_before_acquire(
+            self, get_coordinator):
+        backend, lock = self._backend()
+        del lock._uuid
+        get_coordinator.return_value = backend
+
+        with coordination.OperationCoordinator("action-1") as coordinator:
+            self.assertRaises(
+                RuntimeError,
+                self._enter_host_lock,
+                coordinator,
+            )
+
+        lock.acquire.assert_not_called()
+        lock.release.assert_not_called()
+
+    @mock.patch.object(tooz_coordination, "get_coordinator")
+    def test_false_release_makes_coordinator_unhealthy(
+            self, get_coordinator):
+        backend, lock = self._backend()
+        lock.release.return_value = False
+        get_coordinator.return_value = backend
+
+        with coordination.OperationCoordinator("action-1") as coordinator:
