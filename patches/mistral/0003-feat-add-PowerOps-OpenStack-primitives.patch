+
+
+class PowerOpsError(Exception):
+    """Base error for planned PowerOps actions."""
+
+
+class PowerOpsConfigurationError(PowerOpsError):
+    """PowerOps service authentication is not configured safely."""
+
+
+class PowerOpsTimeout(PowerOpsError):
+    """A bounded PowerOps operation did not finish in time."""
+
+
+class PowerOpsCallTimeout(PowerOpsTimeout):
+    """An individual yielding SDK or adapter call hit its deadline."""
+
+
+class HostResolutionError(PowerOpsError):
+    """A host did not resolve to one exact compatible resource."""
+
+
+class PowerStateError(PowerOpsError):
+    """An Ironic power state is unsafe or inconsistent."""
+
+
+class InstancePolicyError(PowerOpsError):
+    """An instance policy is invalid or cannot be applied safely."""
+
+
+class InstanceManifestError(PowerOpsError):
+    """An explicit instance restart manifest is unsafe."""
+
+
+class PowerOpsUnauthorized(PowerOpsError):
+    """The Mistral caller is not authorized for PowerOps."""
+
+
+class PowerOpsDisabled(PowerOpsError):
+    """PowerOps actions are disabled."""
+
+
+class OperatorGateRequired(PowerOpsError):
+    """The operator inspection gate has not been acknowledged."""
