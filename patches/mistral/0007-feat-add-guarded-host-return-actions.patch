+class _CleanupFailureCoordinator:
+    def __init__(self, events, failure_mode):
+        self.events = events
+        self.failure_mode = failure_mode
+
+    def __enter__(self):
+        self.events.append('coordinator-start')
+
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        self.events.append('coordinator-stop')
+
+        if self.failure_mode == 'stop_exception' and exc_type is None:
+            raise RuntimeError('coordinator stop failed')
+
+        return False
+
+    @contextmanager
+    def lock_host(self, host):
+        self.events.append('host-lock-enter')
+
+        try:
+            yield
+        finally:
+            self.events.append('host-lock-exit')
+
+            if self.failure_mode == 'release_exception':
+                raise RuntimeError('lock release failed')
+
+    def assert_healthy(self):
+        self.events.append('final-health')
+
