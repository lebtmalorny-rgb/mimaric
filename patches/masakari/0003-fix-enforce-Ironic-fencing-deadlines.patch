@@ -85,11 +85,19 @@ class IronicPowerClient(object):
         self.sleep = sleep
         self.monotonic = monotonic
 
+    def _raise_if_timed_out(self, deadline, host):
+        if self.monotonic() >= deadline:
+            raise FencingError(
+                "Timed out waiting for stable power off on {!r}".format(host)
+            )
+
     def fence(self, host, timeout, interval, stable_observations):
+        deadline = self.monotonic() + timeout
         matches = [
             node for node in self.connection.baremetal.nodes(details=True)
             if node.name == host
         ]
+        self._raise_if_timed_out(deadline, host)
         if len(matches) != 1:
             raise FencingError(
                 "Expected exactly one Ironic node named {!r}".format(host)
@@ -102,9 +110,9 @@ class IronicPowerClient(object):
                 node, "power off", wait=False
             )
 
-        deadline = self.monotonic() + timeout
         stable = 0
         while True:
