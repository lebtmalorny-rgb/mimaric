+    def test_fence_timeout_starts_before_node_lookup_and_power_request(self):
+        events = []
+        node = fakes.node("node-1", "compute-01", "power on")
+        connection = fakes.connection(nodes=[node])
+        connection.baremetal.nodes.side_effect = lambda **_kwargs: (
+            events.append("list") or [node]
+        )
+        connection.baremetal.set_node_power_state.side_effect = (
+            lambda *_args, **_kwargs: events.append("power-off")
+        )
+        times = iter([0, 2])
+
+        def clock():
+            events.append("clock")
+            return next(times)
+
+        client = ironic.IronicPowerClient(
+            connection, sleep=lambda _n: None, monotonic=clock
+        )
+
+        self.assertRaises(
+            ironic.FencingError, client.fence, "compute-01", 1, 1, 3
+        )
+        self.assertEqual(["clock", "list", "clock"], events)
+        connection.baremetal.set_node_power_state.assert_not_called()
+
+    def test_fence_rejects_stable_off_observed_after_deadline(self):
+        initial = fakes.node("node-1", "compute-01", "power on")
+        powered_off = fakes.node("node-1", "compute-01", "power off")
+        connection = fakes.connection(nodes=[initial])
+        current_time = {"value": 0}
+
+        def get_node(_node_id):
+            current_time["value"] = 2
+            return powered_off
+
+        connection.baremetal.get_node.side_effect = get_node
+        client = ironic.IronicPowerClient(
+            connection,
+            sleep=lambda _n: None,
+            monotonic=lambda: current_time["value"],
+        )
+
+        self.assertRaises(
+            ironic.FencingError, client.fence, "compute-01", 1, 1, 1
+        )
+        connection.baremetal.get_node.assert_called_once_with("node-1")
+
