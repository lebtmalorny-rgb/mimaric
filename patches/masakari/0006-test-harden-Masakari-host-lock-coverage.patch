+class HostFailureFlowCoordinatorTestCase(test.TestCase):
+
+    def setUp(self):
+        super(HostFailureFlowCoordinatorTestCase, self).setUp()
+        self.ctxt = context.get_admin_context()
+        self.novaclient = nova.API()
+        self.process_what = {
+            'host_name': 'compute-01',
+            'notification_uuid': uuids.notification,
+        }
+
+    def _assert_coordinator_reaches_all_stages(
+            self, flow_builder, config_name, task_dict, **kwargs):
+        coordinator = object()
+        self.override_config(
+            config_name, task_dict, 'taskflow_driver_recovery_flows')
+
+        with mock.patch.object(
+                base, 'get_recovery_flow',
+                wraps=base.get_recovery_flow) as get_recovery_flow, \
+                mock.patch.object(
+                    base, 'load_taskflow_into_engine',
+                    return_value=mock.sentinel.flow_engine) as load_engine:
+            result = flow_builder(
+                self.ctxt,
+                self.novaclient,
+                self.process_what,
+                powerops_coordinator=coordinator,
+                **kwargs
+            )
+
+        self.assertIs(mock.sentinel.flow_engine, result)
+        self.assertEqual(3, get_recovery_flow.call_count)
+        for stage, call in zip(('pre', 'main', 'post'),
+                               get_recovery_flow.call_args_list):
+            self.assertEqual(task_dict[stage], call.args[0])
+            self.assertIs(
+                coordinator, call.kwargs.get('powerops_coordinator'))
+
+        nested_flow = load_engine.call_args.args[1]
+        tasks = [task for stage_flow in nested_flow for task in stage_flow]
+        ironic_fence_tasks = [
+            task for task in tasks
+            if isinstance(task, powerops.IronicFenceTask)
+        ]
+        self.assertEqual(1, len(ironic_fence_tasks))
+        self.assertIs(
+            coordinator, ironic_fence_tasks[0].powerops_coordinator)
+
+    def test_auto_flow_passes_coordinator_to_every_configured_task(self):
+        self._assert_coordinator_reaches_all_stages(
+            host_failure.get_auto_flow,
+            'host_auto_failure_recovery_tasks',
+            {
+                'pre': ['disable_compute_service_task'],
+                'main': ['ironic_fence',
+                         'prepare_HA_enabled_instances_task'],
+                'post': ['evacuate_instances_task'],
+            },
+        )
+
+    def test_rh_flow_passes_coordinator_to_every_configured_task(self):
+        self._assert_coordinator_reaches_all_stages(
+            host_failure.get_rh_flow,
+            'host_rh_failure_recovery_tasks',
+            {
+                'pre': ['disable_compute_service_task', 'ironic_fence'],
+                'main': ['prepare_HA_enabled_instances_task',
+                         'evacuate_instances_task'],
+                'post': [],
+            },
+            update_host_method=manager.update_host_method,
+        )
