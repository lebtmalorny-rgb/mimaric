     @mock.patch.object(powerops_coordination, 'PowerOpsCoordinator')
     def test_auto_priority_fallback_keeps_same_host_lock(
@@ -128,6 +132,45 @@ class TaskflowDriverTestCase(test.TestCase):
             events,
         )
 
+    @mock.patch.object(powerops_coordination, 'PowerOpsCoordinator')
+    def test_rh_priority_fallback_keeps_same_host_lock(
+            self, coordinator_cls):
+        events = []
+        coordinator = powerops_fakes.recording_coordinator(events)
+        coordinator_cls.return_value = coordinator
+        self.override_config('enabled', True, 'powerops')
+
+        def execute_rh_workflow(*args, **kwargs):
+            self.assertIs(
+                coordinator, kwargs.get('powerops_coordinator'))
+            events.append('rh-flow')
+            raise RuntimeError('reserved-host failed')
+
+        def execute_auto_workflow(*args, **kwargs):
+            self.assertIs(
+                coordinator, kwargs.get('powerops_coordinator'))
+            events.append('auto-flow')
+
+        with mock.patch.object(
+                self.taskflow_driver, '_execute_rh_workflow',
+                side_effect=execute_rh_workflow), \
+                mock.patch.object(
+                    self.taskflow_driver, '_execute_auto_workflow',
+                    side_effect=execute_auto_workflow):
+            self.taskflow_driver.execute_host_failure(
+                self.ctxt,
+                'compute-01',
+                fields.FailoverSegmentRecoveryMethod.RH_PRIORITY,
+                uuidsentinel.fake_notification,
+                reserved_host_list=['compute-02'],
+            )
+
+        self.assertEqual(
+            ['coordinator-start', 'host-lock-enter', 'rh-flow', 'auto-flow',
+             'host-lock-exit', 'coordinator-stop'],
+            events,
+        )
+
     @mock.patch.object(powerops_coordination, 'PowerOpsCoordinator')
     def test_powerops_coordination_failure_prevents_flow(
             self, coordinator_cls):
@@ -148,6 +191,60 @@ class TaskflowDriverTestCase(test.TestCase):
 
         dispatch.assert_not_called()
 
+    @mock.patch.object(powerops_coordination, 'PowerOpsCoordinator')
+    def test_powerops_host_lock_failure_prevents_dispatch(
+            self, coordinator_cls):
+        coordinator = coordinator_cls.return_value
+        coordinator.__enter__.return_value = coordinator
+        coordinator.lock.return_value.__enter__.side_effect = RuntimeError(
+            'lock unavailable')
+        self.override_config('enabled', True, 'powerops')
+        self.override_config('host_lock_timeout', 19.0, 'powerops')
+
+        with mock.patch.object(
+                self.taskflow_driver, '_dispatch_host_failure') as dispatch:
+            self.assertRaises(
+                exception.HostRecoveryFailureException,
+                self.taskflow_driver.execute_host_failure,
+                self.ctxt,
+                'compute-01',
+                fields.FailoverSegmentRecoveryMethod.AUTO,
+                uuidsentinel.fake_notification,
+            )
+
+        coordinator.lock.assert_called_once_with(
+            'powerops/host/compute-01', 19.0)
+        dispatch.assert_not_called()
+
+    @mock.patch.object(powerops_coordination, 'PowerOpsCoordinator')
+    def test_post_dispatch_error_is_not_coordination_failure(
+            self, coordinator_cls):
+        coordinator_cls.return_value = (
+            powerops_fakes.recording_coordinator([]))
+        self.override_config('enabled', True, 'powerops')
+
+        with mock.patch.object(
+                self.taskflow_driver, '_dispatch_host_failure',
+                side_effect=ValueError('application failed')) as dispatch:
+            raised = self.assertRaises(
+                exception.MasakariException,
+                self.taskflow_driver.execute_host_failure,
+                self.ctxt,
+                'compute-01',
+                fields.FailoverSegmentRecoveryMethod.AUTO,
+                uuidsentinel.fake_notification,
+            )
+
+        self.assertNotIsInstance(
+            raised, exception.HostRecoveryFailureException)
+        dispatch.assert_called_once_with(
+            self.ctxt,
+            'compute-01',
+            fields.FailoverSegmentRecoveryMethod.AUTO,
+            uuidsentinel.fake_notification,
+            coordinator_cls.return_value,
+        )
+
     @mock.patch.object(base, 'DynamicLogListener')
     @mock.patch.object(host_failure, 'get_auto_flow')
     @mock.patch.object(host_failure, 'get_rh_flow')
