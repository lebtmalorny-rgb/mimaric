+import json
+import os
+from pathlib import Path
+import sys
+import types
+import unittest
+from unittest import mock
+import warnings
+
+from ansible.parsing.dataloader import DataLoader
+from ansible.template import Templar
+import jinja2
+import yaml
+
+
+ROOT = Path(__file__).resolve().parents[3]
+GROUP_VARS = ROOT / "ansible/group_vars/all.yml"
+HORIZON_DEFAULTS = ROOT / "ansible/roles/horizon/defaults/main.yml"
+HORIZON_PRECHECK = ROOT / "ansible/roles/horizon/tasks/precheck.yml"
+HORIZON_DEPLOY = ROOT / "ansible/roles/horizon/tasks/deploy.yml"
+HORIZON_POWEROPS = ROOT / "ansible/roles/horizon/tasks/powerops.yml"
+MISTRAL_DEFAULTS = ROOT / "ansible/roles/mistral/defaults/main.yml"
+MISTRAL_REGISTER = ROOT / "ansible/roles/mistral/tasks/register.yml"
+MISTRAL_POWEROPS = ROOT / "ansible/roles/mistral/tasks/powerops.yml"
+SERVICE_REGISTER = ROOT / "ansible/roles/service-ks-register/tasks/main.yml"
+
+
+def _load_yaml(path):
+    return yaml.safe_load(path.read_text(encoding="utf-8"))
+
+
+def _normalise(value):
+    return " ".join(str(value).split())
+
+
+def _ansible_bool(value):
+    if isinstance(value, str):
+        return value.lower() in {"1", "on", "true", "yes"}
+    return bool(value)
+
+
+def _kolla_address(_network, host):
+    return host
+
+
+def _put_address_in_context(value, _context):
+    return value
+
+
+def _render(value, variables):
+    environment = jinja2.Environment(  # nosec: local expression fixture
+        undefined=jinja2.StrictUndefined,
+    )
+    environment.filters.update({
+        "bool": _ansible_bool,
+        "kolla_address": _kolla_address,
+        "put_address_in_context": _put_address_in_context,
+        "to_json": json.dumps,
+    })
+    return environment.from_string(value).render(**variables)
+
+
+def _conditions_pass(conditions, variables):
+    templar = Templar(loader=DataLoader(), variables=variables)
+    with warnings.catch_warnings():
+        warnings.filterwarnings(
+            "ignore",
+            message="'crypt' is deprecated.*",
+            category=DeprecationWarning,
+            module="passlib.utils",
+        )
+        return all(
+            templar.template(
+                "{{ (%s) }}" % condition,
+                fail_on_undefined=True,
+            ) is True
+            for condition in conditions
+        )
+
+
+def _named(tasks, name):
+    matches = [task for task in tasks if task.get("name") == name]
+    if len(matches) != 1:
+        raise AssertionError(
+            f"expected one task named {name!r}, found {len(matches)}"
+        )
+    return matches[0]
+
+
+def _runtime_script(task):
+    command = _normalise(task["ansible.builtin.command"])
+    marker = ' horizon python -c "'
+    if marker not in command or not command.endswith('"'):
+        raise AssertionError("unexpected Horizon runtime command")
+    return command.split(marker, 1)[1][:-1]
+
+
+class HorizonPowerOpsDeploymentTest(unittest.TestCase):
+
+    def test_horizon_image_and_plugin_environment_are_derived(self):
+        services = _load_yaml(HORIZON_DEFAULTS)["horizon_services"]
+        horizon = services["horizon"]
+        image = horizon["image"]
+        expected = (
+            "{{ powerops_horizon_image ~ ':' ~ powerops_horizon_tag "
+            "if enable_horizon_powerops | bool else horizon_image_full }}"
+        )
+        self.assertEqual(_normalise(expected), _normalise(image))
+        self.assertEqual(
+            "upstream/horizon:2025.1",
+            _render(image, {
+                "enable_horizon_powerops": False,
+                "horizon_image_full": "upstream/horizon:2025.1",
+            }),
+        )
+        self.assertEqual(
+            "powerops-local/horizon:2025.1-powerops",
+            _render(image, {
+                "enable_horizon_powerops": True,
+                "powerops_horizon_image": "powerops-local/horizon",
+                "powerops_horizon_tag": "2025.1-powerops",
+                "horizon_image_full": "upstream/horizon:2025.1",
+            }),
+        )
+        environment = horizon["environment"]
+        self.assertEqual(
+            "{{ 'yes' if enable_horizon_powerops | bool else 'no' }}",
+            environment["ENABLE_POWEROPS"],
+        )
+        self.assertEqual(
+            "{{ 'yes' if enable_horizon_mistral | bool else 'no' }}",
+            environment["ENABLE_MISTRAL"],
+        )
+
+    def test_precheck_requires_shared_memcached_and_powerops_image(self):
+        tasks = _load_yaml(HORIZON_PRECHECK)
+        task = _named(
+            tasks,
+            "Validate Horizon PowerOps image and shared cache",
+        )
+        self.assertEqual("enable_horizon_powerops | bool", task["when"])
+        conditions = task["ansible.builtin.assert"]["that"]
+        combined = "\n".join(conditions)
+        for required in (
+                "enable_memcached",
+                "groups['memcached']",
+                "horizon_backend_database",
+                "powerops_horizon_image",
+                "powerops_horizon_tag"):
+            self.assertIn(required, combined)
+
+        valid = {
+            "enable_memcached": "yes",
+            "groups": {"memcached": ["cache-1", "cache-2"]},
+            "horizon_backend_database": False,
+            "powerops_horizon_image": "powerops-local/horizon",
+            "powerops_horizon_tag": "2025.1-powerops",
+        }
+        self.assertTrue(_conditions_pass(conditions, valid))
+        for override in (
+                {"enable_memcached": "no"},
+                {"groups": {"memcached": []}},
+                {"horizon_backend_database": True},
+                {"powerops_horizon_image": ""},
+                {"powerops_horizon_tag": "   "}):
+            with self.subTest(override=override):
+                values = dict(valid)
+                values.update(override)
+                self.assertFalse(_conditions_pass(conditions, values))
+
+    def test_keystone_role_object_is_created_without_assignment(self):
+        defaults = _load_yaml(MISTRAL_DEFAULTS)
+        expression = defaults["mistral_ks_roles"]
+        templar = Templar(
+            loader=DataLoader(),
+            variables={"enable_powerops": "yes"},
+        )
+        self.assertEqual(
+            ["powerops_operator"],
+            templar.template(expression, fail_on_undefined=True),
+        )
+        templar = Templar(
+            loader=DataLoader(),
+            variables={"enable_powerops": "no"},
+        )
+        self.assertEqual([], templar.template(
+            expression, fail_on_undefined=True
+        ))
+
+        register = _load_yaml(MISTRAL_REGISTER)[0]
+        variables = register["vars"]
+        self.assertEqual(
+            "{{ mistral_ks_roles }}",
+            variables["service_ks_register_roles"],
+        )
+        self.assertNotIn("service_ks_register_user_roles", variables)
+
+        mistral_text = "\n".join(
+            path.read_text(encoding="utf-8")
+            for path in (ROOT / "ansible/roles/mistral/tasks").glob("*.yml")
+        ).lower()
+        self.assertNotIn("role_assignment", mistral_text)
+        self.assertNotIn("implied", mistral_text)
+        self.assertIn("identity_role", SERVICE_REGISTER.read_text(
+            encoding="utf-8"
+        ))
+
+    def test_post_deploy_checks_are_read_only_and_cover_all_images(self):
+        mistral = _load_yaml(MISTRAL_POWEROPS)
+        check = _named(
+            mistral,
+            "Verify PowerOps Mistral action entry points",
+        )
+        command = _normalise(check["ansible.builtin.command"])
+        self.assertIn("import mistral", command)
+        self.assertIn("import mistral_lib", command)
+        self.assertIn("assert found == required", command)
+        self.assertEqual(
+            [
+                {"container": "mistral_api", "group": "mistral-api"},
+                {"container": "mistral_engine", "group": "mistral-engine"},
+                {
+                    "container": "mistral_executor",
+                    "group": "mistral-executor",
+                },
+            ],
+            check["loop"],
+        )
+
+        deploy = _load_yaml(HORIZON_DEPLOY)
+        flush_index = next(
+            index for index, task in enumerate(deploy)
+            if task.get("meta") == "flush_handlers"
+        )
+        imports = [
+            (index, task) for index, task in enumerate(deploy)
+            if task.get("import_tasks") == "powerops.yml"
+        ]
+        self.assertEqual(1, len(imports))
+        self.assertGreater(imports[0][0], flush_index)
+        self.assertEqual(
+            "enable_horizon_powerops | bool", imports[0][1]["when"]
+        )
+
+        tasks = _load_yaml(HORIZON_POWEROPS)
+        self.assertEqual(1, len(tasks))
+        command = _normalise(tasks[0]["ansible.builtin.command"])
+        self.assertIn(
+            "exec --env POWEROPS_EXPECTED_REGION "
+            "--env POWEROPS_EXPECTED_PROJECT_NAMES "
+            "--env POWEROPS_EXPECTED_USER_NAMES "
+            "--env POWEROPS_EXPECTED_CACHE_LOCATIONS horizon python -c",
+            command,
+        )
+        self.assertIn("import poweropsdashboard", command)
+        self.assertIn("poweropsdashboard.enabled._50_powerops", command)
+        self.assertIn("django.setup()", command)
+        self.assertIn("settings.POWEROPS_REGION_NAME", command)
+        self.assertIn("settings.POWEROPS_ALLOWED_PROJECT_NAMES", command)
+        self.assertIn("settings.POWEROPS_ALLOWED_USER_NAMES", command)
+        self.assertIn("settings.SESSION_ENGINE", command)
+        self.assertIn("settings.CACHES", command)
+        self.assertIn(
+            "django.contrib.sessions.backends.cache",
+            command,
+        )
+        self.assertIn(
+            "django.core.cache.backends.memcached.PyMemcacheCache",
+            command,
+        )
+        self.assertIs(tasks[0]["changed_when"], False)
+        self.assertIs(tasks[0]["run_once"], True)
+        self.assertEqual("{{ groups['horizon'][0] }}", tasks[0]["delegate_to"])
+        self.assertEqual(
+            {
+                "POWEROPS_EXPECTED_REGION": "{{ openstack_region_name }}",
+                "POWEROPS_EXPECTED_PROJECT_NAMES": (
+                    "{{ powerops_allowed_project_names | to_json }}"
+                ),
+                "POWEROPS_EXPECTED_USER_NAMES": (
+                    "{{ powerops_allowed_user_names | to_json }}"
+                ),
+                "POWEROPS_EXPECTED_CACHE_LOCATIONS": (
+                    "[{% for host in groups['memcached'] %}"
+                    "{{ (('api' | kolla_address(host) | "
+                    "put_address_in_context('url')) ~ ':' ~ "
+                    "memcached_port) | to_json }}"
+                    "{% if not loop.last %}, {% endif %}{% endfor %}]"
+                ),
+            },
+            {
+                name: _normalise(value)
+                for name, value in tasks[0]["environment"].items()
+            },
+        )
+        self.assertEqual(
+            '["cache-1:11211", "cache-2:11211"]',
+            _render(
+                tasks[0]["environment"][
+                    "POWEROPS_EXPECTED_CACHE_LOCATIONS"
+                ],
+                {
+                    "groups": {"memcached": ["cache-1", "cache-2"]},
+                    "memcached_port": 11211,
+                },
+            ),
+        )
+
+        serialised = yaml.safe_dump(
+            mistral + tasks + deploy
+        ).lower()
+        for forbidden in (
+                "/executions",
+                "post /",
+                "put /",
+                "workflow start",
+                "workflow resume",
+                "baremetal node",
+                "server evacuate",
+                "server migrate",
+                "server stop",
+                "server start",
+                "masakari notification",
+                "etcdctl put"):
+            self.assertNotIn(forbidden, serialised)
+
+    def _execute_runtime_check(self, session_engine, default_cache):
+        task = _load_yaml(HORIZON_POWEROPS)[0]
+        script = _runtime_script(task)
+        expected_locations = ["cache-1:11211", "cache-2:11211"]
+        settings = types.SimpleNamespace(
+            POWEROPS_REGION_NAME="RegionOne",
+            POWEROPS_ALLOWED_PROJECT_NAMES=["admin", "ops-project"],
+            POWEROPS_ALLOWED_USER_NAMES=["admin", "ops-user"],
+            POWEROPS_MOCK_MODE=False,
+            SESSION_ENGINE=session_engine,
+            CACHES={"default": default_cache},
+        )
+        setup_calls = []
+        django = types.ModuleType("django")
+        django.__path__ = []
+        django.setup = lambda: setup_calls.append("setup")
+        django_conf = types.ModuleType("django.conf")
+        django_conf.settings = settings
+        powerops = types.ModuleType("poweropsdashboard")
+        powerops.__path__ = []
+        enabled = types.ModuleType("poweropsdashboard.enabled")
+        enabled.__path__ = []
+        enabled_module = types.ModuleType(
+            "poweropsdashboard.enabled._50_powerops"
+        )
+        powerops.enabled = enabled
+        enabled._50_powerops = enabled_module
+        modules = {
+            "django": django,
+            "django.conf": django_conf,
+            "poweropsdashboard": powerops,
+            "poweropsdashboard.enabled": enabled,
+            "poweropsdashboard.enabled._50_powerops": enabled_module,
+        }
+        environment = {
+            "POWEROPS_EXPECTED_REGION": "RegionOne",
+            "POWEROPS_EXPECTED_PROJECT_NAMES": json.dumps(
+                ["admin", "ops-project"]
+            ),
+            "POWEROPS_EXPECTED_USER_NAMES": json.dumps(
+                ["admin", "ops-user"]
+            ),
+            "POWEROPS_EXPECTED_CACHE_LOCATIONS": json.dumps(
+                expected_locations
+            ),
+        }
+        with mock.patch.dict(sys.modules, modules), mock.patch.dict(
+                os.environ, environment):
+            exec(  # nosec: fixed local Ansible task under test
+                compile(script, "<horizon-powerops-runtime>", "exec"),
+                {},
+            )
+        self.assertEqual(["setup"], setup_calls)
+
+    def test_runtime_check_validates_fully_loaded_shared_cache(self):
+        session_engine = "django.contrib.sessions.backends.cache"
+        backend = (
+            "django.core.cache.backends.memcached.PyMemcacheCache"
+        )
+        valid_cache = {
+            "BACKEND": backend,
+            "LOCATION": ["cache-1:11211", "cache-2:11211"],
+        }
+        self._execute_runtime_check(session_engine, valid_cache)
+
+        invalid_cases = (
+            (
+                "database session override",
+                "django.contrib.sessions.backends.db",
+                valid_cache,
+            ),
+            (
+                "local memory override",
+                session_engine,
+                {
+                    "BACKEND": "django.core.cache.backends.locmem.LocMemCache",
+                    "LOCATION": valid_cache["LOCATION"],
+                },
+            ),
+            (
+                "dummy override",
+                session_engine,
+                {
+                    "BACKEND": "django.core.cache.backends.dummy.DummyCache",
+                    "LOCATION": valid_cache["LOCATION"],
+                },
+            ),
+            (
+                "wrong endpoints",
+                session_engine,
+                {"BACKEND": backend, "LOCATION": ["cache-1:11211"]},
+            ),
+            (
+                "missing endpoints",
+                session_engine,
+                {"BACKEND": backend},
+            ),
+        )
+        for name, final_session_engine, final_cache in invalid_cases:
+            with self.subTest(name=name), self.assertRaises(AssertionError):
+                self._execute_runtime_check(
+                    final_session_engine,
+                    final_cache,
+                )
+
+
+if __name__ == "__main__":
+    unittest.main()
