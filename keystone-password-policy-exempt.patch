+
+        def capture(conn, statement, multiparams, params, execution_options):
+            if getattr(statement, '_for_update_arg', None) is not None:
+                statements.append(statement)
+
+        event.listen(engine, 'before_execute', capture)
+        self.addCleanup(event.remove, engine, 'before_execute', capture)
+        self.update(user, password='x')
+        self.change(user, 'x', 'y')
+        self.assertEqual(2, len(statements))
+        for statement in statements:
+            for dialect in (mysql.dialect(), postgresql.dialect()):
+                rendered = str(statement.compile(dialect=dialect))
+                self.assertIn('FOR UPDATE', rendered)
+                self.assertNotIn('JOIN', rendered)
