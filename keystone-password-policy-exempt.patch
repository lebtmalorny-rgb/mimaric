+# under the License.
+
+"""Password policy classification through HTTP, manager and real SQL storage."""
+
+import datetime
+import importlib
+import logging
+import unittest
+from unittest import mock
+import uuid
+
+import fixtures
+import freezegun
+import jsonschema
+from oslo_policy import policy as oslo_policy
+from sqlalchemy.dialects import mysql
+from sqlalchemy.dialects import postgresql
+from sqlalchemy import event
+
+from keystone.common import provider_api
+from keystone.common.rbac_enforcer import policy
+from keystone.common import sql
+from keystone import exception
+from keystone.identity.backends import sql_model
+from keystone.identity import schema
+from keystone import notifications
+from keystone.tests import unit
+from keystone.tests.unit import test_v3
+
+PROVIDERS = provider_api.ProviderAPIs
+FLAG = 'password_policy_exempt'
+
+
+class PasswordPolicyExemptionTests(test_v3.RestfulTestCase):
+    def setUp(self):
+        super().setUp()
+        PROVIDERS.assignment_api.create_system_grant_for_user(
+            self.user_id, self.role_id
+        )
+        self.system_token = self.get_system_scoped_token()
+        self.project_token = self.get_scoped_token()
+        self.config_fixture.config(
+            group='security_compliance', password_regex=r'^[!-~]{8,}\Z'
+        )
+        # Reproduce startup with a configured regex: a late override alone
+        # misses the import-time schema guard on the self-service route.
+        old_schema = schema.password_change
+        importlib.reload(schema)
+        self.addCleanup(setattr, schema, 'password_change', old_schema)
+
+    def authenticate(self, user_id, password):
+        with self.make_request():
+            return PROVIDERS.identity_api.authenticate(user_id, password)
+
+    def create(
+        self,
+        password='ValidPass1!',
+        options=None,
+        token=None,
+        status=201,
+        **fields,
+    ):
+        ref = unit.new_user_ref(domain_id=self.domain_id, password=password)
+        ref.update(fields)
+        if options is not None:
+            ref['options'] = options
+        response = self.post(
+            '/users',
+            body={'user': ref},
+            token=token or self.system_token,
+            expected_status=status,
+        )
+        return response.json.get('user')
+
+    def update(self, user, status=200, token=None, **fields):
+        return self.patch(
+            '/users/' + user['id'],
+            body={'user': fields},
+            token=token or self.system_token,
+            expected_status=status,
+        )
+
+    def change(self, user, old, new, status=204):
+        return self.post(
+            '/users/' + user['id'] + '/password',
+            body={'user': {'original_password': old, 'password': new}},
+            noauth=True,
+            expected_status=status,
+        )
+
+    def test_service_create_short_password_is_persisted(self):
+        user = self.create('x', {FLAG: True})
+        self.assertIs(True, user['options'][FLAG])
+        with sql.session_for_read() as session:
+            ref = session.get(sql_model.User, user['id'])
+            self.assertIs(True, ref.get_resource_option('PPEX').option_value)
+        self.authenticate(user['id'], 'x')
+
+    def test_service_admin_reset_uses_target_options(self):
+        user = self.create(options={FLAG: True})
+        self.update(user, password='x')
+        self.authenticate(user['id'], 'x')
+
+    def test_service_self_change_with_loaded_regex(self):
+        user = self.create(options={FLAG: True})
+        self.change(user, 'ValidPass1!', 'x')
+        self.authenticate(user['id'], 'x')
+
+    def test_same_request_opt_in_and_opt_out(self):
+        user = self.create()
+        self.update(user, password='x', options={FLAG: True})
+        self.update(user, status=400, password='y', options={FLAG: False})
+        self.update(user, password='NewValid2!', options={FLAG: False})
+        self.update(user, status=400, password='z')
+        self.change(user, 'NewValid2!', 'z', status=400)
+
+    def test_null_removes_classification_and_restores_policy(self):
+        user = self.create(options={FLAG: True})
+        self.update(user, status=400, password='x', options={FLAG: None})
+        response = self.update(user, options={FLAG: None})
+        self.assertNotIn(FLAG, response.json['user']['options'])
+        self.update(user, status=400, password='x')
+
+    def test_omitted_false_and_null_remain_human(self):
+        for options in (None, {}, {FLAG: False}, {FLAG: None}):
+            with self.subTest(options=options):
+                self.create('x', options, status=400)
+                user = self.create(options=options)
+                self.update(user, password='x', status=400)
+                self.change(user, 'ValidPass1!', 'x', status=400)
+
+    def test_malformed_flag_rejected_on_create_and_update(self):
+        user = self.create()
+        for value in ('true', 'false', 1, 0, [], {}):
+            with self.subTest(value=value):
+                self.create(options={FLAG: value}, status=400)
+                self.update(user, options={FLAG: value}, status=400)
+
+    def test_project_admin_cannot_supply_classification(self):
+        user = self.create(options={FLAG: True})
+        for value in (True, False, None):
+            with self.subTest(value=value):
+                self.create(
+                    options={FLAG: value}, token=self.project_token, status=403
+                )
+                self.update(
+                    user,
+                    options={FLAG: value},
+                    token=self.project_token,
+                    status=403,
+                )
+        # Existing ordinary user administration remains authorized.
+        self.update(user, password='x', token=self.project_token)
+
+    def test_domain_admin_cannot_supply_classification(self):
+        PROVIDERS.assignment_api.create_grant(
+            role_id=self.role_id,
+            user_id=self.user_id,
+            domain_id=self.domain_id,
+        )
+        token = self.get_domain_scoped_token()
+        user = self.create()
+        self.create(options={FLAG: True}, token=token, status=403)
+        self.update(user, options={FLAG: False}, token=token, status=403)
+
+    def test_callers_exemption_does_not_exempt_human_target(self):
+        self.update(self.user, options={FLAG: True})
+        user = self.create()
+        self.update(user, password='x', status=400)
+        self.create('x', status=400)
+
+    def test_service_reuses_password_and_ignores_minimum_age(self):
+        self.config_fixture.config(
+            group='security_compliance',
+            unique_last_password_count=3,
