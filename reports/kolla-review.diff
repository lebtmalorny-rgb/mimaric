diff --git a/kolla_ansible/tests/unit/test_service_password_policy.py b/kolla_ansible/tests/unit/test_service_password_policy.py
new file mode 100644
index 0000000..d73975d
--- /dev/null
+++ b/kolla_ansible/tests/unit/test_service_password_policy.py
@@ -0,0 +1,282 @@
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+
+import importlib.util
+from pathlib import Path
+import unittest
+from unittest import mock
+
+from keystoneauth1 import session
+from keystoneauth1 import token_endpoint
+from openstack import connection
+import requests_mock
+import yaml
+
+
+ROOT = Path(__file__).resolve().parents[3]
+ROLE = ROOT / 'ansible/roles/service-ks-register'
+MODULE = ROLE / 'files/kolla_service_user.py'
+ENDPOINT = 'https://identity.example.test/v3'
+OPTIONS = {
+    'password_policy_exempt': True,
+    'ignore_change_password_upon_first_use': True,
+    'ignore_lockout_failure_attempts': True,
+    'ignore_password_expiry': True,
+}
+
+
+def load_module(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+class ServiceUserTest(unittest.TestCase):
+    def setUp(self):
+        self.assertTrue(MODULE.is_file(),
+                        'Service registration module missing')
+        self.module = load_module('kolla_service_user_test', MODULE)
+        self.http = requests_mock.Mocker()
+        self.http.start()
+        self.addCleanup(self.http.stop)
+        auth = token_endpoint.Token(ENDPOINT, 'test-token')
+        self.connection = connection.Connection(
+            session=session.Session(auth=auth),
+            identity_endpoint_override=ENDPOINT, identity_api_version='3')
+        self.http.get(ENDPOINT, json={'version': {
+            'id': 'v3.14', 'status': 'stable',
+            'links': [{'rel': 'self', 'href': ENDPOINT + '/'}]}})
+        self.http.get(ENDPOINT + '/domains/domain-id', json={'domain': {
+            'id': 'domain-id', 'name': 'Default', 'enabled': True}})
+        self.http.get(ENDPOINT + '/projects/project-id', json={'project': {
+            'id': 'project-id', 'name': 'service', 'domain_id': 'domain-id'}})
+        self.http.get(ENDPOINT + '/users', json={'users': []})
+        self.identity = self.connection.identity
+        self.params = dict(name='nova', domain='domain-id',
+                           default_project='project-id', password='x',
+                           update_password='on_create', check_mode=False)
+
+    def run_registration(self, **overrides):
+        return self.module.ensure_service_user(
+            self.identity, **dict(self.params, **overrides))
+
+    def existing(self, options=None, **extra):
+        ref = dict(id='user-id', name='nova', domain_id='domain-id',
+                   default_project_id='project-id', enabled=True,
+                   options=OPTIONS if options is None else options)
+        ref.update(extra)
+        self.http.get(ENDPOINT + '/users', json={'users': [ref]})
+        self.http.patch(ENDPOINT + '/users/user-id', json={'user': ref})
+
+    def writes(self):
+        return [r for r in self.http.request_history
+                if r.method in ('POST', 'PATCH', 'DELETE')]
+
+    def test_create_exemption_and_password_in_same_request(self):
+        self.http.post(ENDPOINT + '/users', status_code=201,
+                       json={'user': {'id': 'new-user-id'}})
+        result = self.run_registration()
+        self.assertTrue(result['changed'])
+        self.assertEqual('new-user-id', result['user_id'])
+        writes = self.writes()
+        self.assertEqual(1, len(writes))
+        self.assertEqual('POST', writes[0].method)
+        body = writes[0].json()['user']
+        self.assertEqual('x', body['password'])
+        self.assertEqual(OPTIONS, body['options'])
+        self.assertEqual('domain-id', body['domain_id'])
+        self.assertEqual('project-id', body['default_project_id'])
+        self.assertNotIn('password', result)
+
+    def test_existing_user_preserves_mfa_without_password_reset(self):
+        mfa = {'multi_factor_auth_enabled': True,
+               'multi_factor_auth_rules': [['password', 'totp']]}
+        self.existing(mfa)
+        self.assertTrue(self.run_registration()['changed'])
+        body = self.writes()[0].json()['user']
+        self.assertEqual(dict(mfa, **OPTIONS), body['options'])
+        self.assertNotIn('password', body)
+
+    def test_on_create_rerun_has_no_writes(self):
+        self.existing()
+        self.assertFalse(self.run_registration()['changed'])
+        self.assertEqual([], self.writes())
+
+    def test_always_rotates_and_sets_options_together(self):
+        self.existing({'password_policy_exempt': False})
+        result = self.run_registration(update_password='always')
+        self.assertTrue(result['changed'])
+        self.assertEqual(1, len(self.writes()))
+        body = self.writes()[0].json()['user']
+        self.assertEqual('x', body['password'])
+        self.assertEqual(OPTIONS, body['options'])
+
+    def test_always_rotates_even_when_options_are_current(self):
+        self.existing()
+        self.run_registration(update_password='always')
+        self.assertEqual('x', self.writes()[0].json()['user']['password'])
+
+    def test_check_mode_new_user_does_not_write(self):
+        result = self.run_registration(check_mode=True)
+        self.assertTrue(result['changed'])
+        self.assertIsNone(result['user_id'])
+        self.assertEqual([], self.writes())
+
+    def test_check_mode_existing_user_does_not_write(self):
+        self.existing({})
+        self.assertTrue(self.run_registration(check_mode=True)['changed'])
+        self.assertEqual([], self.writes())
+
+    def test_same_name_in_different_domain_never_updates_other_user(self):
+        self.existing({}, domain_id='other-domain')
+        with self.assertRaisesRegex(ValueError, 'domain'):
+            self.run_registration()
+        self.assertEqual([], self.writes())
+
+    def test_user_lookup_is_by_name_and_domain(self):
+        self.existing()
+        self.run_registration()
+        queries = [r.qs for r in self.http.request_history
+                   if r.path == '/v3/users']
+        self.assertEqual([{'name': ['nova'], 'domain_id': ['domain-id']}],
+                         queries)
+
+    def test_project_in_wrong_domain_fails_before_write(self):
+        self.http.get(ENDPOINT + '/projects/project-id', json={'project': {
+            'id': 'project-id', 'name': 'service', 'domain_id': 'other'}})
+        with self.assertRaisesRegex(ValueError, 'domain'):
+            self.run_registration()
+        self.assertEqual([], self.writes())
+
+    def test_domain_service_user_can_be_created_without_project(self):
+        self.http.post(ENDPOINT + '/users', status_code=201,
