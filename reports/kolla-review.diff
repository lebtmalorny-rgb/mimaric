@@ -0,0 +1,148 @@
+#!/usr/bin/python
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+
+DOCUMENTATION = r'''
+---
+module: kolla_service_user
+short_description: Register a service user with password policy exclusions
+description:
+  - Requires Keystone with the password_policy_exempt resource option patch.
+  - Sends the password and exclusions in one request on creation or rotation.
+  - Preserves unrelated user options, including multi-factor authentication.
+author: Kolla operators
+extends_documentation_fragment:
+  - openstack.cloud.openstack
+options:
+  name:
+    description: Exact user name in the selected domain.
+    type: str
+    required: true
+  domain:
+    description: Name or ID of the identity domain.
+    type: str
+    required: true
+  default_project:
+    description: Name or ID of the service project in the same domain.
+    type: str
+    required: false
+  password:
+    description: Service password, redacted from module output.
+    type: str
+    required: true
+  update_password:
+    description: Whether to rotate the password of an existing user.
+    type: str
+    choices: [on_create, always]
+    default: on_create
+'''
+
+EXAMPLES = r'''
+- name: Register Nova service identity
+  kolla_service_user:
+    name: nova
+    domain: default
+    default_project: service
+    password: "{{ nova_keystone_password }}"
+    auth: "{{ openstack_keystone_auth }}"
+  no_log: true
+'''
+
+RETURN = r'''
+user_id:
+  description: ID of the service identity, or null for a check-mode creation.
+  type: str
+  returned: always
+'''
+
+from ansible_collections.openstack.cloud.plugins.module_utils.openstack import (  # noqa: E402,E501
+    OpenStackModule,
+)
+
+
+SERVICE_OPTIONS = {
+    'password_policy_exempt': True,
+    'ignore_change_password_upon_first_use': True,
+    'ignore_lockout_failure_attempts': True,
+    'ignore_password_expiry': True,
+}
+
+
+def ensure_service_user(identity, name, domain, default_project, password,
+                        update_password='on_create', check_mode=False):
+    domain_ref = identity.find_domain(domain, ignore_missing=False)
+    project = None
+    if default_project is not None:
+        project = identity.find_project(default_project, ignore_missing=False,
+                                        domain_id=domain_ref.id)
+        if project.domain_id != domain_ref.id:
+            raise ValueError('The service project belongs to another domain')
+
+    # A name is not a user ID. Avoid find_user's ID shortcut, which could match
+    # an unrelated identity whose ID happens to equal the requested name.
+    users = list(identity.users(name=name, domain_id=domain_ref.id))
+    if any(user.domain_id != domain_ref.id or user.name != name
+           for user in users):
+        raise ValueError('User lookup returned a different name or domain')
+    if len(users) > 1:
+        raise ValueError('Multiple users returned for the service identity')
+
+    if not users:
+        if check_mode:
+            return dict(changed=True, user_id=None)
+        attributes = dict(
+            name=name, domain_id=domain_ref.id, password=password,
+            options=dict(SERVICE_OPTIONS), is_enabled=True)
+        if project is not None:
+            attributes['default_project_id'] = project.id
+        user = identity.create_user(**attributes)
+        return dict(changed=True, user_id=user.id)
+
+    user = users[0]
+    options = dict(user.options or {})
+    options.update(SERVICE_OPTIONS)
+    updates = {}
+    if options != user.options:
+        updates['options'] = options
+    if project is not None and user.default_project_id != project.id:
+        updates['default_project_id'] = project.id
+    if not user.is_enabled:
+        updates['is_enabled'] = True
+    if update_password == 'always':
+        updates['password'] = password
+    if updates and not check_mode:
+        identity.update_user(user, **updates)
+    return dict(changed=bool(updates), user_id=user.id)
+
+
+class ServiceUserModule(OpenStackModule):
+    argument_spec = dict(
+        name=dict(required=True),
+        domain=dict(required=True),
+        default_project=dict(),
+        password=dict(required=True, no_log=True),
+        update_password=dict(default='on_create',
+                             choices=['on_create', 'always']),
+    )
+    module_kwargs = dict(supports_check_mode=True)
+
+    def run(self):
+        try:
+            return ensure_service_user(
+                self.conn.identity, check_mode=self.check_mode,
+                **{key: self.params[key] for key in self.argument_spec})
+        except ValueError as error:
+            self.fail_json(msg=str(error))
+        except self.sdk.exceptions.SDKException as error:
+            # HTTP response bodies can contain submitted values; never return
+            # the body or password in task results, even with Kolla debug on.
+            self.fail_json(msg='Keystone service user registration failed',
+                           status_code=getattr(error, 'status_code', None))
+
+
+def main():
+    ServiceUserModule()()
+
+
+if __name__ == '__main__':
+    main()
