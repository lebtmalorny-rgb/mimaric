From: Lebt <lebtmalorny@gmail.com>
Date: Thu, 3 Sep 2026 16:00:05 +0300
Subject: [PATCH] feat: package PowerOps Horizon and Mistral components

---
 docker/horizon/extend_start.sh            |   7 ++
 docker/mistral/mistral-base/Dockerfile.j2 |  16 ++-
 kolla/common/sources.py                   |   8 ++
 kolla/tests/test_powerops_plugins.py      | 115 ++++++++++++++++++++++
 4 files changed, 145 insertions(+), 1 deletion(-)
 create mode 100644 kolla/tests/test_powerops_plugins.py

diff --git a/docker/horizon/extend_start.sh b/docker/horizon/extend_start.sh
index 506c503..9b40b69 100644
--- a/docker/horizon/extend_start.sh
+++ b/docker/horizon/extend_start.sh
@@ -143,6 +143,12 @@ function config_mistral_dashboard {
         "${SITE_PACKAGES}/openstack_dashboard/local/enabled/_50_mistral.py"
 }
 
+function config_powerops_dashboard {
+    config_dashboard "${ENABLE_POWEROPS:-no}" \
+        "${SITE_PACKAGES}/poweropsdashboard/enabled/_50_powerops.py" \
+        "${SITE_PACKAGES}/openstack_dashboard/local/enabled/_50_powerops.py"
+}
+
 function config_neutron_vpnaas_dashboard {
     config_dashboard "${ENABLE_NEUTRON_VPNAAS:-no}" \
         "${SITE_PACKAGES}/neutron_vpnaas_dashboard/enabled/_7100_project_vpn_panel.py" \
@@ -233,6 +239,7 @@ config_magnum_dashboard
 config_manila_ui
 config_masakari_dashboard
 config_mistral_dashboard
+config_powerops_dashboard
 config_neutron_vpnaas_dashboard
 config_octavia_dashboard
 config_tacker_dashboard
diff --git a/docker/mistral/mistral-base/Dockerfile.j2 b/docker/mistral/mistral-base/Dockerfile.j2
index f7fb3f4..a2bb26a 100644
--- a/docker/mistral/mistral-base/Dockerfile.j2
+++ b/docker/mistral/mistral-base/Dockerfile.j2
@@ -21,15 +21,29 @@ ADD plugins-archive /
     '/plugins/*'
 ] %}
 
+{% set powerops_mistral_lib_pip_packages = [
+    '/powerops-mistral-lib'
+] %}
+
 COPY extend_start.sh /usr/local/bin/kolla_extend_start
 
 RUN ln -s mistral-base-source/* mistral \
     && {{ macros.install_pip(mistral_base_pip_packages | customizable("pip_packages")) }} \
     && mkdir -p /etc/mistral \
     && cp -r /mistral/etc/* /etc/mistral/ \
-    && if [ "$(ls /plugins)" ]; then \
+    && if [ -d /plugins/mistral-lib ]; then \
+        mv /plugins/mistral-lib /powerops-mistral-lib; \
+       fi \
+    && if [ "$(ls -A /plugins)" ]; then \
         {{ macros.install_pip(mistral_base_plugins_pip_packages) }}; \
        fi \
+    && if [ -d /powerops-mistral-lib ]; then \
+        mistral_lib_version=$(sed -n 's/^mistral-lib===//p' /requirements/upper-constraints.txt) \
+        && test -n "${mistral_lib_version}" \
+        && sed -e "/^mistral-lib===/d" -i /requirements/upper-constraints.txt \
+        && PBR_VERSION="${mistral_lib_version}+powerops.1" \
+           {{ macros.install_pip(powerops_mistral_lib_pip_packages) }}; \
+       fi \
     && touch /usr/local/bin/kolla_mistral_extend_start \
     && chmod 644 /usr/local/bin/kolla_extend_start /usr/local/bin/kolla_mistral_extend_start
 
