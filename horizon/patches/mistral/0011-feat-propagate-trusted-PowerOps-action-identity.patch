diff --git a/mistral/tests/unit/engine/test_action_context.py b/mistral/tests/unit/engine/test_action_context.py
index 8bbc0cb5..eaef8bea 100644
--- a/mistral/tests/unit/engine/test_action_context.py
+++ b/mistral/tests/unit/engine/test_action_context.py
@@ -12,6 +12,7 @@
 
 from unittest import mock
 
+from mistral import context as auth_context
 from mistral.db.v2 import api as db_api
 from mistral.services import workflows as wf_service
