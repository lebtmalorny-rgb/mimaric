+
         wf_service.create_workflows(WF)
 
         # Start workflow.
@@ -54,6 +88,44 @@ class ActionContextTest(base.EngineTestCase):
         action_context = mocked_run.call_args[0][0]
         exec_context = action_context.execution
 
+        self.assertEqual(
+            '/etc/ssl/certs/ca.pem', action_context.security.auth_cacert
+        )
+        self.assertEqual('auth-token', action_context.security.auth_token)
+        self.assertEqual(
+            'https://identity.example/v3', action_context.security.auth_uri
+        )
+        self.assertEqual(
+            '2026-09-03T12:00:00Z', action_context.security.expires_at
+        )
+        self.assertIs(True, action_context.security.insecure)
+        self.assertIs(True, action_context.security.is_target)
+        self.assertIs(True, action_context.security.is_trust_scoped)
+        self.assertEqual('project-id', action_context.security.project_id)
+        self.assertEqual(
+            'project-name', action_context.security.project_name
+        )
+        self.assertIs(True, action_context.security.redelivered)
+        self.assertEqual('RegionTwo', action_context.security.region_name)
+        self.assertEqual(
+            service_catalog, action_context.security.service_catalog
+        )
+        self.assertEqual('trust-id', action_context.security.trust_id)
+        self.assertEqual('user-id', action_context.security.user_id)
+        self.assertEqual('user-name', action_context.security.user_name)
+        self.assertEqual(
+            ['admin', 'powerops_operator'],
+            action_context.security.roles,
+        )
+        self.assertIsNone(exec_context.workflow_resume_authorization)
+
+        roles.append('member')
+
+        self.assertEqual(
+            ['admin', 'powerops_operator'],
+            action_context.security.roles,
+        )
+
         with db_api.transaction():
             # Note: We need to reread execution to access related tasks.
             wf_ex = db_api.get_workflow_execution(wf_ex.id)
@@ -72,3 +144,67 @@ class ActionContextTest(base.EngineTestCase):
 
             self.assertEqual(exec_context.callback_url, callback_url)
             self.assertEqual(exec_context.action_execution_id, a_ex.id)
+
+    @mock.patch.object(MyAction, 'run', return_value=None)
+    def test_resume_authorization_comes_from_workflow_runtime_context(
+            self, mocked_run):
+        expected_resume_record = {
+            'branch': 'admin',
+            'project_id': 'project-id',
+            'user_id': 'user-id',
+        }
+
+        wf_service.create_workflows(WF_PAUSED)
+
+        wf_ex = self.engine.start_workflow('wf_paused')
+
+        self.await_workflow_paused(wf_ex.id)
+
+        with db_api.transaction():
+            wf_ex = db_api.get_workflow_execution(wf_ex.id)
+            runtime_context = dict(wf_ex.runtime_context)
+            runtime_context[RESUME_AUTH_KEY] = expected_resume_record
+            wf_ex.runtime_context = runtime_context
+
+        self.engine.resume_workflow(wf_ex.id)
+
+        self.await_workflow_success(wf_ex.id)
+
+        action_context = mocked_run.call_args[0][0]
+
+        self.assertEqual(
+            expected_resume_record,
+            action_context.execution.workflow_resume_authorization,
+        )
+
+    def test_create_context_copies_resume_authorization(self):
+        roles = ['admin', 'powerops_operator']
+        resume_record = {
+            'branch': 'admin',
+            'project_id': 'project-id',
+            'user_id': 'user-id',
+        }
+
+        self.ctx.user_id = 'user-id'
+        self.ctx.roles = roles
+
+        action_context = auth_context.create_action_context({
+            'workflow_resume_authorization': resume_record,
+        })
+
+        roles.append('member')
+        resume_record['branch'] = 'powerops_operator'
+
+        self.assertEqual('user-id', action_context.security.user_id)
+        self.assertEqual(
+            ['admin', 'powerops_operator'],
+            action_context.security.roles,
+        )
+        self.assertEqual(
+            {
+                'branch': 'admin',
+                'project_id': 'project-id',
+                'user_id': 'user-id',
+            },
+            action_context.execution.workflow_resume_authorization,
+        )
