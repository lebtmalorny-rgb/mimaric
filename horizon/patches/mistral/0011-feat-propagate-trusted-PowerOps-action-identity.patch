     )
 
     ex_ctx = lib_ctx.ExecutionContext(**execution_ctx)
diff --git a/mistral/engine/actions.py b/mistral/engine/actions.py
index a259faa3..05e64909 100644
--- a/mistral/engine/actions.py
+++ b/mistral/engine/actions.py
@@ -147,6 +147,11 @@ class Action(object, metaclass=abc.ABCMeta):
             res['workflow_execution_id'] = wf_ex.id
             res['task_execution_id'] = self.task_ex.id
             res['workflow_name'] = wf_ex.name
+            res['workflow_resume_authorization'] = (
+                (wf_ex.runtime_context or {}).get(
