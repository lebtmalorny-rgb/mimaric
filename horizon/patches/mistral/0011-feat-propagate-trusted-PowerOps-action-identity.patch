+        self.ctx.is_trust_scoped = True
+        self.ctx.project_id = 'project-id'
+        self.ctx.project_name = 'project-name'
+        self.ctx.redelivered = True
+        self.ctx.region_name = 'RegionTwo'
+        self.ctx.service_catalog = service_catalog
+        self.ctx.trust_id = 'trust-id'
