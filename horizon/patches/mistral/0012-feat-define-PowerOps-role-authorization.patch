+from types import SimpleNamespace
+
+from mistral import exceptions as exc
+from mistral.services import powerops
+from mistral.tests.unit import base
+
+
+class PowerOpsAuthorizationTest(base.BaseTest):
+
+    def setUp(self):
+        super(PowerOpsAuthorizationTest, self).setUp()
+
+        self.override_config(
+            'allowed_project_names', ['ops-project'], 'powerops'
+        )
+        self.override_config(
+            'allowed_user_names', ['ops-user'], 'powerops'
+        )
+
+    def test_authorization_matrix(self):
+        cases = (
+            (['admin'], 'any-project', 'any-user', False, 'admin'),
+            (['powerops_operator'], 'ops-project', 'ops-user', False,
+             'powerops_operator'),
+            (['powerops_operator'], 'wrong-project', 'ops-user', False,
+             None),
+            (['powerops_operator'], 'ops-project', 'wrong-user', False,
+             None),
+            (['member'], 'ops-project', 'ops-user', False, None),
+            (['Admin'], 'ops-project', 'ops-user', False, None),
+            (['powerops_operator'], 'ops-project', 'ops-user', True, None),
+            (['admin'], 'any-project', 'any-user', True, 'admin'),
+        )
+
+        for roles, project_name, user_name, allow_hard_off, expected in cases:
+            subject = SimpleNamespace(
+                roles=roles,
+                project_name=project_name,
+                user_name=user_name,
+            )
+
+            with self.subTest(
+                    roles=roles,
+                    project_name=project_name,
+                    user_name=user_name,
+                    allow_hard_off=allow_hard_off):
+                if expected is None:
+                    self.assertRaises(
+                        exc.NotAllowedException,
+                        powerops.authorize,
+                        subject,
+                        allow_hard_off,
+                    )
+                else:
+                    self.assertEqual(
+                        expected,
+                        powerops.authorize(subject, allow_hard_off),
+                    )
+
+    def test_rejects_missing_or_malformed_roles(self):
+        malformed_roles = (
+            None,
+            'admin',
+            ('admin',),
+            {'admin': True},
+            ['admin', 1],
+        )
+
+        for roles in malformed_roles:
+            subject = SimpleNamespace(
+                roles=roles,
+                project_name='ops-project',
+                user_name='ops-user',
+            )
+
+            with self.subTest(roles=roles):
+                self.assertRaises(
+                    exc.NotAllowedException,
+                    powerops.authorize,
+                    subject,
+                )
+
+
+class PowerOpsReservedFieldsTest(base.BaseTest):
+
+    def test_rejects_each_reserved_field_in_input_or_environment(self):
+        reserved_fields = (
+            'roles',
+            'is_admin',
+            'authorization_branch',
+            'workflow_resume_authorization',
+            '__powerops_resume_authorization',
+        )
+
+        for field in reserved_fields:
+            for workflow_input, env in (({field: 'value'}, {}),
+                                        ({}, {field: 'value'})):
+                with self.subTest(
+                        field=field,
+                        location='input' if workflow_input else 'env'):
+                    self.assertRaises(
+                        exc.InputException,
+                        powerops.reject_reserved_auth_fields,
+                        workflow_input,
+                        env,
+                    )
+
+    def test_accepts_ordinary_input_and_environment_fields(self):
+        powerops.reject_reserved_auth_fields(
+            {
+                'host': 'compute-01.example',
+                'segment_uuid': 'segment-id',
+                'instance_policy': 'live_migrate',
+                'allow_hard_off': False,
+            },
+            {'stale_domains_checked': True},
+        )
+
+    def test_accepts_absent_input_and_environment(self):
+        powerops.reject_reserved_auth_fields(None, None)
+
+    def test_rejects_non_mapping_input_or_environment(self):
+        cases = (
+            ('input', {}),
+            ([], {}),
+            ({}, 'environment'),
+            ({}, ()),
+        )
+
+        for workflow_input, env in cases:
+            with self.subTest(workflow_input=workflow_input, env=env):
+                self.assertRaises(
+                    exc.InputException,
+                    powerops.reject_reserved_auth_fields,
+                    workflow_input,
+                    env,
+                )
+
+    def test_workflow_allowlist_is_exact(self):
+        self.assertEqual(
+            frozenset({
+                'power_ops.host_inventory',
+                'power_ops.host_power_status',
+                'power_ops.planned_power_off',
+                'power_ops.planned_reboot',
+                'power_ops.power_on_and_return',
+            }),
+            powerops.POWEROPS_WORKFLOW_NAMES,
+        )
