+        self.assertIsInstance(
+            errors.get(LATER_RECORD['user_id']),
+            exc.InvalidStateTransitionException,
+        )
+        self.assertEqual(
+            EXPECTED_RECORD,
+            results[EXPECTED_RECORD['user_id']].runtime_context[
+                powerops.POWEROPS_RESUME_AUTH_KEY
+            ],
+        )
+
+        with db_api.transaction():
+            persisted = db_api.get_workflow_execution(POWEROPS_EXECUTION_ID)
+            self.assertEqual(states.RUNNING, persisted.state)
+            self.assertEqual(
