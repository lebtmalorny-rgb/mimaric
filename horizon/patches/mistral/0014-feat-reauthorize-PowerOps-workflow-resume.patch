+    def test_concurrent_resume_keeps_first_winner_provenance(self):
+        self._create_execution(
+            POWEROPS_EXECUTION_ID,
+            'power_ops.power_on_and_return',
+        )
+        winner_entered_handler = threading.Event()
+        loser_started = threading.Event()
+        loser_entered_handler = threading.Event()
+        release_winner = threading.Event()
+        release_loser = threading.Event()
+        results = {}
+        errors = {}
+        records = {
+            EXPECTED_RECORD['user_id']: EXPECTED_RECORD,
+            LATER_RECORD['user_id']: LATER_RECORD,
+        }
+
+        def build_record(subject, branch):
+            return records[subject.user_id]
+
+        def resume_transition(wf_ex, env=None):
+            user_id = auth_context.ctx().user_id
+
+            if user_id == EXPECTED_RECORD['user_id']:
+                winner_entered_handler.set()
+                release_winner.wait(5)
+            else:
+                loser_entered_handler.set()
+                release_loser.wait(5)
+
+            if wf_ex.state == states.PAUSED:
+                wf_ex.state = states.RUNNING
+
+            return wf_ex.get_clone()
+
+        def invoke_resume(user_id, started=None):
+            auth_context.set_ctx(self._resume_context(user_id))
+
+            try:
+                if started:
+                    started.set()
+
+                results[user_id] = self.engine.resume_workflow(
+                    POWEROPS_EXECUTION_ID,
+                    env={'stale_domains_checked': True},
+                )
+            except Exception as error:
+                errors[user_id] = error
+            finally:
+                auth_context.set_ctx(None)
+
+        winner = threading.Thread(
+            target=invoke_resume,
+            args=(EXPECTED_RECORD['user_id'],),
+        )
+        loser = threading.Thread(
+            target=invoke_resume,
+            args=(LATER_RECORD['user_id'], loser_started),
+        )
+
+        with mock.patch.object(
+                powerops,
+                'build_resume_authorization',
+                side_effect=build_record), mock.patch.object(
+                    wf_handler,
+                    'resume_workflow',
+                    side_effect=resume_transition):
+            winner.start()
+            self.assertTrue(winner_entered_handler.wait(5))
+            loser.start()
+            self.assertTrue(loser_started.wait(5))
+
+            loser_reached_handler_while_locked = (
+                loser_entered_handler.wait(0.5)
+            )
+
+            release_winner.set()
+            winner.join(5)
+            release_loser.set()
+            loser.join(5)
+
+        self.assertFalse(winner.is_alive())
+        self.assertFalse(loser.is_alive())
+        self.assertFalse(loser_reached_handler_while_locked)
