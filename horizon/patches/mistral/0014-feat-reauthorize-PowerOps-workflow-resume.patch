diff --git a/mistral/services/powerops.py b/mistral/services/powerops.py
index 7f1e3100..747f50f6 100644
--- a/mistral/services/powerops.py
+++ b/mistral/services/powerops.py
@@ -13,6 +13,7 @@
 # under the License.
 
 from collections import abc
+import datetime
 
 from oslo_config import cfg
 
@@ -26,6 +27,13 @@ OPERATOR_ROLE = 'powerops_operator'
 ADMIN_BRANCH = 'admin'
 OPERATOR_BRANCH = 'powerops_operator'
 POWEROPS_RESUME_AUTH_KEY = '__powerops_resume_authorization'
+POWEROPS_RESUME_WORKFLOW = 'power_ops.power_on_and_return'
+RESUME_AUTHORIZATION_FIELDS = frozenset({
+    'user_id',
+    'project_id',
+    'authorization_branch',
+    'authorized_at',
+})
 POWEROPS_WORKFLOW_NAMES = frozenset({
     'power_ops.host_inventory',
     'power_ops.host_power_status',
@@ -79,3 +87,61 @@ def reject_reserved_auth_fields(workflow_input, env):
             raise exc.InputException(
                 'PowerOps authorization fields are server controlled'
             )
+
+
+def is_powerops_resume_workflow(workflow_name):
+    return workflow_name == POWEROPS_RESUME_WORKFLOW
+
+
+def validate_resume_env(env):
+    if (not isinstance(env, abc.Mapping)
+            or set(env) != {'stale_domains_checked'}
+            or env.get('stale_domains_checked') is not True):
+        raise exc.InputException(
+            'PowerOps resume requires stale_domains_checked=true only'
+        )
+
+
+def build_resume_authorization(subject, branch, now=None):
+    user_id = getattr(subject, 'user_id', None)
+    project_id = getattr(subject, 'project_id', None)
+
+    if (not isinstance(user_id, str) or not user_id
+            or not isinstance(project_id, str) or not project_id
+            or branch not in {ADMIN_BRANCH, OPERATOR_BRANCH}):
+        raise exc.NotAllowedException(
+            'PowerOps resume requires current actor identifiers'
+        )
+
+    timestamp = now or datetime.datetime.now(datetime.timezone.utc)
+
+    return {
+        'user_id': user_id,
+        'project_id': project_id,
+        'authorization_branch': branch,
+        'authorized_at': timestamp.isoformat(),
+    }
+
+
+def require_resume_authorization(
+        action_context, error_cls=exc.NotAllowedException):
+    execution = getattr(action_context, 'execution', None)
+    record = getattr(execution, 'workflow_resume_authorization', None)
+    fields_are_strings = (
+        isinstance(record, abc.Mapping)
+        and all(
+            isinstance(record.get(field), str) and bool(record.get(field))
+            for field in RESUME_AUTHORIZATION_FIELDS
+        )
+    )
+
+    if (not isinstance(record, abc.Mapping)
+            or set(record) != RESUME_AUTHORIZATION_FIELDS
+            or not fields_are_strings
+            or record['authorization_branch']
+            not in {ADMIN_BRANCH, OPERATOR_BRANCH}):
+        raise error_cls(
+            'PowerOps return requires server-authorized workflow resume'
+        )
+
+    return dict(record)
