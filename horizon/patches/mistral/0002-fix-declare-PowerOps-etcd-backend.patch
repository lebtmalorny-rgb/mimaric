diff --git a/mistral/tests/unit/actions/powerops/test_coordination.py b/mistral/tests/unit/actions/powerops/test_coordination.py
index 2e030f61239ae142845647a9981ca4e84564a83e..45f0cdadaa0f7789bb8f2c3cf65796e540989c70 100644
--- a/mistral/tests/unit/actions/powerops/test_coordination.py
+++ b/mistral/tests/unit/actions/powerops/test_coordination.py
@@ -307,6 +307,34 @@ class OperationCoordinatorTest(base.BaseTest):
             )
             self.assertRaises(RuntimeError, coordinator.assert_healthy)
 
+    @mock.patch.object(tooz_coordination, "get_coordinator")
+    def test_release_failure_does_not_replace_protected_error(
+            self, get_coordinator):
+        for release_failure in (False, RuntimeError("etcd down")):
+            backend, lock = self._backend()
+
+            if release_failure is False:
+                lock.release.return_value = False
+            else:
+                lock.release.side_effect = release_failure
+
+            get_coordinator.return_value = backend
+            coordinator = coordination.OperationCoordinator("action-1")
+
+            try:
+                with coordinator:
+                    with coordinator.lock_host("compute-01"):
+                        raise ValueError("protected failure")
+            except Exception as error:
+                self.assertIsInstance(error, ValueError)
+                self.assertEqual("protected failure", str(error))
+            else:
+                self.fail("release failure replaced protected failure")
+
+            self.assertRaises(RuntimeError, coordinator.assert_healthy)
+            lock.release.assert_called_once_with()
+            backend.stop.assert_called_once_with()
+
     @mock.patch.object(tooz_coordination, "get_coordinator")
     def test_stop_is_idempotent(self, get_coordinator):
         backend, _lock = self._backend()
