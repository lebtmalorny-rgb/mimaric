+def _marked_template(relative_path, begin, end):
+    source = (ROOT / relative_path).read_text(encoding="utf-8")
+    if begin not in source or end not in source:
+        raise AssertionError(f"missing template markers {begin!r}/{end!r}")
+    return source[source.index(begin):source.index(end) + len(end)]
+
+
+class HorizonPowerOpsTemplateTest(unittest.TestCase):
+
+    def test_powerops_settings_are_exact_python_values(self):
+        source = _marked_template(
+            HORIZON_TEMPLATE,
+            "# BEGIN PowerOps settings",
+            "# END PowerOps settings",
+        )
+        rendered = _environment().from_string(source).render(
+            enable_horizon_powerops=True,
+            openstack_region_name="RegionOne",
+            powerops_allowed_project_names=["admin", "ops-project"],
+            powerops_allowed_user_names=["admin", "ops-user"],
+        )
+        namespace = {}
+        exec(rendered, {}, namespace)  # nosec: local rendered constants only
+
+        self.assertEqual("RegionOne", namespace["POWEROPS_REGION_NAME"])
+        self.assertEqual(
+            ["admin", "ops-project"],
+            namespace["POWEROPS_ALLOWED_PROJECT_NAMES"],
+        )
+        self.assertEqual(
+            ["admin", "ops-user"],
+            namespace["POWEROPS_ALLOWED_USER_NAMES"],
+        )
+        self.assertIs(namespace["POWEROPS_MOCK_MODE"], False)
+        self.assertEqual(
+            {
+                "POWEROPS_REGION_NAME",
+                "POWEROPS_ALLOWED_PROJECT_NAMES",
+                "POWEROPS_ALLOWED_USER_NAMES",
+                "POWEROPS_MOCK_MODE",
+            },
+            {name for name in namespace if name.startswith("POWEROPS_")},
+        )
+        for forbidden in ("PASSWORD", "TOKEN", "CREDENTIAL", "SECRET"):
+            self.assertNotIn(forbidden, rendered.upper())
+
+        disabled = _environment().from_string(source).render(
+            enable_horizon_powerops=False,
+            openstack_region_name="RegionOne",
+            powerops_allowed_project_names=["admin", "ops-project"],
+            powerops_allowed_user_names=["admin", "ops-user"],
+        )
+        self.assertNotIn("POWEROPS_REGION_NAME =", disabled)
+
+    def test_powerops_uses_shared_pymemcache_default_cache(self):
+        source = _marked_template(
+            HORIZON_TEMPLATE,
+            "# BEGIN Horizon cache settings",
+            "# END Horizon cache settings",
+        )
+        rendered = _environment().from_string(source).render(
+            enable_horizon_powerops=True,
+            horizon_backend_database=False,
+            groups={"memcached": ["cache-1", "cache-2"]},
+            memcached_port=11211,
+        )
+        self.assertIn(
+            "django.core.cache.backends.memcached.PyMemcacheCache",
+            rendered,
+        )
+        self.assertIn("'cache-1:11211','cache-2:11211'", rendered)
+        self.assertNotIn("LocMemCache", rendered)
+        self.assertNotIn("DummyCache", rendered)
+
+    def test_horizon_and_mistral_share_region_and_allowlists(self):
+        project_names = ["admin", "ops-project"]
+        user_names = ["admin", "ops-user"]
+        source = _marked_template(
+            HORIZON_TEMPLATE,
+            "# BEGIN PowerOps settings",
+            "# END PowerOps settings",
