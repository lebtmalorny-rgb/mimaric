+        mistral_rendered = _render(MISTRAL_TEMPLATE, variables)
+        config = _parse(mistral_rendered)
+        self.assertEqual(
+            namespace["POWEROPS_REGION_NAME"],
+            config["powerops"]["region_name"],
+        )
+        self.assertEqual(
+            namespace["POWEROPS_ALLOWED_PROJECT_NAMES"],
+            config["powerops"]["allowed_project_names"].split(","),
+        )
+        self.assertEqual(
+            namespace["POWEROPS_ALLOWED_USER_NAMES"],
+            config["powerops"]["allowed_user_names"].split(","),
