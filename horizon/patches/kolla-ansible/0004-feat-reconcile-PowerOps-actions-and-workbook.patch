+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import hashlib
+from pathlib import Path
+import re
+import unittest
+import warnings
+
+from ansible.parsing.dataloader import DataLoader
+from ansible.template import Templar
+import jinja2
+import yaml
+
+
+ROOT = Path(__file__).resolve().parents[3]
+MISTRAL_DEPLOY = ROOT / "ansible/roles/mistral/tasks/deploy.yml"
+MISTRAL_POWEROPS = ROOT / "ansible/roles/mistral/tasks/powerops.yml"
+MASAKARI_DEPLOY = ROOT / "ansible/roles/masakari/tasks/deploy.yml"
+MASAKARI_POWEROPS = ROOT / "ansible/roles/masakari/tasks/powerops.yml"
+WORKBOOK = ROOT / "ansible/roles/mistral/files/power_ops.yaml"
+
+ACTION_NAMES = [
+    "powerops.host_power_status",
+    "powerops.planned_power_off",
+    "powerops.planned_reboot",
+    "powerops.power_on_for_inspection",
+    "powerops.return_to_service",
+]
+WORKFLOW_NAMES = [
+    "power_ops.host_power_status",
+    "power_ops.planned_power_off",
+    "power_ops.planned_reboot",
+    "power_ops.power_on_and_return",
+]
+
+
+def _load_yaml(path):
+    return yaml.safe_load(path.read_text(encoding="utf-8"))
+
+
+def _named(tasks, name):
+    matches = [task for task in tasks if task.get("name") == name]
+    if len(matches) != 1:
+        raise AssertionError(
+            f"expected one task named {name!r}, found {len(matches)}"
+        )
+    return matches[0]
+
+
+def _normalise(value):
+    return " ".join(str(value).split())
+
+
+def _assert_controller_secret_task(test_case, task):
+    test_case.assertIs(task.get("no_log"), True)
+    test_case.assertIs(task.get("run_once"), True)
+    test_case.assertEqual("localhost", task.get("delegate_to"))
+
+
+def _template(value, variables):
+    templar = Templar(loader=DataLoader(), variables=variables)
+    with warnings.catch_warnings():
+        warnings.filterwarnings(
+            "ignore",
+            message="'crypt' is deprecated.*",
+            category=DeprecationWarning,
+            module="passlib.utils",
+        )
+        return templar.template(
+            value,
+            fail_on_undefined=True,
+        )
+
+
+def _conditions_pass(conditions, variables):
+    return all(
+        _template("{{ (%s) }}" % condition, variables) is True
+        for condition in conditions
+    )
+
+
+def _task_runs(task, variables):
+    conditions = task.get("when", True)
+    if not isinstance(conditions, list):
+        conditions = [conditions]
+    return _conditions_pass(conditions, variables)
+
+
+def _assertion_outcome(task, variables):
+    conditions = task["ansible.builtin.assert"]["that"]
+    return "passed" if _conditions_pass(conditions, variables) else "failed"
+
+
+class PowerOpsRegistrationTest(unittest.TestCase):
+
+    def test_registration_imports_run_after_handlers_and_are_guarded(self):
+        for path in (MISTRAL_DEPLOY, MASAKARI_DEPLOY):
+            with self.subTest(path=path):
+                tasks = _load_yaml(path)
+                flush_index = next(
+                    index for index, task in enumerate(tasks)
+                    if task.get("meta") == "flush_handlers"
+                )
+                imports = [
+                    (index, task) for index, task in enumerate(tasks)
+                    if task.get("import_tasks") == "powerops.yml"
+                ]
+                self.assertEqual(1, len(imports))
+                import_index, task = imports[0]
+                self.assertGreater(import_index, flush_index)
+                self.assertEqual("enable_powerops | bool", task.get("when"))
+
+    def test_entrypoint_checks_and_population_are_mandatory_and_exact(self):
+        mistral = _load_yaml(MISTRAL_POWEROPS)
+        check = _named(
+            mistral,
+            "Verify PowerOps Mistral action entry points",
+        )
+        populate = _named(mistral, "Populate Mistral action definitions")
+        self.assertLess(mistral.index(check), mistral.index(populate))
+        self.assertNotIn("when", check)
+        self.assertNotIn("when", populate)
+        self.assertIs(check.get("run_once"), True)
+        self.assertIs(populate.get("run_once"), True)
+        self.assertEqual(
+            "{{ groups[item.group][0] }}",
+            check.get("delegate_to"),
+        )
+        expected_targets = [
+            {"container": "mistral_api", "group": "mistral-api"},
+            {"container": "mistral_engine", "group": "mistral-engine"},
+            {
+                "container": "mistral_executor",
+                "group": "mistral-executor",
+            },
+        ]
+        self.assertEqual(expected_targets, check.get("loop"))
+        self.assertNotIn("mistral-event-engine", yaml.safe_dump(check))
+        self.assertEqual(
+            "{{ groups['mistral-api'][0] }}",
+            populate.get("delegate_to"),
+        )
+        self.assertIs(check.get("changed_when"), False)
+        self.assertIs(populate.get("changed_when"), False)
+        self.assertEqual(
+            "{{ kolla_container_engine }} exec mistral_api "
+            "mistral-db-manage --config-file "
+            "/etc/mistral/mistral.conf populate",
+            _normalise(populate["ansible.builtin.command"]),
+        )
+        command = _normalise(check["ansible.builtin.command"])
+        self.assertIn("exec {{ item.container }} python -c", command)
+        self.assertIn("m.entry_points(group='mistral.actions')", command)
+        for name in ACTION_NAMES:
+            self.assertIn(repr(name), command)
+
+        masakari = _load_yaml(MASAKARI_POWEROPS)
+        self.assertEqual(1, len(masakari))
+        check = _named(
+            masakari,
+            "Verify PowerOps Masakari fencing entry point",
+        )
+        self.assertNotIn("when", check)
+        self.assertIs(check.get("run_once"), True)
+        self.assertIs(check.get("changed_when"), False)
+        self.assertEqual(
