diff --git a/kolla_ansible/tests/unit/test_powerops_configuration_contract.py b/kolla_ansible/tests/unit/test_powerops_configuration_contract.py
new file mode 100644
index 0000000000000000000000000000000000000000..69d95c56a36f408930450f2cabc7900ef819b1cc
--- /dev/null
+++ b/kolla_ansible/tests/unit/test_powerops_configuration_contract.py
@@ -0,0 +1,510 @@
+# Licensed under the Apache License, Version 2.0 (the "License"); you may
+# not use this file except in compliance with the License. You may obtain
+# a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import copy
+from pathlib import Path
+import re
+import unittest
+import warnings
+
+from ansible.parsing.dataloader import DataLoader
+from ansible.template import Templar
+import jinja2
+import yaml
+
+
+ROOT = Path(__file__).resolve().parents[3]
+GROUP_VARS = ROOT / "ansible/group_vars/all.yml"
+GLOBALS_EXAMPLE = ROOT / "etc/kolla/globals.yml"
+GLOBAL_PRECHECK_MAIN = ROOT / "ansible/roles/prechecks/tasks/main.yml"
+GLOBAL_POWEROPS_PRECHECK = (
+    ROOT / "ansible/roles/prechecks/tasks/powerops_checks.yml"
+)
+
+POWEROPS_TIMING_DEFAULTS = {
+    "powerops_host_lock_timeout": 30,
+    "powerops_evacuation_lock_timeout": 3600,
+    "powerops_evacuation_interval": 5,
+    "powerops_power_timeout": 180,
+    "powerops_poll_interval": 5,
+    "powerops_stable_observations": 3,
+    "powerops_graceful_shutdown_timeout": 300,
+    "powerops_vm_action_timeout": 600,
+    "powerops_service_timeout": 300,
+    "powerops_instance_interval": 5,
+}
+
+POWEROPS_IMAGE_DEFAULTS = {
+    "powerops_masakari_engine_image": "",
+    "powerops_masakari_engine_tag": "",
+    "powerops_mistral_api_image": "",
+    "powerops_mistral_api_tag": "",
+    "powerops_mistral_engine_image": "",
+    "powerops_mistral_engine_tag": "",
+    "powerops_mistral_executor_image": "",
+    "powerops_mistral_executor_tag": "",
+}
+
+POWEROPS_DEFAULTS = {
+    "enable_powerops": "no",
+    "powerops_coordination_url": (
+        "etcd3+{{ internal_protocol }}://{{ kolla_internal_fqdn }}:"
+        "{{ etcd_client_port }}?api_version=v3{% if openstack_cacert %}"
+        "&ca_cert={{ openstack_cacert }}{% endif %}"
+    ),
+    **POWEROPS_TIMING_DEFAULTS,
+    "powerops_reconcile_workbook": "yes",
+    "powerops_validate_registration": "yes",
+    "powerops_allowed_project_names": [
+        "{{ openstack_auth.project_name }}",
+    ],
+    "powerops_allowed_user_names": [
+        "{{ openstack_auth.username }}",
+    ],
+    **POWEROPS_IMAGE_DEFAULTS,
+}
+
+ROLE_PATHS = {
+    "masakari": {
+        "defaults": ROOT / "ansible/roles/masakari/defaults/main.yml",
+        "precheck": ROOT / "ansible/roles/masakari/tasks/precheck.yml",
+    },
+    "mistral": {
+        "defaults": ROOT / "ansible/roles/mistral/defaults/main.yml",
+        "precheck": ROOT / "ansible/roles/mistral/tasks/precheck.yml",
+    },
+}
+
+PATCHED_SERVICES = {
+    "masakari": {
+        "masakari-engine": (
+            "powerops_masakari_engine_image",
+            "powerops_masakari_engine_tag",
+            "masakari_engine_image_full",
+        ),
+    },
+    "mistral": {
+        "mistral-api": (
+            "powerops_mistral_api_image",
+            "powerops_mistral_api_tag",
+            "mistral_api_image_full",
+        ),
+        "mistral-engine": (
+            "powerops_mistral_engine_image",
+            "powerops_mistral_engine_tag",
+            "mistral_engine_image_full",
+        ),
+        "mistral-executor": (
+            "powerops_mistral_executor_image",
+            "powerops_mistral_executor_tag",
+            "mistral_executor_image_full",
+        ),
+    },
+}
+
+COMMON_PRECHECK_VARIABLES = {
+    "enable_ironic",
+    "enable_masakari",
+    "enable_mistral",
+    "enable_etcd",
+    "powerops_coordination_url",
+    "powerops_allowed_project_names",
+    "powerops_allowed_user_names",
+}
+
+
+def _load_yaml(path):
+    return yaml.safe_load(path.read_text(encoding="utf-8"))
+
+
+def _ansible_bool(value):
+    if isinstance(value, str):
+        return value.lower() in {"1", "on", "true", "yes"}
+    return bool(value)
+
+
+def _jinja_environment():
+    environment = jinja2.Environment(  # nosec: static local test input
+        undefined=jinja2.StrictUndefined,
+    )
+    environment.filters.update({
+        "bool": _ansible_bool,
+    })
+    return environment
+
+
+def _normalize_jinja(expression):
+    return " ".join(expression.split())
+
+
+def _powerops_assertion(role):
+    tasks = _load_yaml(ROLE_PATHS[role]["precheck"])
+    matches = [
+        task for task in tasks
+        if task.get("name") == (
+            "Validate PowerOps service and coordination dependencies"
+        )
+    ]
+    if len(matches) != 1:
+        return None
+    return matches[0]
+
+
+def _conditions_pass(conditions, variables):
+    templar = Templar(loader=DataLoader(), variables=variables)
+    with warnings.catch_warnings():
+        warnings.filterwarnings(
+            "ignore",
+            message="'crypt' is deprecated.*",
+            category=DeprecationWarning,
+            module="passlib.utils",
+        )
+        return all(
+            templar.template(
+                "{{ (%s) }}" % condition,
+                fail_on_undefined=True,
+            ) is True
+            for condition in conditions
+        )
+
+
+def _assertion_outcome(task, variables):
+    when = task.get("when", True)
+    if not _conditions_pass([when], variables):
+        return "skipped"
+    conditions = task["ansible.builtin.assert"]["that"]
+    return "passed" if _conditions_pass(conditions, variables) else "failed"
+
+
+class PowerOpsConfigurationContractTest(unittest.TestCase):
+
+    def test_powerops_is_disabled_by_default(self):
+        variables = _load_yaml(GROUP_VARS)
+
+        self.assertEqual("no", variables.get("enable_powerops"))
+
+    def test_powerops_defaults_are_exact(self):
+        variables = _load_yaml(GROUP_VARS)
+        actual = {
+            name: variables.get(name)
+            for name in POWEROPS_DEFAULTS
+        }
+
+        self.assertEqual(POWEROPS_DEFAULTS, actual)
+
+    def test_etcd3gw_url_has_one_query_separator(self):
+        variables = _load_yaml(GROUP_VARS)
+        expression = variables.get("powerops_coordination_url", "")
+        environment = _jinja_environment()
+
+        plain = environment.from_string(expression).render(
+            internal_protocol="http",
+            kolla_internal_fqdn="controller.internal",
+            etcd_client_port="2379",
+            openstack_cacert="",
+        )
+        tls = environment.from_string(expression).render(
+            internal_protocol="https",
+            kolla_internal_fqdn="controller.internal",
+            etcd_client_port="2379",
+            openstack_cacert="/etc/kolla/certificates/ca.pem",
+        )
+
+        self.assertEqual(
+            "etcd3+http://controller.internal:2379?api_version=v3",
+            plain,
+        )
+        self.assertEqual(
+            "etcd3+https://controller.internal:2379?api_version=v3"
+            "&ca_cert=/etc/kolla/certificates/ca.pem",
+            tls,
+        )
+        self.assertEqual(1, plain.count("?"))
+        self.assertEqual(1, tls.count("?"))
+        self.assertNotIn("?ca_cert=", tls)
