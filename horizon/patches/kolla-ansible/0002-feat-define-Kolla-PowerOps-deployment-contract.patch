+      - >-
+        powerops_coordination_url |
+        regex_search(
+          '^etcd3\+https?://(?:\[[0-9A-Fa-f:]+\]|[^\s:/?]+):[0-9]+\?api_version=v3(?:&ca_cert=[^\s&?]+)?$'
+        ) is not none
+      - (powerops_allowed_project_names | type_debug) == 'list'
+      - powerops_allowed_project_names | length > 0
+      - >-
+        powerops_allowed_project_names | select('string') | list | length
+        == powerops_allowed_project_names | length
+      - >-
+        powerops_allowed_project_names | select('string') | map('trim') |
+        reject('equalto', '') | list | length
+        == powerops_allowed_project_names | length
+      - >-
+        powerops_allowed_project_names | select('string') | map('trim') | list
+        == powerops_allowed_project_names
+      - >-
+        powerops_allowed_project_names |
+        select('string') | select('match', '^[^,]*$') | list | length
+        == powerops_allowed_project_names | length
+      - (powerops_allowed_user_names | type_debug) == 'list'
+      - powerops_allowed_user_names | length > 0
+      - >-
+        powerops_allowed_user_names | select('string') | list | length
+        == powerops_allowed_user_names | length
+      - >-
+        powerops_allowed_user_names | select('string') | map('trim') |
+        reject('equalto', '') | list | length
+        == powerops_allowed_user_names | length
+      - >-
+        powerops_allowed_user_names | select('string') | map('trim') | list
+        == powerops_allowed_user_names
+      - >-
+        powerops_allowed_user_names |
+        select('string') | select('match', '^[^,]*$') | list | length
+        == powerops_allowed_user_names | length
+      - powerops_masakari_engine_image is string
