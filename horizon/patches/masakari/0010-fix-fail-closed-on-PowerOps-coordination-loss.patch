         self.started = False
+        self._active_locks = []
+        self._health_failure = None
+
+    def _unhealthy(self, reason):
+        if self._health_failure is None:
+            self._health_failure = str(reason)
+        return RuntimeError(
+            "PowerOps coordinator is unhealthy: {}".format(
+                self._health_failure
+            )
+        )
 
     def start(self):
         if self.started:
             return
+        if self._health_failure is not None:
+            raise self._unhealthy(self._health_failure)
 
         backend_url = self.backend_url or cfg.CONF.coordination.backend_url
         if cfg.CONF.powerops.enabled and not backend_url:
             raise RuntimeError("PowerOps requires coordination backend_url")
+        if cfg.CONF.powerops.enabled:
+            scheme = urllib.parse.urlsplit(backend_url).scheme
+            if scheme not in _ALLOWED_BACKEND_SCHEMES:
+                raise RuntimeError(
+                    "PowerOps requires an etcd3+http or etcd3+https backend"
+                )
 
         self.coordinator = tooz_coordination.get_coordinator(
-            backend_url, self.member_id.encode("utf-8"))
+            backend_url,
+            self.member_id.encode("utf-8"),
+            characteristics=_REQUIRED_CHARACTERISTICS,
+        )
         self.coordinator.start(start_heart=True)
         self.started = True
 
@@ -66,15 +148,50 @@ class PowerOpsCoordinator(object):
     def __exit__(self, exc_type, exc_value, traceback):
         self.stop()
 
+    def assert_healthy(self):
+        if self._health_failure is not None:
+            raise self._unhealthy(self._health_failure)
+        if not self.started:
+            raise self._unhealthy("coordinator is not started")
+
+        try:
+            if not self.coordinator.heart.is_alive():
+                raise RuntimeError("heartbeat thread is not alive")
+            for backend_lock in list(self._active_locks):
+                _Etcd3GWLockHealthProbe(
+                    self.coordinator, backend_lock
+                ).assert_owned()
+        except Exception as exc:
+            raise self._unhealthy(exc) from exc
+        return True
+
     @contextlib.contextmanager
     def lock(self, name, timeout):
         if not self.started:
             raise RuntimeError("PowerOps coordinator is not started")
         backend_lock = self.coordinator.get_lock(name.encode("utf-8"))
+        try:
+            _Etcd3GWLockHealthProbe(self.coordinator, backend_lock)
+        except Exception as exc:
+            raise self._unhealthy(exc) from exc
         acquired = backend_lock.acquire(blocking=timeout)
         if not acquired:
             raise RuntimeError("timed out acquiring lock {}".format(name))
+        self._active_locks.append(backend_lock)
         try:
+            self.assert_healthy()
             yield
         finally:
-            backend_lock.release()
+            try:
+                try:
+                    released = backend_lock.release()
+                except Exception as exc:
+                    raise self._unhealthy(
+                        "lock release raised: {}".format(exc)
+                    ) from exc
+                if released is not True:
+                    raise self._unhealthy(
+                        "lock release did not confirm ownership"
+                    )
+            finally:
+                self._active_locks.remove(backend_lock)
