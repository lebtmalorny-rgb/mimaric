     return "powerops/host/{}".format(host)
 
 
+class _Etcd3GWLockHealthProbe(object):
+    """Prove ownership using the pinned tooz etcd3gw lock contract."""
+
+    def __init__(self, coordinator, backend_lock):
+        if not isinstance(backend_lock, tooz_etcd3gw.Etcd3Lock):
+            raise RuntimeError("PowerOps requires a tooz etcd3gw lock")
+        if backend_lock._coord is not coordinator:
+            raise RuntimeError("PowerOps lock belongs to another coordinator")
+        if not isinstance(backend_lock._key_b64, str):
+            raise RuntimeError("PowerOps lock has no compatible etcd key")
+        if not isinstance(backend_lock._uuid, str):
+            raise RuntimeError("PowerOps lock has no compatible owner UUID")
+        transaction = getattr(
+            getattr(coordinator, "client", None), "transaction", None
+        )
+        if not callable(transaction):
+            raise RuntimeError("PowerOps coordinator has no etcd transaction")
+        self.lock = backend_lock
+        self.transaction = transaction
+
+    def assert_owned(self):
+        txn = {
+            "compare": [{
+                "key": self.lock._key_b64,
+                "result": "EQUAL",
+                "target": "VALUE",
+                "value": self.lock._uuid,
+            }],
+            "success": [{
+                "request_range": {
+                    "key": self.lock._key_b64,
+                    "serializable": False,
+                },
+            }],
+            "failure": [],
+        }
+        result = self.transaction(txn)
+        if result.get("succeeded") is not True:
+            raise RuntimeError("etcd no longer contains the lock owner UUID")
+
+        responses = result.get("responses")
+        if not isinstance(responses, list) or len(responses) != 1:
+            raise RuntimeError("etcd lock ownership read is incomplete")
+        response_range = responses[0].get("response_range", {})
+        values = response_range.get("kvs")
+        if not isinstance(values, list) or len(values) != 1:
+            raise RuntimeError("etcd lock ownership read is empty")
+        value = values[0]
+        if (value.get("key") != self.lock._key_b64 or
+                value.get("value") != self.lock._uuid):
+            raise RuntimeError("etcd lock ownership read does not match")
+
+
