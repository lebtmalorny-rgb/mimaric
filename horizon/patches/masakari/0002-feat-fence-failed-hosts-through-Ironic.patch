+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""Fail-closed host fencing through Ironic."""
+
+import time
+
+import eventlet
+from keystoneauth1 import loading
+from openstack import connection as openstack_connection
+
+from masakari import conf
+
+
+CONF = conf.CONF
+CONF.import_group("keystone_authtoken", "keystonemiddleware.auth_token")
+
+
+class FencingError(RuntimeError):
+    """Raised when Ironic cannot prove that a host is safely fenced."""
+
+
+def connection_from_conf():
+    auth = loading.load_auth_from_conf_options(
+        CONF, "keystone_authtoken"
+    )
+    session = loading.load_session_from_conf_options(
+        CONF, "keystone_authtoken", auth=auth
+    )
+    return openstack_connection.Connection(
+        session=session,
+        region_name=CONF.powerops.region_name,
+        interface=CONF.powerops.interface,
+    )
+
+
+def _is_compatible_off(node):
+    return (
+        node.power_state == "power off" and
+        node.target_power_state in (None, "power off") and
+        not node.last_error
+    )
+
+
+def _validate_node(node):
+    if node.provision_state != "manageable":
+        raise FencingError("Ironic node must remain manageable")
+    if node.network_interface != "noop":
+        raise FencingError("Ironic node must use the noop network interface")
+    if node.last_error:
+        raise FencingError("Ironic node reports a power operation error")
+    if node.target_power_state not in (None, "power off"):
+        raise FencingError("Ironic node has a conflicting power target")
+
+
+def _result(node):
+    return {
+        "id": node.id,
+        "name": node.name,
+        "power_state": node.power_state,
+        "target_power_state": node.target_power_state,
+        "provision_state": node.provision_state,
+        "network_interface": node.network_interface,
+        "last_error": node.last_error,
+    }
+
+
+class IronicPowerClient(object):
+    """Fence exact-name, pre-enrolled Ironic nodes."""
+
+    def __init__(self, connection, sleep=eventlet.sleep,
+                 monotonic=time.monotonic):
+        self.connection = connection
+        self.sleep = sleep
+        self.monotonic = monotonic
+
+    def fence(self, host, timeout, interval, stable_observations):
+        matches = [
+            node for node in self.connection.baremetal.nodes(details=True)
+            if node.name == host
+        ]
+        if len(matches) != 1:
+            raise FencingError(
+                "Expected exactly one Ironic node named {!r}".format(host)
+            )
+
+        node = matches[0]
+        _validate_node(node)
+        if not _is_compatible_off(node):
+            self.connection.baremetal.set_node_power_state(
+                node, "power off", wait=False
+            )
+
+        deadline = self.monotonic() + timeout
+        stable = 0
+        while True:
+            _validate_node(node)
+            if _is_compatible_off(node):
+                stable += 1
+                if stable >= stable_observations:
+                    return _result(node)
+            else:
+                stable = 0
+
+            if self.monotonic() >= deadline:
+                raise FencingError(
+                    "Timed out waiting for stable power off on {!r}".format(
+                        host
+                    )
+                )
+            self.sleep(interval)
+            node = self.connection.baremetal.get_node(node.id)
