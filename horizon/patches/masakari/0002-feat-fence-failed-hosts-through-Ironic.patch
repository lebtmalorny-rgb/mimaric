+from unittest import mock
+
+from masakari.engine.drivers.taskflow import powerops
+from masakari import exception
+from masakari import test
+from masakari.tests.unit.powerops import fakes
+
+
+class IronicFenceTaskTest(test.TestCase):
+
+    def setUp(self):
+        super(IronicFenceTaskTest, self).setUp()
+        self.override_config("enabled", True, "powerops")
+        self.override_config("power_timeout", 31, "powerops")
+        self.override_config("poll_interval", 2, "powerops")
+        self.override_config("stable_off_observations", 4, "powerops")
+        self.context = mock.sentinel.context
+        self.novaclient = mock.sentinel.novaclient
+        self.events = []
+        self.coordinator = fakes.recording_coordinator(self.events)
+
+    @mock.patch.object(powerops.ironic, "IronicPowerClient")
+    @mock.patch.object(powerops.ironic, "connection_from_conf")
+    def test_execute_fences_without_managing_host_lock(
+        self, connection_from_conf, power_client
+    ):
+        connection_from_conf.return_value = mock.sentinel.connection
+        power_client.return_value.fence.return_value = {
+            "power_state": "power off"
+        }
+        task = powerops.IronicFenceTask(
+            self.context,
+            self.novaclient,
+            powerops_coordinator=self.coordinator,
+        )
+
+        result = task.execute("compute-01")
+
+        self.assertEqual({"power_state": "power off"}, result)
+        power_client.assert_called_once_with(mock.sentinel.connection)
+        power_client.return_value.fence.assert_called_once_with(
+            "compute-01", 31, 2, 4
+        )
+        self.assertEqual([], self.events)
+
+    @mock.patch.object(powerops.ironic, "connection_from_conf")
+    def test_execute_requires_coordinator(self, connection_from_conf):
+        task = powerops.IronicFenceTask(self.context, self.novaclient)
+
+        error = self.assertRaises(
+            exception.HostRecoveryFailureException,
+            task.execute,
+            "compute-01",
+        )
+
+        self.assertEqual(
+            "PowerOps coordinator is required for fencing", str(error)
+        )
+        connection_from_conf.assert_not_called()
+
+    @mock.patch.object(powerops.ironic, "connection_from_conf")
+    def test_execute_rejects_disabled_powerops(self, connection_from_conf):
+        self.override_config("enabled", False, "powerops")
+        task = powerops.IronicFenceTask(
+            self.context,
+            self.novaclient,
+            powerops_coordinator=self.coordinator,
+        )
+
+        self.assertRaises(
+            exception.HostRecoveryFailureException,
+            task.execute,
+            "compute-01",
+        )
+        connection_from_conf.assert_not_called()
+        self.assertEqual([], self.events)
+
+    @mock.patch.object(powerops.ironic, "connection_from_conf")
+    @mock.patch.object(powerops, "LOG")
+    def test_revert_leaves_host_powered_off(self, log, connection_from_conf):
+        task = powerops.IronicFenceTask(
+            self.context,
+            self.novaclient,
+            powerops_coordinator=self.coordinator,
+        )
+
+        task.revert(
+            "compute-01", {"power_state": "power off"}, flow_failures={}
+        )
+
+        log.critical.assert_called_once_with(
+            "Fenced host %s remains powered off after flow failure",
+            "compute-01",
+        )
+        connection_from_conf.assert_not_called()
+        self.assertEqual([], self.events)
