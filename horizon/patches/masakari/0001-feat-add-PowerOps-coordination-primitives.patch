+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""PowerOps distributed coordination primitives."""
+
+import contextlib
+import re
+
+from oslo_config import cfg
+from tooz import coordination as tooz_coordination
+
+
+HOST_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
+GLOBAL_EVACUATION_LOCK = "powerops/evacuation/global"
+
+
+def host_lock_name(host):
+    if not isinstance(host, str) or not HOST_RE.fullmatch(host):
+        raise ValueError("host must be a canonical Nova hostname")
+    return "powerops/host/{}".format(host)
+
+
+class PowerOpsCoordinator(object):
+    """Manage PowerOps locks using the configured tooz backend."""
+
+    def __init__(self, member_id, backend_url=None):
+        self.member_id = member_id
+        self.backend_url = backend_url
+        self.coordinator = None
+        self.started = False
+
+    def start(self):
+        if self.started:
+            return
+
+        backend_url = self.backend_url or cfg.CONF.coordination.backend_url
+        if cfg.CONF.powerops.enabled and not backend_url:
+            raise RuntimeError("PowerOps requires coordination backend_url")
+
+        self.coordinator = tooz_coordination.get_coordinator(
+            backend_url, self.member_id.encode("utf-8"))
+        self.coordinator.start(start_heart=True)
+        self.started = True
+
+    def stop(self):
+        if self.started:
+            self.coordinator.stop()
+            self.coordinator = None
+            self.started = False
+
+    def __enter__(self):
+        self.start()
+        return self
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        self.stop()
+
+    @contextlib.contextmanager
+    def lock(self, name, timeout):
+        if not self.started:
+            raise RuntimeError("PowerOps coordinator is not started")
+        backend_lock = self.coordinator.get_lock(name.encode("utf-8"))
+        acquired = backend_lock.acquire(blocking=timeout)
+        if not acquired:
+            raise RuntimeError("timed out acquiring lock {}".format(name))
+        try:
+            yield
+        finally:
+            backend_lock.release()
