+class EvacuateInstancesPowerOpsTestCase(test.TestCase):
+
+    def setUp(self):
+        super(EvacuateInstancesPowerOpsTestCase, self).setUp()
+        self.ctxt = context.get_admin_context()
+        self.novaclient = nova.API()
+        self.notification_uuid = uuids.notification
+
+    @staticmethod
+    def _pending_vmove(instance_uuid):
+        return mock.Mock(
+            instance_uuid=instance_uuid,
+            status=fields.VMoveStatus.PENDING,
+        )
+
+    def test_powerops_evacuation_is_sorted_and_globally_serial(self):
+        events = []
+        coordinator = powerops_fakes.recording_coordinator(events)
+        task = host_failure.EvacuateInstancesTask(
+            self.ctxt,
+            self.novaclient,
+            update_host_method=manager.update_host_method,
+            powerops_coordinator=coordinator,
+        )
+        self.override_config('enabled', True, 'powerops')
+        self.override_config('evacuation_lock_timeout', 17.0, 'powerops')
+        self.override_config('evacuation_interval', 7, 'powerops')
+        vmoves = [self._pending_vmove('vm-b'),
+                  self._pending_vmove('vm-a')]
+
+        def mark_succeeded(_context, vmove, _reserved_host=None):
+            events.append('evacuate-{}'.format(vmove.instance_uuid))
+            vmove.status = fields.VMoveStatus.SUCCEEDED
+
+        def record_sleep(interval):
+            events.append('sleep-{}'.format(interval))
+
+        with mock.patch.object(
+                objects.VMoveList, 'get_all_vmoves', return_value=vmoves), \
+                mock.patch.object(
+                    task, '_evacuate_and_confirm',
+                    side_effect=mark_succeeded) as evacuate, \
+                mock.patch.object(
+                    coordinator, 'lock', wraps=coordinator.lock) as lock, \
+                mock.patch.object(
+                    eventlet, 'sleep', side_effect=record_sleep) as sleep, \
+                mock.patch.object(task, 'update_details') as update_details:
+            task.execute('compute-01', self.notification_uuid)
+
+        self.assertEqual(
+            ['vm-a', 'vm-b'],
+            [call.args[1].instance_uuid
+             for call in evacuate.call_args_list],
+        )
+        self.assertEqual([
+            'evacuation-lock-enter', 'evacuate-vm-a', 'sleep-7',
+            'evacuation-lock-exit', 'evacuation-lock-enter',
+            'evacuate-vm-b', 'sleep-7', 'evacuation-lock-exit',
+        ], events)
+        self.assertEqual([
+            mock.call('powerops/evacuation/global', 17.0),
+            mock.call('powerops/evacuation/global', 17.0),
+        ], lock.call_args_list)
+        self.assertEqual([mock.call(7), mock.call(7)],
+                         sleep.call_args_list)
+        update_details.assert_any_call(
+            "Start evacuation of instances from failed host 'compute-01', "
+            "instance uuids are: 'vm-a,vm-b'")
+
+    def test_powerops_stops_after_first_failed_vmove(self):
+        coordinator = powerops_fakes.recording_coordinator([])
+        task = host_failure.EvacuateInstancesTask(
+            self.ctxt,
+            self.novaclient,
+            update_host_method=manager.update_host_method,
+            powerops_coordinator=coordinator,
+        )
+        self.override_config('enabled', True, 'powerops')
+        vm_a = self._pending_vmove('vm-a')
+        vm_b = self._pending_vmove('vm-b')
+
+        def mark_failed(_context, vmove, _reserved_host=None):
+            vmove.status = fields.VMoveStatus.FAILED
+
+        with mock.patch.object(
+                objects.VMoveList, 'get_all_vmoves',
+                return_value=[vm_b, vm_a]), \
+                mock.patch.object(
+                    task, '_evacuate_and_confirm',
+                    side_effect=mark_failed) as evacuate, \
+                mock.patch.object(eventlet, 'sleep') as sleep:
+            self.assertRaises(
+                exception.HostRecoveryFailureException,
+                task.execute,
+                'compute-01',
+                self.notification_uuid,
+            )
+
+        self.assertEqual('vm-a', evacuate.call_args.args[1].instance_uuid)
+        self.assertEqual(1, evacuate.call_count)
+        sleep.assert_not_called()
+
+    @mock.patch.object(greenpool, 'GreenPool')
+    @mock.patch.object(objects.VMoveList, 'get_all_vmoves', return_value=[])
+    def test_legacy_evacuation_uses_configured_greenpool(
+            self, get_vmoves, greenpool_cls):
+        self.override_config('enabled', False, 'powerops')
+        task = host_failure.EvacuateInstancesTask(
+            self.ctxt,
+            self.novaclient,
+            update_host_method=manager.update_host_method,
+        )
+
+        task.execute('compute-01', self.notification_uuid)
+
+        greenpool_cls.assert_called_once_with(
+            CONF.host_failure_recovery_threads)
+
+
 class HostFailureFlowCoordinatorTestCase(test.TestCase):
 
     def setUp(self):
