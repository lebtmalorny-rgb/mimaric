         self.taskflow_driver = driver.TaskFlowDriver()
         self.ctxt = context.get_admin_context()
 
+    def _patch_auto_flow(self, events):
+        class RecordingFlow(object):
+            def run(self):
+                events.append('flow-run')
+
+        def get_auto_flow(*args, **kwargs):
+            self.assertIsNotNone(kwargs.get('powerops_coordinator'))
+            return RecordingFlow()
+
+        flow_patcher = mock.patch.object(
+            host_failure, 'get_auto_flow', side_effect=get_auto_flow)
+        listener_patcher = mock.patch.object(base, 'DynamicLogListener')
+        flow_patcher.start()
+        listener_patcher.start()
+        self.addCleanup(flow_patcher.stop)
+        self.addCleanup(listener_patcher.stop)
+
+    @mock.patch.object(powerops_coordination, 'PowerOpsCoordinator')
+    def test_powerops_host_lock_wraps_complete_auto_flow(
+            self, coordinator_cls):
+        events = []
+        coordinator = powerops_fakes.recording_coordinator(events)
+        coordinator_cls.return_value = coordinator
+        self.override_config('enabled', True, 'powerops')
+        self._patch_auto_flow(events)
+
+        self.taskflow_driver.execute_host_failure(
+            self.ctxt,
+            'compute-01',
+            fields.FailoverSegmentRecoveryMethod.AUTO,
+            uuidsentinel.fake_notification,
+        )
+
+        self.assertEqual(
+            ['coordinator-start', 'host-lock-enter', 'flow-run',
+             'host-lock-exit', 'coordinator-stop'],
+            events,
+        )
+
+    @mock.patch.object(powerops_coordination, 'PowerOpsCoordinator')
+    def test_auto_priority_fallback_keeps_same_host_lock(
+            self, coordinator_cls):
+        events = []
+        coordinator = powerops_fakes.recording_coordinator(events)
+        coordinator_cls.return_value = coordinator
+        self.override_config('enabled', True, 'powerops')
+
+        def execute_auto_workflow(*args, **kwargs):
+            self.assertIs(
+                coordinator, kwargs.get('powerops_coordinator'))
+            events.append('auto-flow')
+            raise RuntimeError('auto failed')
+
+        def execute_rh_workflow(*args, **kwargs):
+            self.assertIs(
+                coordinator, kwargs.get('powerops_coordinator'))
+            events.append('rh-flow')
+
+        with mock.patch.object(
+                self.taskflow_driver, '_execute_auto_workflow',
+                side_effect=execute_auto_workflow), \
+                mock.patch.object(
+                    self.taskflow_driver, '_execute_rh_workflow',
+                    side_effect=execute_rh_workflow):
+            self.taskflow_driver.execute_host_failure(
+                self.ctxt,
+                'compute-01',
+                fields.FailoverSegmentRecoveryMethod.AUTO_PRIORITY,
+                uuidsentinel.fake_notification,
+                reserved_host_list=['compute-02'],
+            )
+
+        self.assertEqual(
+            ['coordinator-start', 'host-lock-enter', 'auto-flow', 'rh-flow',
+             'host-lock-exit', 'coordinator-stop'],
+            events,
+        )
+
+    @mock.patch.object(powerops_coordination, 'PowerOpsCoordinator')
+    def test_powerops_coordination_failure_prevents_flow(
+            self, coordinator_cls):
+        coordinator_cls.return_value.__enter__.side_effect = RuntimeError(
+            'coordination unavailable')
+        self.override_config('enabled', True, 'powerops')
+
+        with mock.patch.object(
+                self.taskflow_driver, '_dispatch_host_failure') as dispatch:
+            self.assertRaises(
+                exception.HostRecoveryFailureException,
+                self.taskflow_driver.execute_host_failure,
+                self.ctxt,
+                'compute-01',
+                fields.FailoverSegmentRecoveryMethod.AUTO,
+                uuidsentinel.fake_notification,
+            )
+
+        dispatch.assert_not_called()
+
     @mock.patch.object(base, 'DynamicLogListener')
